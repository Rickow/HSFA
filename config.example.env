# Configuration locale de HSFA : copier en config.env (non suivi par git), adapter, puis `source config.env`.
# Le depot ne contient aucune donnee de jeu : tout est lu dans VOTRE espace de travail.
# Detail des variables : src/hsfa/hsfa_config.py et docs/guide/construction-iso.md.

# --- Emplacements (lus par src/hsfa/hsfa_config.py, scripts/localiser.py et scripts/validation/*.sh) ---
export HSFA_WORKSPACE="$HOME/hsfa"                      # racine : work/, mame-fork/, venv/, iso/...
export HSFA_EXTRACT="$HSFA_WORKSPACE/anthology_extract"  # manifest.csv + decompressed/roN_usa_prog68k.bin
export HSFA_WORK="$HSFA_WORKSPACE/work"                  # bancs MAME (work/mame, work/mame_ro5, work/mame_ro9...)
export HSFA_XDATA="$HSFA_WORK/xdata/X_DATA.BIN"          # extrait de l'ISO (lecture seule)
export HSFA_YDATA="$HSFA_WORK/xdata/Y_DATA.BIN"          # flux musique ADX (ou l'ISO entiere)
export HSFA_CPS2F="$HSFA_WORKSPACE/mame-fork/mame/cps2f" # fork MAME (patches/mame-fork)
# export HSFA_SRC="/chemin/du/depot/src/hsfa"           # facultatif : outils a utiliser par scripts/validation

# --- Variables deja lues par les scripts existants ---
export XDATA="$HSFA_XDATA"                               # mame_test.py, banques.py, gen_son.py
# export MODULE=ro3                                      # ro3 = SFA3, ro5 = Upper, ro9 = Hyper (profils.py)
# export EXTRACT_MODULES="$HSFA_EXTRACT/decompressed"    # profils.py : modules MIPS (ou modules corriges, Hyper)

# --- Construction depuis l'ISO (scripts/construction/hsfa_build.py) : outils pris dans ce depot ---
DEPOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
export HSFA_OUTILS_UNTRANSPILE="$DEPOT/src/hsfa"        # traducteur et scripts graphiques
export HSFA_OUTILS_EXTRACTION="$DEPOT/src/hsfa"         # extract_anthology.py
export HSFA_OUTILS_MWO3="$DEPOT/src/hsfa"               # mwo3_codec.py
export HSFA_OUTILS_SON="$DEPOT/src/hsfa"                # gen_hybride.py + z80son.py
export HSFA_OUTILS_SON_TABLE="$DEPOT/src/hsfa"          # table_son.py
export HSFA_OUTILS_PAQUET="$DEPOT/tools/fbneo-hsfa"     # paquet_fbneo.py
export HSFA_OUTILS_FLUX="$DEPOT/tools/flux"             # gen_table_flux.py
export HSFA_PYTHON_NUMPY="$(command -v python3)"         # interpreteur avec numpy (ou celui d'un venv)
