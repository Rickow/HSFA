diff --git a/src/intf/video/vid_interface.cpp b/src/intf/video/vid_interface.cpp
index 225329c06..373ae0a5c 100644
--- a/src/intf/video/vid_interface.cpp
+++ b/src/intf/video/vid_interface.cpp
@@ -411,8 +411,49 @@ static INT32 VidDoFrame(bool bRedraw)
 	return nRet;
 }
 
+#if defined (BUILD_WIN32) && defined (HSFA_WS)
+// HSFA mod, 16:9 build (hsfa_win32.cpp): "Screen format (fill height)". The driver keeps drawing its full width into
+// this buffer; the centred part (nHsfaWsCropW pixels) is copied into the blitter's image, which has that width.
+extern INT32 nHsfaWsCropW;
+static UINT8* pHsfaWsImage = NULL;
+static INT32 nHsfaWsImageSize = 0;
+
+static UINT8* HsfaWsCropBegin(INT32* pnFullW, INT32* pnH)
+{
+	if (nHsfaWsCropW <= 0 || pBurnDraw == NULL || (BurnDrvGetFlags() & BDF_16BIT_ONLY)) return NULL;
+	BurnDrvGetOriginalVisibleSize(pnFullW, pnH);
+	if (*pnFullW <= nHsfaWsCropW || *pnH <= 0) return NULL;
+	INT32 nSize = *pnFullW * *pnH * nBurnBpp;
+	if (nSize > nHsfaWsImageSize) {
+		free(pHsfaWsImage);
+		pHsfaWsImage = (UINT8*)malloc(nSize);
+		nHsfaWsImageSize = pHsfaWsImage ? nSize : 0;
+		if (pHsfaWsImage == NULL) return NULL;
+		memset(pHsfaWsImage, 0, nSize);
+	}
+	UINT8* pDest = pBurnDraw;
+	pBurnDraw = pHsfaWsImage;
+	nBurnPitch = *pnFullW * nBurnBpp;
+	return pDest;
+}
+
+static void HsfaWsCropEnd(UINT8* pDest, INT32 nDestPitch, INT32 nFullW, INT32 nH)
+{
+	const INT32 nLeft = ((nFullW - nHsfaWsCropW) / 2) * nBurnBpp;
+	for (INT32 y = 0; y < nH; y++) {
+		memcpy(pDest + y * nDestPitch, pHsfaWsImage + y * nFullW * nBurnBpp + nLeft, nHsfaWsCropW * nBurnBpp);
+	}
+	pBurnDraw = pDest;
+	nBurnPitch = nDestPitch;
+}
+#endif
+
 INT32 VidFrameCallback(bool bRedraw)        // Called from blitter  (VidFrame() -> VidDoFrame() -> Blitter -> this.)
 {
+#if defined (BUILD_WIN32) && defined (HSFA_WS)
+	INT32 nHsfaFullW = 0, nHsfaH = 0, nHsfaPitch = nBurnPitch;
+	UINT8* pHsfaDest = bDrvOkay ? HsfaWsCropBegin(&nHsfaFullW, &nHsfaH) : NULL;
+#endif
 	if (bDrvOkay) {
 		if (bRedraw) {						// Redraw current frame
 			if (BurnDrvRedraw()) {
@@ -422,6 +463,10 @@ INT32 VidFrameCallback(bool bRedraw)        // Called from blitter  (VidFrame()
 			BurnDrvFrame();					// Run one frame and draw the screen
 		}
 
+#if defined (BUILD_WIN32) && defined (HSFA_WS)
+		if (pHsfaDest) HsfaWsCropEnd(pHsfaDest, nHsfaPitch, nHsfaFullW, nHsfaH);
+#endif
+
 		if (BurnDrvGetFlags() & BDF_16BIT_ONLY) {
 			VidDoTransTopVidImage();
 		}
