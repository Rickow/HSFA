diff --git a/src/burner/win32/hsfa_win32.cpp b/src/burner/win32/hsfa_win32.cpp
new file mode 100644
index 000000000..26425ccbf
--- /dev/null
+++ b/src/burner/win32/hsfa_win32.cpp
@@ -0,0 +1,78 @@
+// HSFA (Hyper Street Fighter Alpha mod), Windows front-end glue.
+// The libretro HSFA cores expose a few settings as core options (src/burner/libretro, HSFA patches 0012, 0022, 0023).
+// This file carries them over to the standalone Windows front-end: values are kept in config/<exe>.ini, set from the
+// Video > HSFA widescreen menu, and applied here. Defaults are the libretro defaults.
+// Everything below only exists in the 16:9 build (-DHSFA_WS, makefile.mingw HSFA_WS=1); the 4:3 build has none of it.
+
+#include "burner.h"
+
+#ifdef HSFA_WS
+
+extern INT32 nHsfaWsBords, nHsfaWsCale, nHsfaWsVisible;	// cps_hsfa.cpp (patches 0022, 0023)
+
+INT32 nHsfaWsEdges = 0;		// "Widescreen edges" : 0 Stage-locked view (default), 1 Mirror, 2 Repeat, 3 Black, 4 Raw
+INT32 nHsfaFormat = 0;		// "Screen format (fill height)" : 0 Off (default), 1..6 = 4:3, 3:2, 14:9, 16:10, 5:3, 16:9
+INT32 nHsfaWsCropW = 0;		// width shown when the format crops the 16:9 picture (0 = no crop) ; read by vid_interface.cpp
+
+static const INT32 HsfaFormats[7][2] = { { 0, 0 }, { 4, 3 }, { 3, 2 }, { 14, 9 }, { 16, 10 }, { 5, 3 }, { 16, 9 } };
+
+static bool HsfaDriverActive()
+{
+	if (!bDrvOkay || nBurnDrvActive >= nBurnDrvCount) return false;
+	const char* pszName = BurnDrvGetTextA(DRV_NAME);
+	return pszName && strstr(pszName, "hsfa") != NULL;
+}
+
+// same mapping as the libretro option fbneo-hsfa-ws-edges (retro_common.cpp, patches 0022 / 0023)
+void HsfaWsApplyEdges()
+{
+	if (nHsfaWsEdges < 0 || nHsfaWsEdges > 4) nHsfaWsEdges = 0;
+	nHsfaWsCale  = (nHsfaWsEdges == 0);					// stage-locked view (what is still missing: mirror)
+	nHsfaWsBords = (nHsfaWsEdges == 0) ? 0 : nHsfaWsEdges - 1;
+}
+
+// same rule as HsfaFormat() of the libretro core (libretro.cpp, patch 0012): shown width = format x 288 (arcade pixel
+// shape, 384 px <-> 4:3), even, capped to the game width; centred crop. Here the driver keeps drawing its full 512 px
+// (nCpsScreenWidth is read once at init) into a private buffer, vid_interface.cpp copies the centre, and the blitters
+// see a game of the cropped width and of the chosen aspect ratio.
+void HsfaWsApplyFormat()
+{
+	HsfaWsApplyEdges();
+
+	nHsfaWsVisible = 0;
+	nHsfaWsCropW = 0;
+	if (!HsfaDriverActive()) return;
+
+	INT32 nW = 0, nH = 0;
+	BurnDrvGetOriginalVisibleSize(&nW, &nH);			// size of the driver, cached by BurnDrvInit()
+	if (nW <= 0 || nH <= 0) return;
+
+	if (nHsfaFormat < 1 || nHsfaFormat > 6) {
+		nHsfaFormat = 0;
+		BurnDrvSetVisibleSize(nW, nH);
+		BurnDrvSetAspect(nW, 288);						// as the driver: HSFA_ASPX = width, HSFA_ASPY = 288
+		return;
+	}
+
+	INT32 w = (HsfaFormats[nHsfaFormat][0] * 288 / HsfaFormats[nHsfaFormat][1]) & ~1;
+	if (w < nW) {
+		nHsfaWsVisible = nHsfaWsCropW = w;
+		BurnDrvSetVisibleSize(w, nH);
+	} else {
+		BurnDrvSetVisibleSize(nW, nH);
+	}
+	BurnDrvSetAspect(HsfaFormats[nHsfaFormat][0], HsfaFormats[nHsfaFormat][1]);
+}
+
+void HsfaWsExit()
+{
+	nHsfaWsVisible = 0;
+	nHsfaWsCropW = 0;
+}
+
+#else
+
+void HsfaWsApplyFormat() { }
+void HsfaWsExit() { }
+
+#endif
