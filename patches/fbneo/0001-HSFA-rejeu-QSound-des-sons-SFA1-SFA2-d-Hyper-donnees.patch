+		for (int i = 0; i < 33; i++) {
+			pan[0][0][i] = dry_mix[i]; pan[1][0][i] = dry_mix[32 - i];
+			pan[0][1][i] = wet_mix[i]; pan[1][1][i] = wet_mix[32 - i];
+			pan[0][0][i + 0x30] = linear_mix[i]; pan[1][0][i + 0x30] = linear_mix[32 - i];
+		}
+		carte();
+	}
+	void fixe_rom(const uint8_t *r, uint32_t taille) { rom = r; masque = taille ? taille - 1 : 0; }
+	void reset() { c.ready_flag = 0; c.out[0] = c.out[1] = 0; c.state = 0; c.state_counter = 0; }
+	void ecrit(uint8_t reg, uint16_t val)
+	{
+		uint16_t *d = reg_map[reg];
+		if (d) *d = val;
+		c.ready_flag = 0;
+	}
+	void echantillon()
+	{
+		switch (c.state) {
+		default: case ST_INIT1: case ST_INIT2: etat_init(); return;
+		case ST_REFRESH1: refresh1(); return;
+		case ST_REFRESH2: refresh2(); return;
+		case ST_NORMAL1: case ST_NORMAL2: normal(); return;
+		}
+	}
+
+private:
+	int16_t pan[2][2][98];
+	uint16_t *reg_map[256];
+
+	void carte()
+	{
+		for (int i = 0; i < 256; i++) reg_map[i] = NULL;
+		for (int i = 0; i < 16; i++) {
+			reg_map[(i << 3) + 0] = &c.voice[(i + 1) % 16].bank;
+			reg_map[(i << 3) + 1] = (uint16_t*)&c.voice[i].addr;
+			reg_map[(i << 3) + 2] = &c.voice[i].rate;
+			reg_map[(i << 3) + 3] = &c.voice[i].phase;
+			reg_map[(i << 3) + 4] = (uint16_t*)&c.voice[i].loop_len;
+			reg_map[(i << 3) + 5] = (uint16_t*)&c.voice[i].end_addr;
+			reg_map[(i << 3) + 6] = (uint16_t*)&c.voice[i].volume;
+			reg_map[i + 0x80] = &c.voice_pan[i];
+			reg_map[i + 0xba] = (uint16_t*)&c.voice[i].echo;
+		}
+		for (int i = 0; i < 3; i++) {
+			reg_map[(i << 2) + 0xca] = &c.adp[i].start_addr;
+			reg_map[(i << 2) + 0xcb] = &c.adp[i].end_addr;
+			reg_map[(i << 2) + 0xcc] = &c.adp[i].bank;
+			reg_map[(i << 2) + 0xcd] = (uint16_t*)&c.adp[i].volume;
+			reg_map[i + 0xd6] = &c.adp[i].flag;
+			reg_map[i + 0x90] = &c.voice_pan[16 + i];
+		}
+		reg_map[0x93] = (uint16_t*)&c.echo.feedback;
+		reg_map[0xd9] = &c.echo.end_pos;
+		reg_map[0xe2] = &c.delay_update;
+		reg_map[0xe3] = &c.next_state;
+		for (int i = 0; i < 2; i++) {
+			reg_map[(i << 1) + 0xda] = (uint16_t*)&c.filter[i].table_pos;
+			reg_map[(i << 1) + 0xde] = (uint16_t*)&c.wet[i].delay;
+			reg_map[(i << 1) + 0xe4] = (uint16_t*)&c.wet[i].volume;
+			reg_map[(i << 1) + 0xdb] = (uint16_t*)&c.alt_filter[i].table_pos;
+			reg_map[(i << 1) + 0xdf] = (uint16_t*)&c.dry[i].delay;
+			reg_map[(i << 1) + 0xe5] = (uint16_t*)&c.dry[i].volume;
+		}
+	}
+	// qsoundhle.cpp : bank &= 0x7fff ; read_byte((bank << 16) | address) (ROM en miroir)
+	int16_t lit(uint16_t bank, uint16_t addr) const
+	{
+		if (!rom) return 0;
+		uint32_t a = ((uint32_t(bank) & 0x7FFF) << 16) | addr;
+		return int16_t(uint16_t(rom[a & masque]) << 8);
+	}
+	static const int16_t *table_filtre(uint16_t off)
+	{
+		if (off >= 0xf2e && off < 0xfff) return &filter_data2[off - 0xf2e];
+		int i = (int(off) - 0xd53) / 95;
+		if (i >= 0 && i < 5) return filter_data[i];
+		return NULL;
+	}
+	void etat_init()
+	{
+		int mode = (c.state == ST_INIT2) ? 1 : 0;
+		if (c.state_counter >= 2) { c.state_counter = 0; c.state = c.next_state; return; }
+		else if (c.state_counter == 1) { c.state_counter++; return; }
+		memset(c.voice, 0, sizeof(c.voice)); memset(c.adp, 0, sizeof(c.adp));
+		memset(c.filter, 0, sizeof(c.filter)); memset(c.alt_filter, 0, sizeof(c.alt_filter));
+		memset(c.wet, 0, sizeof(c.wet)); memset(c.dry, 0, sizeof(c.dry)); memset(&c.echo, 0, sizeof(c.echo));
+		for (int i = 0; i < 19; i++) { c.voice_pan[i] = 0x120; c.voice_output[i] = 0; }
+		for (int i = 0; i < 16; i++) c.voice[i].bank = 0x8000;
+		for (int i = 0; i < 3; i++) c.adp[i].bank = 0x8000;
+		if (mode == 0) {
+			c.wet[0].delay = 0; c.dry[0].delay = 46; c.wet[1].delay = 0; c.dry[1].delay = 48;
+			c.filter[0].table_pos = 0xdb2; c.filter[1].table_pos = 0xe11;
+			c.echo.end_pos = 0x554 + 6; c.next_state = ST_REFRESH1;
+		} else {
+			c.wet[0].delay = 1; c.dry[0].delay = 0; c.wet[1].delay = 0; c.dry[1].delay = 0;
+			c.filter[0].table_pos = 0xf73; c.filter[1].table_pos = 0xfa4;
+			c.alt_filter[0].table_pos = 0xf73; c.alt_filter[1].table_pos = 0xfa4;
+			c.echo.end_pos = 0x53c + 6; c.next_state = ST_REFRESH2;
+		}
+		c.wet[0].volume = 0x3fff; c.dry[0].volume = 0x3fff; c.wet[1].volume = 0x3fff; c.dry[1].volume = 0x3fff;
+		c.delay_update = 1; c.ready_flag = 0; c.state_counter = 1;
+	}
+	void refresh1()
+	{
+		for (int ch = 0; ch < 2; ch++) {
+			c.filter[ch].delay_pos = 0; c.filter[ch].tap_count = 95;
+			const int16_t *t = table_filtre(c.filter[ch].table_pos);
+			if (t) memcpy(c.filter[ch].taps, t, 95 * sizeof(int16_t));
+		}
+		c.state = c.next_state = ST_NORMAL1;
+	}
+	void refresh2()
+	{
+		for (int ch = 0; ch < 2; ch++) {
+			c.filter[ch].delay_pos = 0; c.filter[ch].tap_count = 45;
+			const int16_t *t = table_filtre(c.filter[ch].table_pos);
+			if (t) memcpy(c.filter[ch].taps, t, 45 * sizeof(int16_t));
+			c.alt_filter[ch].delay_pos = 0; c.alt_filter[ch].tap_count = 44;
+			t = table_filtre(c.alt_filter[ch].table_pos);
+			if (t) memcpy(c.alt_filter[ch].taps, t, 44 * sizeof(int16_t));
+		}
+		c.state = c.next_state = ST_NORMAL2;
+	}
+	int16_t pcm(int n, int32_t *echo_out)
+	{
+		voix *v = &c.voice[n];
+		int16_t output = int16_t((v->volume * lit(v->bank, uint16_t(v->addr))) >> 14);
+		*echo_out += (output * v->echo) << 2;
+		int32_t np = v->rate + ((v->addr << 12) | (v->phase >> 4));
+		if ((np >> 12) >= v->end_addr) np -= (v->loop_len << 12);
+		np = HSFA_QS_CLAMP(np, -0x8000000, 0x7FFFFFF);
+		v->addr = int16_t(np >> 12);
+		v->phase = uint16_t((np << 4) & 0xffff);
+		return output;
+	}
+	void adpcm_maj(int n, int nibble)
+	{
+		adpcm *v = &c.adp[n];
+		int8_t step;
+		if (!nibble) {
+			if (v->cur_addr == v->end_addr) v->cur_vol = 0;
+			if (v->flag) { c.voice_output[16 + n] = 0; v->flag = 0; v->step_size = 10; v->cur_vol = v->volume; v->cur_addr = v->start_addr; }
+			step = int8_t(lit(v->bank, v->cur_addr) >> 8);
+		} else step = int8_t(lit(v->bank, v->cur_addr++) >> 4);
+		step >>= 4;
+		int32_t delta = ((1 + abs(step << 1)) * v->step_size) >> 1;
+		if (step <= 0) delta = -delta;
+		delta += c.voice_output[16 + n];
+		delta = HSFA_QS_CLAMP(delta, -32768, 32767);
+		c.voice_output[16 + n] = int16_t((delta * v->cur_vol) >> 16);
+		v->step_size = int16_t((adpcm_step[8 + step] * v->step_size) >> 6);
+		v->step_size = HSFA_QS_CLAMP(v->step_size, 1, 2000);
+	}
+	static int16_t echo(echo_t *r, int32_t input)
+	{
+		int32_t old_sample = r->delay_line[r->delay_pos];
+		int32_t last_sample = r->last_sample;
+		r->last_sample = int16_t(old_sample);
+		old_sample = (old_sample + last_sample) >> 1;
+		int32_t ns = input + ((old_sample * r->feedback) << 2);
+		r->delay_line[r->delay_pos++] = int16_t(ns >> 16);
+		if (r->delay_pos >= r->length) r->delay_pos = 0;
+		return int16_t(old_sample);
+	}
+	static int32_t applique_fir(fir *f, int16_t input)
+	{
+		int32_t output = 0, tap = 0;
+		for (; tap < (f->tap_count - 1); tap++) {
+			output -= (f->taps[tap] * f->delay_line[f->delay_pos++]) << 2;
+			if (f->delay_pos >= f->tap_count - 1) f->delay_pos = 0;
+		}
+		output -= (f->taps[tap] * input) << 2;
+		f->delay_line[f->delay_pos++] = input;
+		if (f->delay_pos >= f->tap_count - 1) f->delay_pos = 0;
+		return output;
+	}
+	static int32_t applique_retard(retard *d, int32_t input)
+	{
+		d->delay_line[d->write_pos++] = int16_t(input >> 16);
+		if (d->write_pos >= 51) d->write_pos = 0;
+		int32_t output = d->delay_line[d->read_pos++] * d->volume;
+		if (d->read_pos >= 51) d->read_pos = 0;
+		return output;
+	}
+	static void maj_retard(retard *d)
+	{
+		int16_t nr = int16_t((d->write_pos - d->delay) % 51);
+		if (nr < 0) nr += 51;
+		d->read_pos = nr;
+	}
+	void normal()
+	{
+		int32_t echo_input = 0;
+		c.ready_flag = 0x80;
+		if (c.state == ST_NORMAL2) c.echo.length = int16_t(c.echo.end_pos - 0x53c);
+		else c.echo.length = int16_t(c.echo.end_pos - 0x554);
+		c.echo.length = HSFA_QS_CLAMP(c.echo.length, 0, 1024);
+		for (int v = 0; v < 16; v++) c.voice_output[v] = pcm(v, &echo_input);
+		adpcm_maj(c.state_counter % 3, c.state_counter / 3);
+		int16_t eo = echo(&c.echo, echo_input);
+		for (int ch = 0; ch < 2; ch++) {
+			int32_t wet = (ch == 1) ? eo << 14 : 0;
+			int32_t dry = (ch == 0) ? eo << 14 : 0;
+			for (int v = 0; v < 19; v++) {
+				uint16_t pi = uint16_t(c.voice_pan[v] - 0x110);
+				if (pi > 97) pi = 97;
+				dry -= (c.voice_output[v] * pan[ch][0][pi]);
+				wet -= (c.voice_output[v] * pan[ch][1][pi]);
+			}
+			dry = HSFA_QS_CLAMP(dry, -0x1fffffff, 0x1fffffff) << 2;
+			wet = HSFA_QS_CLAMP(wet, -0x1fffffff, 0x1fffffff) << 2;
+			wet = applique_fir(&c.filter[ch], int16_t(wet >> 16));
+			if (c.state == ST_NORMAL2) dry = applique_fir(&c.alt_filter[ch], int16_t(dry >> 16));
+			int32_t output = applique_retard(&c.wet[ch], wet) + applique_retard(&c.dry[ch], dry);
+			output = ((output + 0x2000) & ~0x3fff) >> 14;
+			c.out[ch] = int16_t(HSFA_QS_CLAMP(output, -0x7fff, 0x7fff));
+			if (c.delay_update) { maj_retard(&c.wet[ch]); maj_retard(&c.dry[ch]); }
+		}
+		c.delay_update = 0;
+		c.state_counter++;
+		if (c.state_counter > 5) { c.state_counter = 0; c.state = c.next_state; }
+	}
+};
+
+} // namespace hsfa_qs
diff --git a/src/burn/drv/capcom/hsfa_rejeu.h b/src/burn/drv/capcom/hsfa_rejeu.h
new file mode 100644
index 0000000..b5ed316
--- /dev/null
+++ b/src/burn/drv/capcom/hsfa_rejeu.h
@@ -0,0 +1,355 @@
+// HSFA : REJEU QSOUND des sons de SFA1 et SFA2 (voix, cris, K.O., annonceur, bruitages simples et en sequence) sur un
+// 2e QSound, pour les versions ZERO / ZERO 2 / ALPHA d'Hyper. En-tete seul, C++98 portable (MAME, FBNeo/libretro),
+// sans dependance. Aucune donnee de jeu dans le code : la ROM d'echantillons est lue dans le X_DATA.BIN de
+// l'utilisateur (ou l'ISO de l'Anthology), les sons sont decrits par une table texte separee (gen_rejeu.py) : pour chaque
+// code, les ecritures de registres QSound (temps, registre, valeur) que le pilote Z80 d'origine fait pour la commande.
+//
+// Principe : a chaque commande posee par le 68K dans la boite aux lettres ($61801F = 0), commande() decide :
+//   - code de la table (CODE ou REF) : le son est rejoue sur le 2e QSound ; la commande transmise au Z80 devient un code
+//     VIDE du Z80 (aucun effet) ; la priorite et la coupure de voie suivent la regle des pilotes Capcom (v1.05 $046E,
+//     v1.71 $05AF) : pour chaque voie du son, si la voie est occupee par un son de priorite plus haute, cette voie
+//     n'est pas prise ; sinon le son en cours sur la voie est coupe (ses ecritures suivantes sur la voie sont
+//     abandonnees). Une voie se libere a la derniere ecriture du son qui l'occupe ;
+//   - ALIAS : la commande transmise au Z80 est remplacee par le code Z80 donne (rien n'est rejoue) ;
+//   - FF00 : tout s'arrete (reponse du pilote d'origine a FF00), la commande passe aussi au Z80 ;
+//   - le reste passe au Z80 sans changement.
+// L'hote fournit le temps en microsecondes emulees, appelle avance() a l'instant prochain() et ecrit chaque registre
+// dans son 2e QSound (MAME : qsound_hle_device ; FBNeo : 2e instance du QSound).
+#pragma once
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <string>
+#include <vector>
+
+namespace hsfa_rejeu {
+
+#if defined(__LIBRETRO_SDK_FILE_STREAM_TRANSFORMS_H)
+static inline int fseek64r(FILE *f, uint64_t o) { return fseek(f, (int64_t)o, SEEK_SET) < 0 ? -1 : 0; }
+#elif defined(_WIN32)
+static inline int fseek64r(FILE *f, uint64_t o) { return _fseeki64(f, (long long)o, SEEK_SET); }
+#else
+static inline int fseek64r(FILE *f, uint64_t o) { return fseeko(f, (off_t)o, SEEK_SET); }
+#endif
+
+enum { NV = 19, NI = 32 };                     // voies (16 PCM + 3 ADPCM), sons simultanes
+enum { PASSE = 0, REMPLACE = 1 };
+enum { K_SON = 0, K_INIT = 1, K_STOP = 2 };
+
+struct ecriture { uint32_t t; uint16_t val; uint8_t reg; uint8_t voie; };   // voie 0xFF = registre global
+struct son { uint16_t code, src; uint8_t jeu, prio; uint32_t debut, n, voies; uint32_t fin[NV]; };
+struct source { std::string nom; uint64_t off; uint32_t taille, crc; uint8_t banque; };
+
+// etat sauvegardable (types simples, enregistres un par un par l'hote)
+struct instance { int32_t kind, ent; int64_t t0; uint32_t pos, voies; };
+struct etat_t {
+	instance ins[NI];
+	int32_t proprio[NV];                   // instance qui occupe la voie (-1 libre)
+	int32_t prio[NV];
+	int64_t fin[NV];                       // fin d'occupation (us)
+	etat_t() { raz(); }
+	void raz() { memset(this, 0, sizeof(*this)); for (int i = 0; i < NI; i++) ins[i].ent = -1; for (int v = 0; v < NV; v++) proprio[v] = -1; }
+};
+
+static inline int voie_de(int r)
+{
+	if (r < 0x80) return ((r & 7) == 0) ? (((r >> 3) + 1) & 15) : (r >> 3);
+	if (r >= 0x80 && r <= 0x8F) return r - 0x80;
+	if (r >= 0x90 && r <= 0x92) return 16 + r - 0x90;
+	if (r >= 0xBA && r <= 0xC9) return r - 0xBA;
+	if (r >= 0xCA && r <= 0xD5) return 16 + ((r - 0xCA) >> 2);
+	if (r >= 0xD6 && r <= 0xD8) return 16 + r - 0xD6;
+	return 0xFF;
+}
+static inline bool reg_banque(int r) { return (r < 0x80 && (r & 7) == 0) || r == 0xCC || r == 0xD0 || r == 0xD4; }
+
+static inline uint32_t crc32(const uint8_t *p, size_t n, uint32_t c = 0)
+{
+	c = ~c;
+	for (size_t i = 0; i < n; i++) { c ^= p[i]; for (int k = 0; k < 8; k++) c = (c >> 1) ^ (0xEDB88320u & (0u - (c & 1))); }
+	return ~c;
+}
+
+class rejeu {
+public:
+	std::string erreur;
+	etat_t e;
+	uint16_t vide;                          // code Z80 vide envoye a la place d'un son rejoue
+	rejeu() : vide(0x0000), m_j(NULL) {}
+	~rejeu() { if (m_j) fclose(m_j); }
+
+	void ouvre_journal(const char *p) { if (p && *p) m_j = fopen(p, "w"); }
+	size_t nb_sons() const { return m_sons.size(); }
+	size_t nb_codes() const { size_t k = 0; for (size_t i = 0; i < m_code.size(); i++) if (m_code[i] >= 0 || m_alias[i] >= 0) k++; return k; }
+
+	// table : hsfa_rejeu_table.txt ; xdata : X_DATA.BIN, ou ISO (X_DATA.BIN cherche dans la racine ISO9660), ou
+	// 'fichier@decalage hexa' (debut de X_DATA.BIN dans le fichier) ; rom : memoire du 2e QSound (banques de 64 Ko)
+	bool ouvre(const char *table, const char *xdata, uint8_t *rom, size_t taille_rom)
+	{
+		if (!lit_table(table)) return false;
+		return charge_xdata(xdata, rom, taille_rom);
+	}
+
+	// table deja en memoire (texte, eventuellement complete par des octets nuls : la lecture s'arrete au premier)
+	bool ouvre_texte(const char *texte, size_t n) { return lit_table_texte(texte, n); }
+
+	// sources (SOURCE de la table) copiees de X_DATA dans la ROM du 2e QSound, CRC controle ; table lue avant
+	bool charge_xdata(const char *xdata, uint8_t *rom, size_t taille_rom)
+	{
+		std::string chemin(xdata);
+		uint64_t base = 0;
+		size_t at = chemin.rfind('@');
+		if (at != std::string::npos && at > 0 && chemin.find('/', at) == std::string::npos) { base = strtoull(chemin.c_str() + at + 1, NULL, 16); chemin.resize(at); }
+		FILE *f = fopen(chemin.c_str(), "rb");
+		if (!f) { erreur = "X_DATA introuvable : " + chemin; return false; }
+		uint8_t pvd[6];
+		if (base == 0 && lire(f, 0x8000, pvd, 6) && !memcmp(pvd + 1, "CD001", 5)) {
+			base = cherche_iso(f, "X_DATA.BIN");
+			if (!base) { fclose(f); erreur = "ISO sans X_DATA.BIN"; return false; }
+		}
+		for (size_t i = 0; i < m_src.size(); i++) {
+			const source &s = m_src[i];
+			size_t o = size_t(s.banque) << 16;
+			if (o + s.taille > taille_rom) { fclose(f); erreur = "ROM du 2e QSound trop petite"; return false; }
+			if (!lire(f, base + s.off, rom + o, s.taille)) { fclose(f); erreur = "X_DATA illisible (" + s.nom + ")"; return false; }
+			if (crc32(rom + o, s.taille) != s.crc) { fclose(f); erreur = "X_DATA : CRC different pour " + s.nom; return false; }
+		}
+		fclose(f);
+		return true;
+	}
+
+	// ROM du 2e QSound deja remplie (image des sources a leur banque, ex. membre hsfa_rejeu.bin du zip) : CRC controle
+	bool verifie_rom(const uint8_t *rom, size_t taille_rom)
+	{
+		if (m_src.empty()) { erreur = "table non lue"; return false; }
+		for (size_t i = 0; i < m_src.size(); i++) {
+			const source &s = m_src[i];
+			size_t o = size_t(s.banque) << 16;
+			if (o + s.taille > taille_rom) { erreur = "ROM du 2e QSound trop petite"; return false; }
+			if (crc32(rom + o, s.taille) != s.crc) { erreur = "ROM du rejeu : CRC different pour " + s.nom; return false; }
+		}
+		return true;
+	}
+	// sources decrites par la table (pour construire l'image hors de l'emulateur)
+	size_t nb_sources() const { return m_src.size(); }
+
+	// mise sous tension du 2e QSound : initialisation du pilote d'origine apres 0,1 s (le DSP doit avoir demarre)
+	void reset(int64_t maintenant)
+	{
+		e.raz();
+		if (!m_init.empty()) lance(K_INIT, 0, maintenant + 100000, 0);
+	}
+
+	// commande posee par le 68K. Rend PASSE ou REMPLACE (*z80 = code a transmettre au Z80 a la place).
+	int commande(uint16_t cmd, int64_t maintenant, uint16_t *z80)
+	{
+		if (m_sons.empty()) return PASSE;
+		if (cmd == 0xFF00) {
+			for (int i = 0; i < NI; i++) e.ins[i].ent = -1;
+			for (int v = 0; v < NV; v++) { e.proprio[v] = -1; e.prio[v] = 0; e.fin[v] = 0; }
+			if (!m_stop.empty()) lance(K_STOP, 0, maintenant, 0);
+			trace("%lld FF00 : arret\n", (long long)maintenant);
+			return PASSE;
+		}
+		if (m_alias[cmd] >= 0) { *z80 = uint16_t(m_alias[cmd]); trace("%lld %04X -> Z80 %04X\n", (long long)maintenant, cmd, *z80); return REMPLACE; }
+		int32_t k = m_code[cmd];
+		if (k < 0) return PASSE;
+		const son &s = m_sons[k];
+		uint32_t prises = 0;
+		for (int v = 0; v < NV; v++) {
+			if (!(s.voies & (1u << v))) continue;
+			bool occupee = e.proprio[v] >= 0 && maintenant < e.fin[v];
+			if (occupee && s.prio < e.prio[v]) continue;            // pilote : 'cp (ix+prio) ; jp c,suivante'
+			prises |= 1u << v;
+		}
+		*z80 = vide;
+		if (!prises) { trace("%lld %04X (%s %04X prio %02X) refuse : voies occupees\n", (long long)maintenant, cmd, m_src[s.jeu].nom.c_str(), s.src, s.prio); return REMPLACE; }
+		int i = lance(K_SON, k, maintenant, prises);
+		for (int v = 0; v < NV; v++) {
+			if (!(prises & (1u << v))) continue;
+			int32_t a = e.proprio[v];
+			if (a >= 0 && a != i) e.ins[a].voies &= ~(1u << v);
+			e.proprio[v] = i; e.prio[v] = s.prio; e.fin[v] = maintenant + s.fin[v];
+		}
+		trace("%lld %04X -> %s %04X prio %02X voies %05X\n", (long long)maintenant, cmd, m_src[s.jeu].nom.c_str(), s.src, s.prio, prises);
+		return REMPLACE;
+	}
+
+	// instant (us) de la prochaine ecriture, ou -1
+	int64_t prochain() const
+	{
+		int64_t m = -1;
+		for (int i = 0; i < NI; i++) {
+			const instance &x = e.ins[i];
+			if (x.ent < 0) continue;
+			int64_t t = x.t0 + ecr(x)[x.pos].t;
+			if (m < 0 || t < m) m = t;
+		}
+		return m;
+	}
+
+	// ecrit (dans l'ordre des temps) toutes les ecritures dues a l'instant maintenant : W::ecrit(reg, val)
+	template <class W> void avance(int64_t maintenant, W &w)
+	{
+		for (;;) {
+			int best = -1; int64_t bt = 0;
+			for (int i = 0; i < NI; i++) {
+				const instance &x = e.ins[i];
+				if (x.ent < 0) continue;
+				int64_t t = x.t0 + ecr(x)[x.pos].t;
+				if (t <= maintenant && (best < 0 || t < bt)) { best = i; bt = t; }
+			}
+			if (best < 0) return;
+			instance &x = e.ins[best];
+			const ecriture &c = ecr(x)[x.pos];
+			int jeu = x.kind == K_SON ? m_sons[x.ent].jeu : x.ent;
+			bool garde = x.kind != K_SON || (c.voie == 0xFF ? x.voies != 0 : (x.voies & (1u << c.voie)) != 0);
+			if (garde) {
+				uint16_t v = c.val;
+				if (reg_banque(c.reg) && m_src[jeu].banque) v = uint16_t((v & 0x8000) | ((v + m_src[jeu].banque) & 0x7FFF));
+				w.ecrit(c.reg, v);
+			}
+			if (++x.pos >= taille(x)) {
+				if (x.kind == K_SON) for (int v = 0; v < NV; v++) if (e.proprio[v] == best) e.proprio[v] = -1;
+				x.ent = -1;
+			}
+		}
+	}
+
+private:
+	std::vector<son> m_sons;
+	std::vector<ecriture> m_ecr, m_init, m_stop;
+	std::vector<source> m_src;
+	std::vector<int32_t> m_code, m_alias;
+	FILE *m_j;
+
+	void trace(const char *fmt, ...)
+#if defined(__GNUC__)
+		__attribute__((format(printf, 2, 3)))
+#endif
+	{
+		if (!m_j) return;
+		char t[512]; va_list ap; va_start(ap, fmt); vsnprintf(t, sizeof(t), fmt, ap); va_end(ap);
+		fwrite(t, 1, strlen(t), m_j); fflush(m_j);   // vsnprintf + fwrite : compatible avec la couche fichiers de libretro
+	}
+	const ecriture *ecr(const instance &x) const
+	{
+		if (x.kind == K_INIT) return &m_init[0];
+		if (x.kind == K_STOP) return &m_stop[0];
+		return &m_ecr[m_sons[x.ent].debut];
+	}
+	uint32_t taille(const instance &x) const
+	{
+		if (x.kind == K_INIT) return uint32_t(m_init.size());
+		if (x.kind == K_STOP) return uint32_t(m_stop.size());
+		return m_sons[x.ent].n;
+	}
+	int lance(int kind, int32_t ent, int64_t t0, uint32_t voies)
+	{
+		int libre = -1;
+		for (int i = 0; i < NI; i++) if (e.ins[i].ent < 0) { libre = i; break; }
+		if (libre < 0) {                                       // plein : on remplace le son le plus ancien
+			libre = 0;
+			for (int i = 1; i < NI; i++) if (e.ins[i].t0 < e.ins[libre].t0) libre = i;
+			for (int v = 0; v < NV; v++) if (e.proprio[v] == libre) e.proprio[v] = -1;
+		}
+		instance &x = e.ins[libre];
+		x.kind = kind; x.ent = ent; x.t0 = t0; x.pos = 0; x.voies = voies;
+		return libre;
+	}
+	static bool lire(FILE *f, uint64_t o, void *d, size_t n) { return !fseek64r(f, o) && fread(d, 1, n, f) == n; }
+	static uint32_t rd32le(const uint8_t *p) { return p[0] | (p[1] << 8) | (p[2] << 16) | (uint32_t(p[3]) << 24); }
+	uint64_t cherche_iso(FILE *f, const char *nom)
+	{
+		uint8_t pvd[2048];
+		if (!lire(f, 0x8000, pvd, 2048)) return 0;
+		uint32_t lba = rd32le(pvd + 156 + 2), tai = rd32le(pvd + 156 + 10);
+		if (tai > 1 << 20) return 0;
+		std::vector<uint8_t> d(tai);
+		if (!lire(f, uint64_t(lba) * 2048, &d[0], tai)) return 0;
+		size_t ln = strlen(nom);
+		for (size_t p = 0; p < tai;) {
+			uint8_t l = d[p];
+			if (!l) { p = (p / 2048 + 1) * 2048; continue; }
+			if (p + 33 > tai) break;
+			uint8_t nl = d[p + 32];
+			if (nl >= ln && !memcmp(&d[p + 33], nom, ln) && (nl == ln || d[p + 33 + ln] == ';')) return uint64_t(rd32le(&d[p + 2])) * 2048;
+			p += l;
+		}
+		return 0;
+	}
+	int jeu_de(const char *nom) const { for (size_t i = 0; i < m_src.size(); i++) if (m_src[i].nom == nom) return int(i); return -1; }
+
+	// lecteur de lignes (comme fgets) sur un texte en memoire, arret au premier octet nul
+	struct lignes {
+		const char *p, *fin;
+		bool suivante(char *l, size_t n)
+		{
+			if (p >= fin || !*p) return false;
+			size_t k = 0;
+			while (p < fin && *p && k + 1 < n) { char c = *p++; l[k++] = c; if (c == '\n') break; }
+			l[k] = 0;
+			return true;
+		}
+	};
+
+	bool lit_table(const char *chemin)
+	{
+		FILE *f = fopen(chemin, "rb");
+		if (!f) { erreur = std::string("table introuvable : ") + chemin; return false; }
+		std::string t;
+		char b[65536];
+		size_t n;
+		while ((n = fread(b, 1, sizeof(b), f)) > 0) t.append(b, n);
+		fclose(f);
+		return lit_table_texte(t.data(), t.size());
+	}
+
+	bool lit_table_texte(const char *texte, size_t taille)
+	{
+		lignes src; src.p = texte; src.fin = texte + taille;
+		m_sons.clear(); m_ecr.clear(); m_init.clear(); m_stop.clear(); m_src.clear(); vide = 0x0000;
+		m_code.assign(65536, -1); m_alias.assign(65536, -1);
+		std::vector<std::pair<uint16_t, uint16_t> > refs;
+		char l[256], a[64], b[64];
+		std::vector<ecriture> *bloc = NULL; int reste = 0; son *cour = NULL;
+		while (src.suivante(l, sizeof(l))) {
+			if (reste > 0) {
+				unsigned t = 0, r = 0, v = 0;
+				if (cour) { if (sscanf(l, "%u %x %x", &t, &r, &v) != 3) break; }
+				else if (sscanf(l, "%x %x", &r, &v) != 2) break;
+				ecriture c; c.t = cour ? t : 0; c.reg = uint8_t(r); c.val = uint16_t(v); c.voie = uint8_t(voie_de(r));
+				bloc->push_back(c);
+				if (cour && c.voie != 0xFF) { cour->voies |= 1u << c.voie; if (t > cour->fin[c.voie]) cour->fin[c.voie] = t; }
+				if (--reste == 0) { if (cour) cour->n = uint32_t(m_ecr.size() - cour->debut); cour = NULL; }
+				continue;
+			}
+			if (l[0] == '#' || l[0] == '\n') continue;
+			unsigned x1 = 0, x2 = 0, x3 = 0, x4 = 0; int n = 0;
+			if (sscanf(l, "SOURCE %63s %x %x %x %x", a, &x1, &x2, &x3, &x4) == 5) {
+				source s; s.nom = a; s.off = x1; s.taille = x2; s.banque = uint8_t(x3); s.crc = x4; m_src.push_back(s);
+			} else if (sscanf(l, "INIT %63s %d", a, &n) == 2) { bloc = &m_init; reste = n; cour = NULL; m_init.clear(); }
+			else if (sscanf(l, "STOP %63s %d", a, &n) == 2) { bloc = &m_stop; reste = n; cour = NULL; m_stop.clear(); }
+			else if (sscanf(l, "CODE %x %63s %x %x %d", &x1, a, &x2, &x3, &n) == 5) {
+				int j = jeu_de(a);
+				if (j < 0 || n <= 0 || x1 > 0xFFFF) { erreur = std::string("table : ligne invalide ") + l; return false; }
+				son s; memset(&s, 0, sizeof(s)); s.code = uint16_t(x1); s.jeu = uint8_t(j); s.src = uint16_t(x2); s.prio = uint8_t(x3);
+				s.debut = uint32_t(m_ecr.size());
+				m_code[x1] = int32_t(m_sons.size()); m_sons.push_back(s); cour = &m_sons.back();
+				bloc = &m_ecr; reste = n;
+			} else if (sscanf(l, "REF %x %x", &x1, &x2) == 2) refs.push_back(std::make_pair(uint16_t(x1), uint16_t(x2)));
+			else if (sscanf(l, "ALIAS %x %x", &x1, &x2) == 2) m_alias[x1 & 0xFFFF] = int32_t(x2 & 0xFFFF);
+			else if (sscanf(l, "VIDE %x", &x1) == 1) vide = uint16_t(x1);
+			(void)b;
+		}
+		if (reste) { erreur = "table tronquee"; return false; }
+		for (int passe = 0; passe < 4; passe++)                    // REF vers un REF : resolu en quelques passes
+			for (size_t i = 0; i < refs.size(); i++) if (m_code[refs[i].second] >= 0) m_code[refs[i].first] = m_code[refs[i].second];
+		if (m_sons.empty() || m_src.empty()) { erreur = "table vide"; return false; }
+		return true;
+	}
+};
+
+} // namespace hsfa_rejeu
