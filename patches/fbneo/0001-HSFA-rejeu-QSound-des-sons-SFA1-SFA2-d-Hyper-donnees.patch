+static void HsfaRejeuLibere()
+{
+	delete HsfaRejeu; HsfaRejeu = NULL;
+	delete HsfaQs2; HsfaQs2 = NULL;
+	BurnFree(HsfaRejeuRom);
+}
+
+static void HsfaRejeuInit()
+{
+	nRejeuTrame = 0; nRejeuEch = 0; nRejeuPrec[0] = nRejeuPrec[1] = 0;
+	bRejeuSeul = getenv("HSFA_REJEU_SEUL") && atoi(getenv("HSFA_REJEU_SEUL")) == 1;
+	if (!HsfaHyper) return;
+	char dir[MAX_PATH];
+	snprintf(dir, sizeof(dir), "%.*shsfa/", MAX_PATH - 8, szAppHiscorePath);
+	if (HsfaRejeuCharge(dir)) HsfaRejeuLibere();
+}
+
+static void HsfaRejeuReset()
+{
+	if (!HsfaRejeu) return;
+	HsfaQs2->reset();
+	HsfaRejeu->reset(HsfaRejeuDebut(nRejeuTrame) / 60);
+}
+
+// commande posee par le 68K (apres le lecteur de flux) : 1 = a remplacer par *pZ80 pour le Z80
+INT32 HsfaRejeuCommande(UINT16 nCmd, UINT16 *pZ80)
+{
+	if (!HsfaRejeu) return 0;
+	return HsfaRejeu->commande(nCmd, HsfaRejeuMaintenant(), pZ80) == hsfa_rejeu::REMPLACE;
+}
+
+// fin d'image : 2e QSound rendu sur l'image, ajoute a la sortie (stereo entrelacee, nBurnSoundRate)
+void HsfaRejeuRendu(INT16 *pOut, INT32 nLen)
+{
+	if (!HsfaRejeu) return;
+	INT64 d = HsfaRejeuDebut(nRejeuTrame), f = HsfaRejeuDebut(nRejeuTrame + 1);
+	if (pOut && nLen > 0) {
+		double g = Cps2Volume / 39.0;
+		if (bRejeuSeul) memset(pOut, 0, nLen * 2 * sizeof(INT16));
+		for (INT32 i = 0; i < nLen; i++) {
+			INT64 t = d + (f - d) * i / nLen;
+			HsfaRejeuGenere(t);
+			INT32 fr = (INT32)(t - (nRejeuEch - 1) * HSFA_QS_PERIODE);	// 0..2495 apres l'echantillon courant
+			for (INT32 c = 0; c < 2; c++) {
+				INT32 o = nRejeuPrec[c] + (((HsfaQs2->c.out[c] - nRejeuPrec[c]) * fr) / HSFA_QS_PERIODE);
+				INT32 v = pOut[2 * i + c] + (INT32)(o * g);
+				pOut[2 * i + c] = (INT16)(v > 32767 ? 32767 : (v < -32768 ? -32768 : v));
+			}
+		}
+	}
+	HsfaRejeuGenere(f - 1);
+	nRejeuTrame++;
+}
