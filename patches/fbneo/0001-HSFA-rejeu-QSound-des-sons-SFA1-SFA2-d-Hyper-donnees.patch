+static INT32 HsfaRejeuCharge(const char *dir)
+{
+	std::string tz, source;
+	if (getenv("HSFA_REJEU") && atoi(getenv("HSFA_REJEU")) == 0) return 0;
+	HsfaRejeu = new hsfa_rejeu::rejeu();
+	// table : HSFA_REJEU_TABLE, membre de l'archive, ou fichier du dossier systeme
+	char t[MAX_PATH + 64];
+	bool ok = false;
+	if (getenv("HSFA_REJEU_TABLE")) {
+		FILE *f = fopen(getenv("HSFA_REJEU_TABLE"), "rb");
+		if (f) {
+			char b[65536]; size_t n;
+			while ((n = fread(b, 1, sizeof(b), f)) > 0) tz.append(b, n);
+			fclose(f);
+			ok = true;
+		}
+		snprintf(t, sizeof(t), "%s", getenv("HSFA_REJEU_TABLE"));
+	} else if (HsfaZipLit("hsfa_rejeu_table.txt", tz, 0x4000000)) {
+		ok = true; snprintf(t, sizeof(t), "hsfa_rejeu_table.txt (archive)");
+	} else {
+		snprintf(t, sizeof(t), "%shsfa_rejeu_table.txt", dir);
+		FILE *f = fopen(t, "rb");
+		if (f) {
+			char b[65536]; size_t n;
+			while ((n = fread(b, 1, sizeof(b), f)) > 0) tz.append(b, n);
+			fclose(f);
+			ok = true;
+		}
+	}
+	if (!ok) { bprintf(0, _T("HSFA rejeu : pas de table (hsfa_rejeu_table.txt) : sons SFA3\n")); return 1; }
+	if (!HsfaRejeu->ouvre_texte(tz.data(), tz.size())) { bprintf(0, _T("HSFA rejeu : %s (inactif)\n"), HsfaRejeu->erreur.c_str()); return 1; }
+	tz.clear(); std::string().swap(tz);
+	HsfaRejeuRom = (UINT8*)BurnMalloc(HSFA_REJEU_ROM);
+	if (!HsfaRejeuRom) return 1;
+	memset(HsfaRejeuRom, 0, HSFA_REJEU_ROM);
+	// ROM : HSFA_XDATA, membre de l'archive, X_DATA du dossier systeme, ISO
+	UINT64 zo = 0; UINT32 zn = 0;
+	if (!getenv("HSFA_XDATA") && HsfaZipMembre(szBurnHsfaArchive, "hsfa_rejeu.bin", &zo, &zn)) {
+		FILE *f = fopen(szBurnHsfaArchive, "rb");
+		ok = f && zn == HSFA_REJEU_ROM && fseek(f, (long)zo, SEEK_SET) == 0 && fread(HsfaRejeuRom, 1, zn, f) == zn;
+		if (f) fclose(f);
+		if (ok && HsfaRejeu->verifie_rom(HsfaRejeuRom, HSFA_REJEU_ROM)) source = "hsfa_rejeu.bin (archive)";
+		else bprintf(0, _T("HSFA rejeu : hsfa_rejeu.bin de l'archive invalide (%s)\n"), ok ? HsfaRejeu->erreur.c_str() : "taille ou lecture");
+	}
+	if (source.empty()) {
+		std::vector<std::string> cand;
+		if (getenv("HSFA_XDATA")) cand.push_back(getenv("HSFA_XDATA"));
+		else {
+			static const char *noms[] = { "X_DATA.BIN", "x_data.bin" };
+			for (INT32 i = 0; i < 2; i++) { snprintf(t, sizeof(t), "%s%s", dir, noms[i]); if (HsfaFichierExiste(t)) cand.push_back(t); }
+			snprintf(t, sizeof(t), "%sxdata.txt", dir);
+			FILE *f = fopen(t, "r");
+			if (f) { char l[MAX_PATH + 64]; if (fgets(l, sizeof(l), f)) { l[strcspn(l, "\r\n")] = 0; if (l[0]) cand.push_back(l); } fclose(f); }
+			if (szHsfaYdata[0]) cand.push_back(szHsfaYdata);			// ISO de l'Anthology (X_DATA.BIN y est cherche)
+			else {
+				snprintf(t, sizeof(t), "%santhology.iso", dir); if (HsfaFichierExiste(t)) cand.push_back(t);
+			}
+		}
+		for (size_t i = 0; i < cand.size() && source.empty(); i++) {
+			if (HsfaRejeu->charge_xdata(cand[i].c_str(), HsfaRejeuRom, HSFA_REJEU_ROM)) source = cand[i];
+			else bprintf(0, _T("HSFA rejeu : %s\n"), HsfaRejeu->erreur.c_str());
+		}
+	}
+	if (source.empty()) { bprintf(0, _T("HSFA rejeu : ni hsfa_rejeu.bin dans l'archive, ni X_DATA.BIN (ou ISO) dans %s : sons SFA3\n"), dir); return 1; }
+	HsfaRejeu->ouvre_journal(getenv("HSFA_REJEU_LOG"));
+	HsfaQs2 = new hsfa_qs::qsound();
+	HsfaQs2->fixe_rom(HsfaRejeuRom, HSFA_REJEU_ROM);
+	bprintf(0, _T("HSFA rejeu : %d sons, %d codes (%s ; %s)\n"), (INT32)HsfaRejeu->nb_sons(), (INT32)HsfaRejeu->nb_codes(), t, source.c_str());
+	return 0;
+}
