+// --------------------------------------------------------------------------------------------------------------
+// Membres supplementaires de l'archive du jeu (paquet_fbneo.py), lus sur place : ils ne sont PAS dans la liste de ROM
+// du pilote (FBNeo ne les charge donc pas en memoire) et doivent etre STOCKES (sans compression). Le chemin de l'archive
+// est donne par le frontal (szBurnHsfaArchive, libretro.cpp) ; vide ou archive non zip -> membres absents.
+//   hsfa_flux.bin        AFS reduit (memes indices que Y_DATA.BIN, entrees inutiles vides) : flux ADX du jeu
+//   hsfa_flux_table.txt  table code -> flux
+//   hsfa_rejeu.bin       ROM du 2e QSound (8 Mo : e222 en banque 0, e251 en banque $40), CRC controles par la table
+//   hsfa_rejeu_table.txt table du rejeu (gen_rejeu.py + gen_redirection.py)
+
+
+static UINT32 HsfaLe16(const UINT8 *p) { return p[0] | (p[1] << 8); }
+static UINT32 HsfaLe32(const UINT8 *p) { return p[0] | (p[1] << 8) | (p[2] << 16) | ((UINT32)p[3] << 24); }
+
+// membre STOCKE de l'archive zip : decalage des donnees dans le fichier et taille ; 0 = absent (ou comprime, zip64...)
+static INT32 HsfaZipMembre(const char *zip, const char *nom, UINT64 *pOff, UINT32 *pTaille)
+{
+	if (!zip || !zip[0]) return 0;
+	FILE *f = fopen(zip, "rb");
+	if (!f) return 0;
+	INT32 ok = 0;
+	std::vector<UINT8> fin, cd;
+	UINT8 lh[30];
+	INT64 taille = 0, n = 0, k = 0;
+	UINT32 cdtai = 0, cdoff = 0, ne = 0, p = 0, nl = strlen(nom);
+	if (fseek(f, 0, SEEK_END) != 0) goto sortie;
+	taille = ftell(f);
+	if (taille < 22) goto sortie;
+	n = taille < 65557 ? taille : 65557;
+	fin.resize((size_t)n);
+	if (fseek(f, (long)(taille - n), SEEK_SET) != 0 || fread(&fin[0], 1, (size_t)n, f) != (size_t)n) goto sortie;
+	for (k = n - 22; k >= 0; k--) if (HsfaLe32(&fin[(size_t)k]) == 0x06054b50) break;
+	if (k < 0) goto sortie;
+	ne = HsfaLe16(&fin[(size_t)k + 10]); cdtai = HsfaLe32(&fin[(size_t)k + 12]); cdoff = HsfaLe32(&fin[(size_t)k + 16]);
+	if (cdtai == 0 || cdtai > 0x4000000 || (INT64)cdoff + cdtai > taille) goto sortie;
+	cd.resize(cdtai);
+	if (fseek(f, (long)cdoff, SEEK_SET) != 0 || fread(&cd[0], 1, cdtai, f) != cdtai) goto sortie;
+	for (UINT32 e = 0; e < ne && p + 46 <= cdtai; e++) {
+		if (HsfaLe32(&cd[p]) != 0x02014b50) break;
+		UINT32 meth = HsfaLe16(&cd[p + 10]), ct = HsfaLe32(&cd[p + 20]), ut = HsfaLe32(&cd[p + 24]);
+		UINT32 l1 = HsfaLe16(&cd[p + 28]), l2 = HsfaLe16(&cd[p + 30]), l3 = HsfaLe16(&cd[p + 32]), lo = HsfaLe32(&cd[p + 42]);
+		if (p + 46 + l1 > cdtai) break;
+		if (l1 == nl && !memcmp(&cd[p + 46], nom, nl)) {
+			if (meth != 0 || ct != ut || ct == 0xFFFFFFFF || lo == 0xFFFFFFFF) {
+				bprintf(0, _T("HSFA : %s n'est pas stocke sans compression dans l'archive (ignore)\n"), nom);
+				goto sortie;
+			}
+			if (fseek(f, (long)lo, SEEK_SET) != 0 || fread(lh, 1, 30, f) != 30 || HsfaLe32(lh) != 0x04034b50) goto sortie;
+			*pOff = (UINT64)lo + 30 + HsfaLe16(lh + 26) + HsfaLe16(lh + 28);
+			*pTaille = ut;
+			ok = (*pOff + ut <= (UINT64)taille);
+			goto sortie;
+		}
+		p += 46 + l1 + l2 + l3;
+	}
+sortie:
+	fclose(f);
+	return ok;
+}
+
+// lit un membre stocke en memoire (texte : un octet nul ajoute)
+static INT32 HsfaZipLit(const char *nom, std::string &d, UINT32 nMax)
+{
+	UINT64 o = 0; UINT32 n = 0;
+	if (!HsfaZipMembre(szBurnHsfaArchive, nom, &o, &n) || n > nMax) return 0;
+	FILE *f = fopen(szBurnHsfaArchive, "rb");
+	if (!f) return 0;
+	d.resize(n);
+	INT32 ok = fseek(f, (long)o, SEEK_SET) == 0 && (n == 0 || fread(&d[0], 1, n, f) == n);
+	fclose(f);
+	return ok;
+}
+
+// le frontal donne le nom de l'archive sans extension (FBNeo essaie .zip puis .7z) : fichier reel, ou vide
+static void HsfaResoutArchive()
+{
+	static const char *ext[] = { "", ".zip", ".ZIP" };
+	char p[MAX_PATH + 8];
+	if (!szBurnHsfaArchive[0]) return;
+	for (INT32 i = 0; i < 3; i++) {
+		snprintf(p, sizeof(p), "%s%s", szBurnHsfaArchive, ext[i]);
+		FILE *f = fopen(p, "rb");
+		if (f) {
+			UINT8 sig[4] = { 0, 0, 0, 0 };
+			INT32 zip = fread(sig, 1, 4, f) == 4 && HsfaLe32(sig) == 0x04034b50;
+			fclose(f);
+			if (zip) { snprintf(szBurnHsfaArchive, MAX_PATH, "%s", p); return; }
+		}
+	}
+	szBurnHsfaArchive[0] = 0;							// 7z ou introuvable : pas de membres lus sur place
+}
