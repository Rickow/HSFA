+// --------------------------------------------------------------------------------------------------------------
+// Rejeu QSound des sons de SFA1 / SFA2 (Hyper seulement ; hsfa_rejeu.h, comme le fork MAME : agent_son_hyper_rom,
+// SON-HYPER-ROM.md §12-§13). Les codes $2000+ / $3000+ / $4000+ du programme traduit d'Hyper sont rejoues sur un
+// 2e QSound (hsfa_qsound.h) dont la ROM vient des fichiers de l'utilisateur ; le Z80 recoit un code vide.
+// Donnees (dans cet ordre) : 1. membres hsfa_rejeu.bin + hsfa_rejeu_table.txt de l'archive ; 2. X_DATA.BIN, x_data.bin,
+// xdata.txt (chemin) ou l'ISO (anthology.iso, ydata.txt) dans <systeme>/fbneo/hsfa/, table de l'archive ou
+// hsfa_rejeu_table.txt de ce dossier ; 3. sinon inactif (sons SFA3).
+// Variables (PC, essais) : HSFA_REJEU=0 (inactif), HSFA_REJEU_TABLE, HSFA_XDATA (X_DATA.BIN | ISO | fichier@decalage),
+// HSFA_REJEU_LOG (journal des decisions, format du fork).
+// Temps : periodes de 60 MHz depuis la mise sous tension ; image n = [n*6e9/nBurnFPS, (n+1)*6e9/nBurnFPS), position
+// dans l'image d'apres les cycles 68000 ; un echantillon du 2e QSound toutes les 2496 periodes (24 038 Hz), ecritures
+// appliquees avant l'echantillon de leur instant, sortie interpolee a la frequence du son et mixee au QSound principal
+// avec le meme volume (Cps2Volume / 39, comme le fork : meme gain numerique que le QSound principal).
+
+#define HSFA_REJEU_ROM	0x800000
+#define HSFA_QS_PERIODE	2496
+
+static hsfa_rejeu::rejeu *HsfaRejeu = NULL;
+static hsfa_qs::qsound *HsfaQs2 = NULL;
+static UINT8 *HsfaRejeuRom = NULL;
+static INT64 nRejeuTrame = 0;						// image courante
+static INT64 nRejeuEch = 0;							// prochain echantillon du 2e QSound
+static INT16 nRejeuPrec[2] = { 0, 0 };				// echantillon precedent (interpolation)
+static INT32 bRejeuSeul = 0;						// HSFA_REJEU_SEUL=1 (essais) : sortie = 2e QSound seul
+
+static inline INT64 HsfaRejeuDebut(INT64 trame) { return trame * 6000000000LL / (nBurnFPS > 0 ? nBurnFPS : 6000); }
+
+// instant courant (us) : debut de l'image + part des cycles 68000 deja executes
+static INT64 HsfaRejeuMaintenant()
+{
+	INT64 d = HsfaRejeuDebut(nRejeuTrame), f = HsfaRejeuDebut(nRejeuTrame + 1);
+	INT64 c = nCpsCycles > 0 ? SekTotalCycles() : 0;
+	if (c < 0) c = 0;
+	return (d + (nCpsCycles > 0 ? (f - d) * c / nCpsCycles : 0)) / 60;
+}
+
+struct HsfaRejeuEcrivain { void ecrit(UINT8 reg, UINT16 val) { HsfaQs2->ecrit(reg, val); } };
+
+// produit les echantillons du 2e QSound jusqu'a l'instant t (periodes de 60 MHz) inclus
+static inline void HsfaRejeuGenere(INT64 t)
+{
+	HsfaRejeuEcrivain w;
+	while (nRejeuEch * HSFA_QS_PERIODE <= t) {
+		nRejeuPrec[0] = HsfaQs2->c.out[0]; nRejeuPrec[1] = HsfaQs2->c.out[1];
+		INT64 te = nRejeuEch * HSFA_QS_PERIODE / 60;
+		INT64 pr = HsfaRejeu->prochain();
+		if (pr >= 0 && pr <= te) HsfaRejeu->avance(te, w);
