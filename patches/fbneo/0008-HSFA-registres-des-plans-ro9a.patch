+// ecriture de mot (MOVE.W #imm,$80420x.L du code traduit) : un seul changement, sans etat intermediaire
+INT32 HsfaPortWriteWord(UINT32 a, UINT16 d)
+{
+	if (HsfaMode == 2 && a >= 0x804200 && a <= 0x804205) {
+		HsfaPlaneWrite((a - 0x804200) >> 1, d, 0xFFFF);
+		return 1;
+	}
+	return 0;
+}
