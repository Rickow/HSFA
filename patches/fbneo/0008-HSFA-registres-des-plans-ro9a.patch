+// (patch 0008) taille minimale de la region graphique : $2000000 + taille de hsfa_gfx.bin dans la liste de ROM du
+// pilote, et au moins 64 Mo (Upper, Hyper : inchange). ro9a : hsfa_gfx.bin de 48 Mo (plans d'Upper en $4000000)
+// -> 80 Mo. Appelee avant PhoenixInit (allocation de la region).
+UINT32 HsfaGfxLenMin()
+{
+	UINT32 n = 0x4000000;
+	struct BurnRomInfo ri;
+	for (INT32 i = 0; ; i++) {
+		memset(&ri, 0, sizeof(ri));
+		if (BurnDrvGetRomInfo(&ri, i) || ri.nLen == 0) break;
+		if ((ri.nType & 0x0f) != CPS2_HSFA_DATA) continue;
+		char *pszName = NULL;
+		BurnDrvGetRomName(&pszName, i, 0);
+		if (pszName && strcmp(pszName, "hsfa_gfx.bin") == 0 && HSFA_GFX_BASE + ri.nLen > n) n = HSFA_GFX_BASE + ri.nLen;
+	}
+	return n;
+}
