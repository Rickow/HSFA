-		if (a & 1) *r = (*r & 0xff00) | d;
-		else *r = (*r & 0x00ff) | (d << 8);
-		HsfaUpdateScroll();
+		if (a & 1) HsfaPlaneWrite((a - 0x804200) >> 1, d, 0x00FF);
+		else HsfaPlaneWrite((a - 0x804200) >> 1, d << 8, 0xFF00);
 		return 1;
 	}
 	if (HsfaMode == 1 && !bHsfaWordWrite && a >= 0x804102 && a <= 0x804107) {
