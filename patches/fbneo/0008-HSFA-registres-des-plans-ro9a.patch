+static int arc_force = 0; static uint8_t arc_liste[16]; static uint32_t arc_ladv = 0xFF4B2E;	/* LISTE_ADV (script) */	/* FORCE_LISTE=32 chiffres hexa : liste des adversaires imposee */
+static char arc_vus[512][24]; static int arc_nvus = 0;
+static void arc_selectionne(const struct spec *s)
+{
+	uint32_t P = JJ[0]; int et = u8(P + 5);
+	if (et == 0) {
+		int d = chemin(u16(P + 0x12) & 7, u16(P + 0x16) & 7, s->base, 0);
+		if (d >= 0) appui(1, DNOM[d]); else { if (s->ex) on("1 Player Start"); if (K % 16 >= 8 && K % 16 < 11) on("P1 Button 1"); }
+	} else if (et == 2) {
+		int c = colonne(s); if (c < 0) c = 0;
+		if (u8(P + 0x5C) != c) appui(1, "Down"); else if (K % 16 >= 8 && K % 16 < 11) on("P1 Button 1");
+	} else if (et == 6) {
+		if (u8(P + 0x5C) == s->mode) appui(1, "Button 1"); else appui(1, "Down");
+	} else if (et == 8) {
+		int i = u8(P + 0x133); if (i >= 0x80) i -= 0x100;
+		if (i != s->ism) appui(1, "Down"); else appui(1, "Button 1");
+	} else if (et == 4 || et == 0xA) appui(1, "Button 1");
+}
+static void arc_image(int k, int nf)
+{
+	K = k;
+	memset(vpad, 0, sizeof(vpad));
+	if (arc_fini) return;
+	int p0 = u16(0xFF8000), p4 = u16(0xFF8004), p8 = u16(0xFF8008), pc_ = u16(0xFF800C), p10 = u16(0xFF8010);
+	if (p0 == 6 || p0 == 4 || (p0 == 2 && p4 == 0)) {
+		if (k > 200 && k % 60 < 6 && k < 900) on("Coin 1");
+		if (p0 == 6 && k > 300 && k % 40 < 6) on("1 Player Start");
+		if (p0 == 4) {
+			w8(0xFF4201, 0);
+			if (u8(0xFF4201) != 0) { if (k % 20 < 4) on("P1 Up"); }
+			else if (k % 20 >= 10 && k % 20 < 14) on("P1 Button 1");
+		}
+	}
+	if (p0 == 2 && p4 == 2 && p8 == 4 && u8(JJ[0] + 1) != 0 && u8(JJ[0] + 5) < 0xC) arc_selectionne(&arc_spec);
+	if (p0 == 2 && p4 == 2 && p8 != 4 && k % 24 >= 12 && k % 24 < 15) on("P1 Button 1");
+	if (arc_graine >= 0 && p0 == 2 && p4 == 2 && (p8 == 6 || arc_graine_sel)) w16(0xFF80AE, arc_graine);
+	/* FORCE_LISTE (comparaison avec le banc : memes adversaires) : liste $FF4B2E (format de la ligne MANCHE) recopiee
+	   a chaque image de fin de selection et de partie */
+	if (arc_force && p0 == 2 && ((p4 == 2 && p8 == 6) || p4 == 4)) for (int i = 0; i < 16; i++) w8(arc_ladv + (i ^ 1), arc_liste[i]);
+	uint32_t adv[3]; int nadv = 0;
+	const uint32_t AO[3] = { 0xFF8800, 0xFF8C00, 0xFF9000 };
+	for (int i = 0; i < 3; i++) if (u8(AO[i] + 5) == 2) adv[nadv++] = AO[i];
+	int combat = p0 == 2 && p4 == 4 && p8 == 6 && u8(JJ[0] + 5) == 2 && nadv > 0;
+	if (combat) {
+		arc_stable++;
+		if (arc_stable == 1) {
+			arc_combats++;
+			if (jrn) {
+				fprintf(jrn, "MANCHE %d image %d J1 %02x/%02x/%02x J2 %02x/%02x/%02x etape %04x decor %04x liste ", arc_combats, k,
+					u8(JJ[0] + 0x103), u8(JJ[0] + 0x117), u8(JJ[0] + 0x116), u8(JJ[1] + 0x103), u8(JJ[1] + 0x117), u8(JJ[1] + 0x116),
+					u16(0xFF8114), u16(0xFF8100));
+				for (int i = 0; i < 16; i++) fprintf(jrn, "%02x", u8(arc_ladv + (i ^ 1)));
+				fprintf(jrn, "\n");
+			}
+		}
+		w16(JJ[0] + 0x50, 0x90); w16(JJ[0] + 0x52, 0x90);
+		if (arc_stable > 60) {
+			for (int i = 0; i < nadv; i++) { int vie = u16(adv[i] + 0x50); if (vie > 1 && vie < 0x100) { w16(adv[i] + 0x50, 1); w16(adv[i] + 0x52, 1); } }
+			const char *av = (u16(JJ[0] + 0x12) < u16(adv[0] + 0x12)) ? "P1 Right" : "P1 Left";
+			int t = arc_stable % 40;
+			if (t < 3) on("P1 Down");
+			else if (t < 6) { on("P1 Down"); on(av); }
+			else if (t < 10) { on(av); if (t >= 7) on("P1 Button 1"); }
+			else if (t < 30) on(av);		/* "P1 Button 4" du script : sur :IN1 dans MAME, jamais appuye */
+		}
+	} else {
+		arc_stable = 0;
+		if (p0 == 2 && p4 != 2 && p4 != 0 && !(arc_nocont && p4 == 6) && !(arc_passif && p4 == 0xA)) {
+			if (k % 30 < 3) on("1 Player Start");
+			if (k % 30 >= 15 && k % 30 < 18) on("P1 Button 1");
+		}
+	}
+	{	/* journal : liste des adversaires a chaque changement (ligne LISTE) */
+		static char lprec[40] = ""; char l[40];
+		for (int i = 0; i < 16; i++) snprintf(l + 2 * i, 3, "%02x", u8(arc_ladv + (i ^ 1)));
+		if (strcmp(l, lprec)) { if (jrn) fprintf(jrn, "LISTE %d %s graine %04x\n", k, l, u16(0xFF80AE)); strcpy(lprec, l); }
+	}
+	char st[400];
+	snprintf(st, sizeof(st), "%04x %04x %04x %04x %04x | J1 %02x %02x %02x %02x | J2 %02x %02x %02x %02x | $A9 %02x $100 %04x",
+		p0, p4, p8, pc_, p10, u8(JJ[0] + 1), u8(JJ[0] + 5), u8(JJ[0] + 0x103), u8(JJ[0] + 0xD2),
+		u8(JJ[1] + 1), u8(JJ[1] + 5), u8(JJ[1] + 0x103), u8(JJ[1] + 0xD2), u8(0xFF80A9), u16(0xFF8100));
+	if (strcmp(st, arc_last)) { if (jrn) fprintf(jrn, "%6d : %s\n", k, st); strcpy(arc_last, st); arc_immobile = 0; } else arc_immobile++;
+	if (arc_immobile > arc_blocage && !combat) {
+		arc_fini = 1; snap(k);
+		if (jrn) fprintf(jrn, "BLOQUE %d etat %s\n", k, st);
+		return;
+	}
+	char nom[24]; snprintf(nom, sizeof(nom), "%04x %04x %04x %04x", p0, p4, p8, pc_);
+	int vu = 0;
+	for (int i = 0; i < arc_nvus && !vu; i++) if (!strcmp(arc_vus[i], nom)) vu = 1;
+	if (!vu && arc_nvus < 512) {
+		strcpy(arc_vus[arc_nvus++], nom);
+		if (arc_snapetat && p0 == 2 && k + 40 <= nf) arc_snapq[k + 40] = arc_nvus;
+	}
+	if (arc_snapsc > 0 && k % arc_snapsc == 0 && p0 == 2 && (p4 == 6 || p4 == 8 || p4 == 0xA || p4 == 0xC) && !arc_snapq[k]) arc_snapq[k] = -1;
+	if (arc_snapq[k]) { snap(k); if (jrn) fprintf(jrn, "SNAP %d %s\n", k, arc_snapq[k] > 0 ? arc_vus[arc_snapq[k] - 1] : nom); }
