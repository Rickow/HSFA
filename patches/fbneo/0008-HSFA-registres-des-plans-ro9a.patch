+// (agent_coeur_banques, patch 0008) ecriture d'un registre de plan avec masque d'octets (COMBINE_DATA du fork MAME).
+// Equivalent de mark_all_dirty : FBNeo redessine chaque image tous les plans depuis la ROM graphique a partir de
+// nCpsGfxScroll (aucun cache de tuiles a invalider) ; seul un CHANGEMENT de valeur met nCpsGfxScroll a jour.
+// HSFA_PLANS_LOG=<fichier> (essais) : « image k : s1 s2 s3 » a chaque changement (comparaison avec le banc MAME).
+static FILE *HsfaPlansLog = NULL;
+static INT32 nPlansLog = -1;
+
+static void HsfaPlaneWrite(INT32 k, UINT16 d, UINT16 nMask)
+{
+	UINT16 v = (nPlaneReg[k] & ~nMask) | (d & nMask);
+	if (v == nPlaneReg[k]) return;
+	nPlaneReg[k] = v;
+	HsfaUpdateScroll();
+	if (nPlansLog < 0) {
+		const char *f = getenv("HSFA_PLANS_LOG");
+		HsfaPlansLog = (f && *f) ? fopen(f, "w") : NULL;
+		nPlansLog = HsfaPlansLog ? 1 : 0;
+	}
+	if (nPlansLog) {
+		fprintf(HsfaPlansLog, "%d : %04x %04x %04x\n", nImage, nPlaneReg[0], nPlaneReg[1], nPlaneReg[2]);
+		fflush(HsfaPlansLog);
+	}
+}
