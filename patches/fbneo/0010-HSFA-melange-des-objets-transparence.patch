+	HsfaScanMelange(nAction, ((nAction & ACB_WRITE) && BurnAcb == StateReadAcb)
+		? (INT64)nTempSize - (INT64)nStateTmpLen[nSavestateContext] : (INT64)-1);
+#endif
+
 	return 0;
 }
 
