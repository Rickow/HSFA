+// (HSFA, patch 0010) melange des objets par palette OBJ (registres $804220-$80423F, cps_hsfa.cpp). nCpsBlend vaut
+// 0x100 | mode pour un objet HSFA (les valeurs < 0x100 restent celles de la blendtable des jeux CPS1/CPS2 d'origine) :
+//   1 = additif sature (dst + src par composante, PSP sceGuBlendFunc(ADD, FIX, FIX, 0xFFFFFF, 0xFFFFFF))
+//   2 = alpha 50 % (src * 0x80 + dst * 0x7F) / 256 (PSP : couleur de sommet d'alpha 0x80)
+//   3 = alpha 75 % (src * 0xC0 + dst * 0x3F) / 256 (PSP : alpha 0xC0)
+//   4 = soustractif sature (dst - src)
+//   autre = opaque (reserve)
+static inline UINT32 hsfa_mix(UINT32 d, UINT32 s, UINT32 m)
+{
+	switch (m) {
+		case 1: {
+			UINT32 rb = (d & 0xff00ff) + (s & 0xff00ff);
+			UINT32 g  = (d & 0x00ff00) + (s & 0x00ff00);
+			rb |= ((rb & 0x01000100) - ((rb & 0x01000100) >> 8));	// saturation de R et B
+			g  |= ((g  & 0x00010000) - ((g  & 0x00010000) >> 8));	// saturation de G
+			return (rb & 0xff00ff) | (g & 0x00ff00);
+		}
+		case 2: return alpha_blend(d, s, 0x80);
+		case 3: return alpha_blend(d, s, 0xC0);
+		case 4: {
+			INT32 r = (INT32)((d >> 16) & 0xff) - (INT32)((s >> 16) & 0xff);
+			INT32 g = (INT32)((d >>  8) & 0xff) - (INT32)((s >>  8) & 0xff);
+			INT32 b = (INT32)( d        & 0xff) - (INT32)( s        & 0xff);
+			return ((r < 0 ? 0 : r) << 16) | ((g < 0 ? 0 : g) << 8) | (b < 0 ? 0 : b);
+		}
+	}
+	return s;
+}
+
+static inline UINT32 cps_mix(UINT32 d, UINT32 s, UINT32 p)
+{
+	if (p < 0x100) return alpha_blend(d, s, p);
+	return hsfa_mix(d, s, p & 0xff);
+}
+
+// 16 bits (RGB565 ou 0RGB1555 selon BurnHighCol : nCtvVert6 pose par CtvReady) : objets HSFA seulement ; les valeurs
+// < 0x100 de nCpsBlend restent ignorees a 16 bits, comme avant
+static INT32 nCtvVert6 = 1;
+static inline UINT32 cps_mix16(UINT32 d, UINT32 s, UINT32 p)
+{
+	if (p < 0x100) return s;
+	UINT32 d32, s32, r;
+	if (nCtvVert6) {
+		d32 = ((d & 0xf800) << 8) | ((d & 0x07e0) << 5) | ((d & 0x001f) << 3);
+		s32 = ((s & 0xf800) << 8) | ((s & 0x07e0) << 5) | ((s & 0x001f) << 3);
+		d32 |= ((d32 >> 5) & 0x070007) | ((d32 >> 6) & 0x000300);
+		s32 |= ((s32 >> 5) & 0x070007) | ((s32 >> 6) & 0x000300);
+		r = hsfa_mix(d32, s32, p & 0xff);
+		return ((r >> 8) & 0xf800) | ((r >> 5) & 0x07e0) | ((r >> 3) & 0x001f);
+	}
+	d32 = ((d & 0x7c00) << 9) | ((d & 0x03e0) << 6) | ((d & 0x001f) << 3);
+	s32 = ((s & 0x7c00) << 9) | ((s & 0x03e0) << 6) | ((s & 0x001f) << 3);
+	d32 |= (d32 >> 5) & 0x070707;
+	s32 |= (s32 >> 5) & 0x070707;
+	r = hsfa_mix(d32, s32, p & 0xff);
+	return ((r >> 9) & 0x7c00) | ((r >> 6) & 0x03e0) | ((r >> 3) & 0x001f);
+}
