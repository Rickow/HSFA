+UINT8 nHsfaObjMix[32];
+UINT8 nHsfaObjFlagMix = 0;
+static FILE *HsfaMixLog = NULL;
+static INT32 nMixLog = -1;
+
+static void HsfaMixWrite(INT32 p, UINT8 v)
+{
+	if (nHsfaObjMix[p] == v) return;
+	nHsfaObjMix[p] = v;
+	if (nMixLog < 0) {
+		const char *f = getenv("HSFA_MIX_LOG");
+		HsfaMixLog = (f && *f) ? fopen(f, "w") : NULL;
+		nMixLog = HsfaMixLog ? 1 : 0;
+	}
+	if (nMixLog) { fprintf(HsfaMixLog, "%d : palette %02x = %d\n", nImage, p, v); fflush(HsfaMixLog); }
+}
+
+static void HsfaFlagMixWrite(UINT8 v)
+{
+	if (nHsfaObjFlagMix == v) return;
+	nHsfaObjFlagMix = v;
+	if (nMixLog < 0) {
+		const char *f = getenv("HSFA_MIX_LOG");
+		HsfaMixLog = (f && *f) ? fopen(f, "w") : NULL;
+		nMixLog = HsfaMixLog ? 1 : 0;
+	}
+	if (nMixLog) { fprintf(HsfaMixLog, "%d : objets marques = %d\n", nImage, v); fflush(HsfaMixLog); }
+}
+
+static void HsfaMixReset()
+{
+	memset(nHsfaObjMix, 0, sizeof(nHsfaObjMix));
+	nHsfaObjFlagMix = 0;
+	const char *e = getenv("HSFA_OBJMIX");			// essais : HSFA_OBJMIX=03:1,04:2 (21:1 = objets marques)
+	if (HsfaMode != 2 || e == NULL) return;
+	for (const char *q = e; *q; ) {
+		char *f = NULL, *g = NULL;
+		long p = strtol(q, &f, 16);
+		if (f == q || *f != ':') break;
+		long v = strtol(f + 1, &g, 16);
+		if (g == f + 1) break;
+		if (p >= 0 && p < 32) nHsfaObjMix[p] = (UINT8)v;
+		if (p == 0x21) nHsfaObjFlagMix = (UINT8)v;
+		if (*g != ',') break;
+		q = g + 1;
+	}
+}
