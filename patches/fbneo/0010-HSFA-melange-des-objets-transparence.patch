+// (patch 0010) etats : les registres ne sont PAS dans HsfaScan mais en DERNIERE zone de l'etat libretro
+// (LibretroAreaScan, retro_memory.cpp), pour que les etats anterieurs au patch (sans ces octets, tout le reste a la
+// meme place) se rechargent : ce qui manque a la fin de l'etat charge est remis a 0.
+// nRestant = octets encore disponibles dans l'etat charge (-1 : pas de limite, sauvegarde ou taille) ; chaque partie
+// absente vaut 0 : palettes (32 octets), puis mode des objets marques (1 octet).
+INT32 HsfaScanMelange(INT32 nAction, INT64 nRestant)
+{
+	if (HsfaMode != 2 || !(nAction & ACB_DRIVER_DATA)) return 0;
+	if (nRestant < 0 || nRestant >= (INT64)sizeof(nHsfaObjMix)) {
+		SCAN_VAR(nHsfaObjMix);
+		if (nRestant >= 0) nRestant -= sizeof(nHsfaObjMix);
+	} else {
+		if (nAction & ACB_WRITE) memset(nHsfaObjMix, 0, sizeof(nHsfaObjMix));
+		nRestant = 0;
+	}
+	if (nRestant < 0 || nRestant >= 1) SCAN_VAR(nHsfaObjFlagMix);
+	else if (nAction & ACB_WRITE) nHsfaObjFlagMix = 0;
+	return 0;
+}
