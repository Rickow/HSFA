 	{0x00, 0x01, 0x03, 0x00, "Off"								},
@@ -217,6 +224,7 @@ static struct BurnDIPInfo HhsfaDIPList[] =
 	{0x00, 0x01, 0x03, 0x02, "All tracks"						},
 
