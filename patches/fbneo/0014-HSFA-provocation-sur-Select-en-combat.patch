 UINT32 HsfaGfxLenMin();
 extern UINT8 nHsfaObjMix[32];							// (patch 0010) melange par palette OBJ, $804220-$80423F
 extern UINT8 nHsfaObjFlagMix;							// (patch 0010) melange des objets marques (bit 12 de X), $804240
+extern INT32 nHsfaProvoc;								// (patch 0014) option "provocation sur Piece en combat"
+void HsfaProvocEntrees(UINT8 *pInp020);
 extern INT32 nHsfaOmbres;								// (patch 0011) option "ombres transparentes (PSP)" active
 static inline INT32 HsfaEstOmbre(UINT32 t)				// (patch 0011) code global d'une tuile d'ombre (palette OBJ 0x14)
 {
diff --git a/src/burn/drv/capcom/cps_hsfa.cpp b/src/burn/drv/capcom/cps_hsfa.cpp
index c960a5b..5974043 100644
--- a/src/burn/drv/capcom/cps_hsfa.cpp
+++ b/src/burn/drv/capcom/cps_hsfa.cpp
@@ -1357,17 +1357,42 @@ static UINT8 HsfaRoulette(UINT32 a)
 	return CpsInp020[4 + j] ? 0xFF : 0;
 }
 
+// (patch 0014) provocation sur la touche Piece en combat. La provocation teste le bit 15 (Start) des nouveaux appuis
+// $378 du joueur (arcade $2E0CC) ; le portage pose Start dans $370 ET dans $372 (image precedente) a la meme image, si
+// bien que $378 = $370 & ~$372 ne recoit jamais ce bit : Start ne provoque pas. Option "Taunt on Select (in fight)"
+// (bit 6 du Dip A, HSFA_PROVOC=0/1 pour les essais) : en combat ($FF8000 = 2, $FF8004 = 4), un nouvel appui sur Piece du
+// joueur N est retire des entrees (pas de credit) et le bit 15 est ajoute aux ecritures de $378 du joueur N ($FF8778,
+// $FF8B78) pendant cette image. Hors combat, rien ne change (credits, roulette d'Hyper).
+INT32 nHsfaProvoc = 0;
+static INT32 nHsfaProvocForce = -2;
+static UINT8 nProvocAttente[2] = { 0, 0 }, nProvocPiece[2] = { 0, 0 };
+
+void HsfaProvocEntrees(UINT8 *pInp020)				// appele par CpsRwGetInp (cps_rw.cpp) a chaque image
+{
+	if (nHsfaProvocForce == -2) nHsfaProvocForce = getenv("HSFA_PROVOC") ? atoi(getenv("HSFA_PROVOC")) : -1;
+	nHsfaProvoc = (nHsfaProvocForce >= 0) ? (nHsfaProvocForce != 0) : ((HsfaFluxDip & 0x40) != 0);
+	const INT32 bCombat = nHsfaProvoc && RamW(0xFF8000) == 2 && RamW(0xFF8004) == 4;
+	for (INT32 j = 0; j < 2; j++) {
+		const UINT8 p = CpsInp020[4 + j] & 1;		// Piece du joueur j (Select de RetroPad)
+		nProvocAttente[j] = (bCombat && p && !nProvocPiece[j]) ? 1 : 0;
+		if (bCombat) *pInp020 &= ~(1 << (4 + j));	// en combat, Piece ne donne pas de credit
+		nProvocPiece[j] = p;
+	}
+}
+
 static void __fastcall HsfaRouletteWriteByte(UINT32 a, UINT8 d)
 {
 	a &= 0xFFFF;
-	if (a == 0x84D3 || a == 0x88D3) d = HsfaRoulette(a);
+	if (HsfaHyper && (a == 0x84D3 || a == 0x88D3)) d = HsfaRoulette(a);
+	if ((a == 0x8778 && nProvocAttente[0]) || (a == 0x8B78 && nProvocAttente[1])) d |= 0x80;	// (patch 0014)
 	CpsRamFF[a ^ 1] = d;
 }
 
 static void __fastcall HsfaRouletteWriteWord(UINT32 a, UINT16 d)
 {
 	a &= 0xFFFE;
-	if (a == 0x84D2 || a == 0x88D2) d = (d & 0xFF00) | HsfaRoulette(a);
+	if (HsfaHyper && (a == 0x84D2 || a == 0x88D2)) d = (d & 0xFF00) | HsfaRoulette(a);
+	if ((a == 0x8778 && nProvocAttente[0]) || (a == 0x8B78 && nProvocAttente[1])) d |= 0x8000;	// (patch 0014)
 	WrW(CpsRamFF + a, d);
 }
 
@@ -1459,11 +1484,13 @@ INT32 HsfaInit()
 	}
 	// sorties Phoenix ($FFFFF0) : seule la derniere page de RAM passe par le gestionnaire (vitesse)
 	SekMapMemory(CpsRamFF, 0xFF0000, 0xFFFBFF, MAP_WRITE);
+	// joueurs ($FF8400-$FF8BFF) : roulette d'Hyper (patch 0007) et provocation sur Piece (patch 0014, tous les pilotes)
+	nProvocAttente[0] = nProvocAttente[1] = 0;
+	SekMapHandler(7, 0xFF8400, 0xFF8BFF, MAP_WRITE);
+	SekSetWriteByteHandler(7, HsfaRouletteWriteByte);
+	SekSetWriteWordHandler(7, HsfaRouletteWriteWord);
 	if (HsfaHyper) {
 		nHsfaNoroul = getenv("HSFA_NOROUL") && atoi(getenv("HSFA_NOROUL")) == 1;
-		SekMapHandler(7, 0xFF8400, 0xFF8BFF, MAP_WRITE);
-		SekSetWriteByteHandler(7, HsfaRouletteWriteByte);
-		SekSetWriteWordHandler(7, HsfaRouletteWriteWord);
 		if (nHsfaNoroul) bprintf(0, _T("HSFA : HSFA_NOROUL (essais) : $FF84D3 / $FF88D3 ecrits a 0\n"));
 		else bprintf(0, _T("HSFA : roulette de la selection sur la touche Piece (Start garde pour EX / S-ISM)\n"));
 	}
