From 10477486bb3546c870dbe7379fbe1a8b855a8639 Mon Sep 17 00:00:00 2001
From: Rickow <30348240+Rickow@users.noreply.github.com>
Date: Sun, 1 Nov 2026 20:40:52 +0100
Subject: [PATCH 19/21] HSFA: core option "Skip idle loops": exact skip of the
 68000 frame-wait loop (off by default)

The translated games wait for the next frame in MOVE.W $663888.L,D5 / CMP.W D6,D5 /
BEQ.W (back), at $000BF8 in all five drivers (26-40 % of the 68000 instructions).
$663888 only changes in the frame interrupt, and FBNeo raises 68000 interrupts
between SekRun slices only: once the MOVE reads a value equal to D6, the loop spins
until the end of the slice. The read of $663888 goes through a read handler (page
$663800-$663BFF; writes and opcode fetches unchanged) which removes from the
remaining cycle count the whole 30-cycle turns before the last one: the slice ends
on the same cycle, PC, registers and flags as without the skip.

The loop is found by signature in the program ROM (one site expected, otherwise
nothing is done). Option: bit 3 of Dip A, off by default; HSFA_IDLE=0/1 forces it
for tests, HSFA_IDLE_STATS=1 logs the removed turns every 600 frames.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/burn/drv/capcom/cps_hsfa.cpp | 98 ++++++++++++++++++++++++++++++++
 src/burn/drv/capcom/d_cps2.cpp   |  9 +++
 2 files changed, 107 insertions(+)

diff --git a/src/burn/drv/capcom/cps_hsfa.cpp b/src/burn/drv/capcom/cps_hsfa.cpp
index 183daea..7f78229 100644
--- a/src/burn/drv/capcom/cps_hsfa.cpp
+++ b/src/burn/drv/capcom/cps_hsfa.cpp
@@ -700,6 +700,8 @@ static void HsfaOptions()
 // --------------------------------------------------------------------------------------------------------------
 // Image, remise a zero, etats
 
+static void HsfaIdleStats();
+
 void HsfaFrameDone()
 {
 	if (!HsfaMode) return;
@@ -721,6 +723,7 @@ void HsfaFrameDone()
 
 	static INT32 bStats = -1;
 	if (bStats < 0) bStats = getenv("HSFA_STATS") ? 1 : 0;
+	HsfaIdleStats();									// (patch 0019)
 	if (bStats && (nImage % 600) == 0) {
 		bprintf(0, _T("HSFA image %d : listes %u, tuiles %u, retirees %u, tronquees %u, fichier4 %d\n"), nImage, nStatListes, nStatTuiles, nStatRetires, nStatTronques, nFichier4);
 	}
@@ -770,6 +773,100 @@ static void HsfaSang()
 	else bprintf(0, _T("HSFA : sang %s (REGULATION %d, $%06X et $%06X)\n"), nImm ? _T("blanc (censure)") : _T("rouge"), nImm, nSite[0], nSite[1]);
 }
 
+// --------------------------------------------------------------------------------------------------------------
+// (patch 0019) saut EXACT de la boucle d'attente d'image du 68000 (vitesse : Raspberry Pi 3...). Le noyau des jeux
+// traduits attend l'image suivante dans
+//     MOVE.W $663888.L,D5 ; CMP.W D6,D5 ; BEQ.W (retour au MOVE)       3A39 0066 3888 BA46 6700 FFF6
+// ($000BF8 dans les 5 jeux, 26 a 40 % des instructions du 68000). Le mot $663888 n'est change que par l'interruption
+// d'image, et FBNeo ne pose les interruptions du 68000 qu'entre deux tranches SekRun : quand le MOVE lit une valeur
+// egale a D6, la boucle tourne jusqu'a la fin de la tranche. La lecture de $663888 par ce MOVE passe ici (page
+// $663800-$663BFF lue par gestionnaire, ecritures et lecture d'instructions inchangees) : on retire au compte de
+// cycles restant les tours entiers (16 + 4 + 10 = 30 cycles de Musashi) qui precedent le dernier. Le 68000 finit donc
+// la tranche au meme cycle, au meme PC, avec les memes registres et drapeaux : seules disparaissent des lectures
+// sans effet de $663888. Site cherche par signature dans la ROM programme (1 attendu, sinon rien n'est fait).
+// Option : bit 3 du Dip A ("Skip idle loops", desactivee par defaut), lue a chaque passage (changement immediat) ;
+// HSFA_IDLE=0/1 (essais) l'impose ; HSFA_IDLE_STATS=1 : tours retires, au journal toutes les 600 images.
+extern UINT8 *CpsRam660;
+static UINT32 nIdle68kPC = 0;						// adresse du MOVE.W $663888.L,D5 (0 = pas de site)
+static INT32 nIdleForce = -2;
+static INT32 bIdleStats = 0;
+static UINT64 nIdleTours68k = 0, nIdleSauts68k = 0;
+#define HSFA_IDLE_ADR		0x663888
+#define HSFA_IDLE_TOUR68K	30							// MOVE.W abs.L,Dn 16 + CMP.W Dn,Dn 4 + Bcc.W pris 10
+
+static inline INT32 HsfaIdleActif()
+{
+	return (nIdleForce >= 0) ? (nIdleForce != 0) : ((HsfaFluxDip & 0x08) != 0);
+}
+
+static UINT8 __fastcall HsfaIdleReadByte(UINT32 a)
+{
+	return CpsRam660[(a & 0x3FFF) ^ 1];
+}
+
+static UINT16 __fastcall HsfaIdleReadWord(UINT32 a)
+{
+	const UINT16 d = RdW(CpsRam660 + (a & 0x3FFE));
+#ifdef EMU_M68K
+	if (a == HSFA_IDLE_ADR && nIdle68kPC && HsfaIdleActif()
+	    && m68k_get_reg(NULL, M68K_REG_PPC) == nIdle68kPC && d == (UINT16)m68k_get_reg(NULL, M68K_REG_D6)) {
+		// cycles restants AVANT le decompte de ce MOVE (Musashi decompte apres l'instruction) : les tours suivants
+		// coutent HSFA_IDLE_TOUR68K chacun ; la tranche s'arrete au 1er decompte qui atteint 0. Retirer k tours avec
+		// 30k < r laisse ce point d'arret, a 3k instructions pres, dans le dernier tour.
+		const INT32 r = m68k_cycles_remaining();
+		if (r > HSFA_IDLE_TOUR68K) {
+			const INT32 k = (r - 1) / HSFA_IDLE_TOUR68K;
+			m68k_cycles_remaining_set(r - k * HSFA_IDLE_TOUR68K);
+			nIdleTours68k += k; nIdleSauts68k++;
+		}
+	}
+#endif
+	return d;
+}
+
+static void HsfaIdleStats()
+{
+	if (bIdleStats && (nImage % 600) == 0) {
+		bprintf(0, _T("HSFA image %d : saut d'attente 68000 : %llu tours retires en %llu sauts\n"), nImage, (unsigned long long)nIdleTours68k, (unsigned long long)nIdleSauts68k);
+	}
+}
+
+static void HsfaIdleInit()
+{
+	nIdle68kPC = 0;
+	if (nIdleForce == -2) nIdleForce = getenv("HSFA_IDLE") ? atoi(getenv("HSFA_IDLE")) : -1;
+	bIdleStats = getenv("HSFA_IDLE_STATS") && atoi(getenv("HSFA_IDLE_STATS")) == 1;
+	nIdleTours68k = nIdleSauts68k = 0;
+	if (CpsRom == NULL || CpsRam660 == NULL) return;
+	static const UINT16 sig[6] = { 0x3A39, 0x0066, 0x3888, 0xBA46, 0x6700, 0xFFF6 };
+	UINT32 nSite = 0;
+	INT32 n = 0;
+	for (UINT32 a = 0; a + 12 <= nCpsRomLen; a += 2) {
+		INT32 i = 0;
+		while (i < 6 && RdW(CpsRom + a + 2 * i) == sig[i]) i++;
+		if (i < 6) continue;
+		// les opcodes sont lus dans CpsCode (cle phoenix) : la signature doit y etre aussi
+		if (CpsCode && CpsCode != CpsRom) {
+			if (a + 12 > nCpsCodeLen) continue;
+			for (i = 0; i < 6 && RdW(CpsCode + a + 2 * i) == sig[i]; i++) {}
+			if (i < 6) continue;
+		}
+		nSite = a; n++;
+	}
+#ifndef EMU_M68K
+	n = -1;
+#endif
+	if (n != 1) {
+		bprintf(PRINT_ERROR, _T("HSFA : saut d'attente : boucle du 68000 trouvee %d fois (attendu 1) : inactif\n"), n);
+		return;
+	}
+	nIdle68kPC = nSite;
+	SekMapHandler(8, HSFA_IDLE_ADR & ~0x3FF, (HSFA_IDLE_ADR & ~0x3FF) + 0x3FF, MAP_READ);
+	SekSetReadByteHandler(8, HsfaIdleReadByte);
+	SekSetReadWordHandler(8, HsfaIdleReadWord);
+	bprintf(0, _T("HSFA : saut d'attente du 68000 possible (boucle $%06X) : %s\n"), nSite, HsfaIdleActif() ? _T("actif") : _T("inactif (option)"));
+}
+
 static INT32 HsfaReset()
 {
 	HsfaSang();										// (patch 0018) au chargement et a chaque remise a zero
@@ -1560,6 +1657,7 @@ INT32 HsfaInit()
 		if (nHsfaNoroul) bprintf(0, _T("HSFA : HSFA_NOROUL (essais) : roulette de la selection toujours a 0\n"));
 		else bprintf(0, _T("HSFA : roulette de la selection sur la touche Piece (Start garde pour EX / S-ISM)\n"));
 	}
+	HsfaIdleInit();								// (patch 0019) apres les autres projections
 	SekClose();
 
 	HsfaFluxInit();
diff --git a/src/burn/drv/capcom/d_cps2.cpp b/src/burn/drv/capcom/d_cps2.cpp
index 94d4e1d..082652b 100644
--- a/src/burn/drv/capcom/d_cps2.cpp
+++ b/src/burn/drv/capcom/d_cps2.cpp
@@ -190,6 +190,13 @@ STDINPUTINFO(Hsfa)
 	{0x00, 0x01, 0x04, 0x00, "Red (uncensored)"					}, \
 	{0x00, 0x01, 0x04, 0x04, "White (censored)"					},
 
+// (patch 0019) bit 3 du Dip A : saut exact de la boucle d'attente d'image du 68000 (cps_hsfa.cpp, HsfaIdleInit) ;
+// meme image et meme son, moins de calcul pour l'hote. Desactive par defaut.
+#define HSFA_OPT_ATTENTE \
+	{0   , 0xfe, 0   ,    2, "Skip idle loops (faster)"			}, \
+	{0x00, 0x01, 0x08, 0x00, "Off"								}, \
+	{0x00, 0x01, 0x08, 0x08, "On"								},
+
 #define HSFA_OPT_OMBRES \
 	{0   , 0xfe, 0   ,    2, "Transparent shadows (PSP)"			}, \
 	{0x00, 0x01, 0x80, 0x00, "Off"								}, \
@@ -208,6 +215,7 @@ static struct BurnDIPInfo HsfaDIPList[] =
 	HSFA_OPT_OMBRES
 	HSFA_OPT_PROVOC
 	HSFA_OPT_SANG
+	HSFA_OPT_ATTENTE
 
 	HSFA_OPT_DEFAUTS
 	HSFA_OPT_JEU
@@ -234,6 +242,7 @@ static struct BurnDIPInfo HhsfaDIPList[] =
 	HSFA_OPT_OMBRES
 	HSFA_OPT_PROVOC
 	HSFA_OPT_SANG
+	HSFA_OPT_ATTENTE
 
 	// Hyper : un seul MAX ROUND sur PS2 (champ 1P, recopie dans le champ VS au debut du match) ; pas de JOIN IN
 	HSFA_OPT_DEFAUTS
