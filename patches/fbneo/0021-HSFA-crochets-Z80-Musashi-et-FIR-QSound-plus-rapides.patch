index 15b1b18..c438580 100644
--- a/src/cpu/z80/z80.cpp
+++ b/src/cpu/z80/z80.cpp
@@ -128,17 +128,17 @@ static Z80ReadOpArgHandler Z80CPUReadOpArg;
 #define BUSY_LOOP_HACKS     0
 
 // SpecZ80
-static void eat_cycles(int type, int cycles);
+static void eat_cycles_full(int type, int cycles);
 static void capture_opcode_history_start(UINT16 reg_bc, UINT16 reg_ir);
 static void capture_opcode_history_finish();
 static void parse_script(const char *script_desc, CM_SCRIPT_BREAKDOWN *breakdown);
 static bool find_script();
-static UINT8 run_script();
+static UINT8 run_script_full();
 static int  get_ula_delay();
 static void make_ula_delay_lut();
 static int  get_memory_access_delay(UINT16 pc_address);
 static int  get_memory_is_contended(UINT16 pc_address);
-static UINT8 store_rwinfo(UINT16 addr, UINT8 val, UINT16 flags, const char *dbg);
+static UINT8 store_rwinfo_full(UINT16 addr, UINT8 val, UINT16 flags, const char *dbg);
 
 static int		m_ula_variant;			// ULA_VARIANT_SINCLAIR  | ULA_VARIANT_AMSTRAD
 static const char*	m_ula_delay_sequence;		// "654321200"           | "10765432"
@@ -223,6 +223,35 @@ static int Z80lastop; // for snow effect
 #define HALT Z80.halt
 
 static Z80_Regs Z80;
+
+// (HSFA, patch 0021) chemin rapide des crochets de contention (ZX Spectrum) quand elle est coupee (tous les autres
+// pilotes) : memes effets que les fonctions completes dans ce cas, sans appel de fonction par acces ni par instruction
+// (store_rwinfo_full rend 0 et run_script_full 0xff sans rien faire ; eat_cycles_full appelle deux fois le rappel de
+// trame factice a chaque instruction, puisque m_cycles_per_frame vaut 0, et en retire 0).
+static void raster_dummy_callback(int);
+
+static inline UINT8 store_rwinfo(UINT16 addr, UINT8 val, UINT16 flags, const char *dbg)
+{
+	if (m_ula_variant == ULA_VARIANT_NONE) return 0;
+	return store_rwinfo_full(addr, val, flags, dbg);
+}
+
+static inline UINT8 run_script()
+{
+	if (m_ula_variant == ULA_VARIANT_NONE) return 0xff;
+	return run_script_full();
+}
+
+static inline void eat_cycles(int type, int cycles)
+{
+	if (m_ula_variant == ULA_VARIANT_NONE && m_cycles_per_frame == 0 && m_raster_cb == raster_dummy_callback) {
+		if (type == CYCLES_UNCONTENDED) m_opcode_history.uncontended_cycles_eaten += cycles;
+		Z80.ICount -= cycles;
+		m_tstate_counter += cycles;
+		return;
+	}
+	eat_cycles_full(type, cycles);
+}
 #define EA Z80.EA
 
 void (*z80edfe_callback)(Z80_Regs *Regs) = NULL;
@@ -4551,7 +4580,7 @@ static bool find_script()
 }
 
 
-static UINT8 run_script()
+static UINT8 run_script_full()
 {
 	UINT8 retval = 0xff;
 
@@ -5040,7 +5069,7 @@ static int get_memory_is_contended(UINT16 pc_address)
 	return 0;
 }
 
-static void eat_cycles(int type, int cycles)
+static void eat_cycles_full(int type, int cycles)
 {
 	// When this function is called and type CYCLES_CONTENDED or CYCLES_UNCONTENDED is set,
 	// it means the run_script function is processing the opcode history and that cycles are
@@ -5084,7 +5113,7 @@ static void eat_cycles(int type, int cycles)
 }
 
 
-static UINT8 store_rwinfo(UINT16 addr, UINT8 val, UINT16 flags, const char *dbg)
+static UINT8 store_rwinfo_full(UINT16 addr, UINT8 val, UINT16 flags, const char *dbg)
 {
 	RWINFO *rw;
 	UINT8 retval = 0xff;
