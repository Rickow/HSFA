+#ifdef HSFA_WS
+// (HSFA, patch 0022) fond des bandes du 16:9 pour scroll2 (meme regle que WsScrFond de cps_scr.cpp) ; avec le
+// defilement par ligne, les tuiles x = 0.. sont posees a (x << 4) + Rows[ligne] : le bord est cherche sur la ligne du
+// milieu de la rangee, et le miroir, pose avec les memes decalages de ligne, reste exact ligne par ligne.
+#define WS_MAXT2 144
+static void WsScr2Fond(INT32 y, struct CpsrLineInfo *pli)
+{
+	INT32 sx, ix, xMin, xMax, xs;
+	INT32 bRows = (pli->nWidth != 0);
+	UINT8 Vide[WS_MAXT2];
+	const INT32 sy = 16 - (nCpsrScrY & 15), iy = (nCpsrScrY >> 4) + 1;
+	if (bRows) {
+		ix = pli->nTileStart; sx = 0;
+		xMin = -1; xMax = pli->nTileEnd - pli->nTileStart;
+		const INT32 r = pli->Rows[8];
+		xs = (nHsfaWsPasse & 1) ? HsfaWsDivB(nCpsScreenWidth - r, 16) : HsfaWsDivB(-1 - r, 16);
+	} else {
+		sx = pli->nStart;
+		ix = (sx >> 4) + 1; sx &= 15; sx = 16 - sx;
+		xMin = -1; xMax = nXTiles - 1;
+		xs = (nHsfaWsPasse & 1) ? HsfaWsDivB(nCpsScreenWidth - sx, 16) : HsfaWsDivB(-1 - sx, 16);
+	}
+	if (xMax - xMin + 1 > WS_MAXT2) return;
+	if (nHsfaWsPasse == 3 || nHsfaWsPasse == 4) {						// couverture : rangee entierement opaque ?
+		INT32 bOpaque = 1;
+		for (INT32 x = xMin; x <= xMax && bOpaque; x++) {
+			UINT16 *pst = FindTile(ix + x, iy + y);
+			bOpaque = HsfaWsEtat(((UINT32)BURN_ENDIAN_SWAP_INT16(pst[0]) << 7) + nCpsGfxScroll[2], 16) == 2;
+		}
+		HsfaWsRangee(sy + (y << 4), 16, bOpaque);
+		return;
+	}
+	if (HsfaWsRangee(sy + (y << 4), 16, 0)) return;					// lignes deja couvertes
+	for (INT32 x = xMin; x <= xMax; x++) {
+		UINT16 *pst = FindTile(ix + x, iy + y);
+		Vide[x - xMin] = HsfaWsVide(((UINT32)BURN_ENDIAN_SWAP_INT16(pst[0]) << 7) + nCpsGfxScroll[2], 16);
+	}
+	const INT32 wb = HsfaWsBord(Vide, xMin, xMax, xs);
+	if (wb == HSFA_WS_AUCUN) return;
+	{	// derniere tuile du decor opaque (bord coupe : passe 1 / 2), sinon silhouette (passe de secours 5 / 6), voir cps_scr.cpp
+		UINT16 *pst = FindTile(ix + ((nHsfaWsPasse & 1) ? wb + 1 : wb - 1), iy + y);
+		const INT32 bCoupe = HsfaWsEtat(((UINT32)BURN_ENDIAN_SWAP_INT16(pst[0]) << 7) + nCpsGfxScroll[2], 16) == 2;
+		if (bCoupe == (nHsfaWsPasse >= 5)) return;
+	}
+	nCpstY = sy + (y << 4);
+	for (INT32 x = xMin; x <= xMax; x++) {
+		const INT32 s = HsfaWsSource(x, wb);
