+		if ((s >= xMin && s <= xMax) ? Vide[s - xMin] : HsfaWsVide(((UINT32)BURN_ENDIAN_SWAP_INT16(pst[0]) << 7) + nCpsGfxScroll[2], 16)) continue;
+		const INT32 a = BURN_ENDIAN_SWAP_INT16(pst[1]);
+		CpstSetPal(0x40 | (a & 0x1F));
+		nCpstX = bRows ? (x << 4) : sx + (x << 4);
+		nCpstTile = ((UINT32)BURN_ENDIAN_SWAP_INT16(pst[0]) << 7) + nCpsGfxScroll[2];
+		nCpstFlip = ((a >> 5) & 3) ^ ((nHsfaWsBords == 1) ? 0 : 1);
+		nCpstType = bRows ? (CTT_16X16 | CTT_ROWS | CTT_CARE) : (CTT_16X16 | CTT_CARE);
+		if (bRows) CpstRowShift = pli->Rows;
+		nCpstY = sy + (y << 4);
+		CpstOneDoX[2]();
+	}
+}
+#endif
