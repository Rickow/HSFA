+}
 
+#ifdef HSFA_WS
+// (HSFA, patch 0022) fond d'une bande du 16:9 : plans seuls (sans objets), colonnes [x0, x0 + w) de l'image, dessines
+// en place dans pBurnDraw. La largeur d'ecran et le decalage X des plans sont changes le temps du rendu : les
+// dessinateurs (cps_scr.cpp, cpsrd.cpp) coupent a [0, w) et, avec nHsfaWsPasse, ne posent que les tuiles en miroir
+// au-dela du bord du decor. w multiple de 32 (couverture des tuiles de 32 px), x0 >= 0.
+void HsfaWsPasse(INT32 nPasse, INT32 x0, INT32 w)
+{
+	UINT8 *pOld = pBurnDraw;
+	const INT32 nOldW = nCpsScreenWidth, nOldX = nCpsGlobalXOffset;
+	const UINT8 nOldL = nBurnLayer;
+	pBurnDraw += x0 * nBurnBpp; nCpsScreenWidth = w; nCpsGlobalXOffset -= x0; nBurnLayer &= ~1;
+	nHsfaWsPasse = nPasse; nHsfaWsX0 = x0;
 	CpsLayersDoX();
+	nHsfaWsPasse = 0; nHsfaWsX0 = 0;
+	pBurnDraw = pOld; nCpsScreenWidth = nOldW; nCpsGlobalXOffset = nOldX; nBurnLayer = nOldL;
 }
+#endif
 
 INT32 CpsDraw()
 {
diff --git a/src/burn/drv/capcom/cps_hsfa.cpp b/src/burn/drv/capcom/cps_hsfa.cpp
index 96a5aaa..bd7ad62 100644
--- a/src/burn/drv/capcom/cps_hsfa.cpp
+++ b/src/burn/drv/capcom/cps_hsfa.cpp
@@ -1722,6 +1722,9 @@ INT32 HsfaInit()
 
 INT32 HsfaExit()
 {
+#ifdef HSFA_WS
+	HsfaWsSortie();										// (patch 0022)
+#endif
 	Z80SetIdleLoop(-1, -1, 0, 0, NULL);					// (patch 0020)
 	if (HsfaPlansLog) fclose(HsfaPlansLog);
 	HsfaPlansLog = NULL; nPlansLog = -1;
@@ -1754,3 +1757,195 @@ INT32 HsfaExit()
 	nHsfaExtBase = 0xA00000; nHsfaExtLen = 0x500000;
 	return 0;
 }
+
+#ifdef HSFA_WS
+// --------------------------------------------------------------------------------------------------------------
+// (HSFA, patch 0022) bords du 16:9. Au-dela de la fenetre 4:3 (x < nCpsGlobalXOffset ou >= nCpsGlobalXOffset + 384),
+// le decor n'existe souvent pas (butees de camera, plans lents) et scroll1, anneau de 512 px recompose par le jeu autour
+// de la camera, montre des colonnes perimees. Option "Widescreen edges" (nHsfaWsBords) :
+//   0 miroir (defaut) : en combat, le fond des bandes est fait des plans (sans objets) prolonges en miroir au bord du
+//     decor, plan par plan et rangee de tuiles par rangee (cps_scr.cpp, cpsrd.cpp) ; l'image du jeu est dessinee
+//     par-dessus : le miroir ne se voit que la ou aucun plan ni objet n'est dessine ;
+//   1 repetition : la derniere tuile du decor est repetee ;
+//   2 noir : rien en fond (colonnes perimees de scroll1 retirees) ;
+//   3 brut : image du jeu telle quelle (comme l'ancien coeur 448 : noir et colonnes perimees).
+// Hors combat ($FF8000 = 2, $FF8004 = 4, $FF8008 = 6 faux : menus, carte, VS, citations, CONTINUE, fins, ecrans de
+// 384 px) : bandes noires, sauf en brut. Rien n'est fait pour les bandes que le format d'ecran rogne (nHsfaWsVisible).
+// L'interieur de la fenetre 4:3 n'est jamais touche (identique au pixel au coeur 4:3 dans tous les modes).
+INT32 nHsfaWsBords = 0;
+INT32 nHsfaWsVisible = 0;
+INT32 nHsfaWsPasse = 0;
+INT32 bHsfaWsS1Filtre = 0;							// scroll1 : colonnes perimees retirees dans les bandes
+INT32 nHsfaWsS1U = 0;								// defilement X de scroll1 deroule (meme repere que sx de Cps2Scr1Draw)
+INT32 nHsfaWsX0 = 0;								// pendant une passe de fond : 1re colonne de l'image dessinee
+static UINT8 WsCouvert[2][256];						// lignes de chaque bande couvertes par un plan opaque (passes 3 / 4)
+static INT32 bWsCombat = 0, bWsS1Init = 0, nWsS1Prec = 0, nWsE1 = 0, nWsBande = 0;
+static UINT32 nWsS1Base = 0;
+static INT32 WsS1Col[64];							// colonne de monde (deroulee) ecrite dans chaque colonne de l'anneau
+static UINT8 *WsS1Copie = NULL;						// copie de la tilemap scroll1 (detection des colonnes reecrites)
+
+// colonne de monde la plus proche du centre de la vue (biais vers le bord ou le jeu compose quand la camera bouge)
+static INT32 WsS1Monde(INT32 c, INT32 nU, INT32 nBiais)
+{
+	INT32 nCentre = nU + nCpsScreenWidth / 2 + nBiais - 4;
+	return c + 64 * HsfaWsDivB(nCentre - 8 * c + 256, 512);
+}
+
+static INT32 HsfaWsEnCombat()
+{
+	return RamW(0xFF8000) == 2 && RamW(0xFF8004) == 4 && RamW(0xFF8008) == 6;
+}
+
+// suivi de l'anneau scroll1 : chaque image, les 64 colonnes de la tilemap sont comparees a une copie ; une colonne
+// reecrite recoit la colonne de monde la plus proche du centre de la vue
+static void WsS1Suivi()
+{
+	if (WsS1Copie == NULL) { WsS1Copie = (UINT8*)BurnMalloc(0x4000); if (!WsS1Copie) return; }
+	UINT32 nOff = ((UINT32)RdW(CpsSaveReg[0] + 0x02) << 8) & 0xffc000;
+	UINT8 *Base = CpsFindGfxRam(nOff, 0x4000);
+	if (Base == NULL) { bWsS1Init = 0; return; }
+	INT32 sx = (INT32)RdW(CpsSaveReg[0] + 0x0c) + 0x40 - nCpsGlobalXOffset + CpsLayer1XOffs;
+	if (!bWsS1Init || nOff != nWsS1Base) {
+		nHsfaWsS1U = sx;
+		for (INT32 c = 0; c < 64; c++) WsS1Col[c] = WsS1Monde(c, nHsfaWsS1U, 0);
+		memcpy(WsS1Copie, Base, 0x4000);
+		nWsS1Base = nOff; bWsS1Init = 1;
+	} else {
+		INT32 d = (sx - nWsS1Prec) & 0x1ff;
+		if (d >= 0x100) d -= 0x200;
+		nHsfaWsS1U += d;
+		INT32 nBiais = (d > 0) ? 32 : (d < 0) ? -32 : 0;
+		for (INT32 c = 0; c < 64; c++) {
+			UINT8 *a = Base + (c << 7), *b = Base + 0x2000 + (c << 7);
+			if (memcmp(a, WsS1Copie + (c << 7), 128) || memcmp(b, WsS1Copie + 0x2000 + (c << 7), 128)) {
+				WsS1Col[c] = WsS1Monde(c, nHsfaWsS1U, nBiais);
+				memcpy(WsS1Copie + (c << 7), a, 128); memcpy(WsS1Copie + 0x2000 + (c << 7), b, 128);
+			}
+		}
+	}
+	nWsS1Prec = sx;
+	bHsfaWsS1Filtre = 1;
+}
+
+// appele apres l'effacement de l'image, avant les plans et les objets
+void HsfaWsAvantDessin()
+{
+	bHsfaWsS1Filtre = 0;
+	nWsE1 = nCpsGlobalXOffset; nWsBande = 0;
+	if (HsfaMode && nWsE1 > 0 && nHsfaWsBords != 3) {
+		INT32 v = (nHsfaWsVisible > 0 && nHsfaWsVisible < nCpsScreenWidth) ? nHsfaWsVisible : nCpsScreenWidth;
+		nWsBande = (v - 384) / 2;									// largeur montree de chaque bande
+		if (nWsBande > nWsE1) nWsBande = nWsE1;
+	}
+	bWsCombat = nWsBande > 0 && HsfaWsEnCombat();
+	if (!bWsCombat) { bWsS1Init = 0; return; }
+	WsS1Suivi();
+	if (nHsfaWsBords <= 1) {										// miroir / repetition : fond des deux bandes
+		INT32 w = (nWsBande + 31) & ~31;
+		if (w > (nWsE1 & ~31)) w = nWsE1 & ~31;
+		if (w > 0) {
+			memset(WsCouvert, 0, sizeof(WsCouvert));
+			HsfaWsPasse(3, nWsE1 - w, w);							// lignes deja couvertes par un plan opaque
+			HsfaWsPasse(4, nWsE1 + 384, w);
+			HsfaWsPasse(5, nWsE1 - w, w);							// secours : plans a bord en silhouette
+			HsfaWsPasse(6, nWsE1 + 384, w);
+			HsfaWsPasse(1, nWsE1 - w, w);							// fond en miroir des plans a bord coupe
+			HsfaWsPasse(2, nWsE1 + 384, w);
+		}
+	}
+}
+
+// appele apres les plans et les objets : hors combat, bandes noires (ecrans de 384 px)
+void HsfaWsApresDessin()
+{
+	if (nWsBande <= 0 || bWsCombat || pBurnDraw == NULL) return;
+	const INT32 nE2 = nWsE1 + 384, nD = nCpsScreenWidth - nE2;
+	for (INT32 y = 0; y < nCpsScreenHeight; y++) {
+		UINT8 *l = pBurnDraw + y * nBurnPitch;
+		memset(l, 0, nWsE1 * nBurnBpp);
+		if (nD > 0) memset(l + nE2 * nBurnBpp, 0, nD * nBurnBpp);
+	}
+}
+
+// scroll1 : tuile de la colonne de monde fxU, posee a l'ecran (image entiere) en [px, px + 8) ; 1 = a retirer
+// (perimee, dans une bande)
+INT32 HsfaWsS1Perime(INT32 fxU, INT32 px)
+{
+	if (px + 8 > nWsE1 && px < nWsE1 + 384) return 0;
+	return WsS1Col[fxU & 63] != fxU;
+}
+
+// etat d'une tuile : 1 = entierement transparente (ou hors des graphismes charges), 2 = entierement opaque, 0 = autre ;
+// nSize = 8, 16 ou 32. Les graphismes ne changent pas apres le chargement : petit cache direct par taille.
+#define WS_CACHE	4096
+static UINT32 *WsCacheTuile = NULL;					// [3][WS_CACHE] : adresse + 1 (0 = libre)
+static UINT8 *WsCacheEtat = NULL;
+static INT32 WsEtatCalcul(UINT32 nTile, INT32 nSize)
+{
+	if (nTile >= nCpsGfxLen) return 1;
+	const UINT8 *p = CpsGfx + nTile;
+	const INT32 nAdd = (nSize == 32) ? 16 : 8, nMots = (nSize == 8) ? 1 : (nSize >> 3);
+	UINT32 nOu = 0, nTrou = 0;
+	for (INT32 y = 0; y < nSize; y++, p += nAdd) {
+		for (INT32 i = 0; i < nMots; i++) {
+			const UINT32 w = ((const UINT32 *)p)[i];
+			nOu |= w;
+			nTrou |= (w - 0x11111111) & ~w & 0x88888888;			// un quartet nul (pixel transparent)
+		}
+	}
+	return (nOu == 0) ? 1 : (nTrou == 0) ? 2 : 0;
+}
+
+INT32 HsfaWsEtat(UINT32 nTile, INT32 nSize)
+{
+	nTile &= nCpsGfxMask;
+	if (WsCacheTuile == NULL) {
+		WsCacheTuile = (UINT32*)BurnMalloc(3 * WS_CACHE * sizeof(UINT32));
+		WsCacheEtat = (UINT8*)BurnMalloc(3 * WS_CACHE);
+		if (WsCacheTuile == NULL || WsCacheEtat == NULL) { BurnFree(WsCacheTuile); BurnFree(WsCacheEtat); WsCacheTuile = NULL; WsCacheEtat = NULL; return WsEtatCalcul(nTile, nSize); }
+		memset(WsCacheTuile, 0, 3 * WS_CACHE * sizeof(UINT32));
+	}
+	const INT32 k = (nSize == 8) ? 0 : (nSize == 16) ? 1 : 2;
+	const INT32 i = k * WS_CACHE + (((nTile >> (6 + k + (k == 2))) ^ (nTile >> 18)) & (WS_CACHE - 1));
+	if (WsCacheTuile[i] != nTile + 1) { WsCacheTuile[i] = nTile + 1; WsCacheEtat[i] = (UINT8)WsEtatCalcul(nTile, nSize); }
+	return WsCacheEtat[i];
+}
+
+// 1re colonne vide en partant de xs (colonne qui touche la fenetre 4:3) vers l'exterieur : vers la gauche pour les
+// passes impaires (bande gauche), vers la droite pour les paires ; pVide[x - xMin] pour xMin <= x <= xMax ;
+// HSFA_WS_AUCUN si aucune
+INT32 HsfaWsBord(const UINT8 *pVide, INT32 xMin, INT32 xMax, INT32 xs)
+{
+	if (xs < xMin) xs = xMin;
+	if (xs > xMax) xs = xMax;
+	if (nHsfaWsPasse & 1) { for (INT32 x = xs; x >= xMin; x--) if (pVide[x - xMin]) return x; }
+	else { for (INT32 x = xs; x <= xMax; x++) if (pVide[x - xMin]) return x; }
+	return HSFA_WS_AUCUN;
+}
+
+// rangee de tuiles posee aux lignes [y0, y0 + n) (bornees a la tranche et a l'ecran). Passe 3 / 4 : si bOpaque (toutes
+// les tuiles de la rangee qui touchent la bande sont opaques et dessinees par l'image), ses lignes sont couvertes.
+// Passe 1 / 2 : rend 1 si toutes ses lignes sont couvertes (le fond n'y serait pas vu : rien a dessiner).
+INT32 HsfaWsRangee(INT32 y0, INT32 n, INT32 bOpaque)
+{
+	INT32 a = y0, b = y0 + n;
+	if (a < nStartline) a = nStartline;
+	if (a < 0) a = 0;
+	if (b > nEndline) b = nEndline;
+	if (b > nCpsScreenHeight) b = nCpsScreenHeight;
+	if (b > 256) b = 256;
+	UINT8 *c = WsCouvert[(nHsfaWsPasse & 1) ? 0 : 1];
+	if (nHsfaWsPasse == 3 || nHsfaWsPasse == 4) {
+		if (bOpaque) for (INT32 y = a; y < b; y++) c[y] = 1;
+		return 1;
+	}
+	for (INT32 y = a; y < b; y++) if (!c[y]) return 0;
+	return 1;
+}
+
+void HsfaWsSortie()
+{
+	BurnFree(WsS1Copie); BurnFree(WsCacheTuile); BurnFree(WsCacheEtat);
+	WsS1Copie = NULL; WsCacheTuile = NULL; WsCacheEtat = NULL; bWsS1Init = 0; bHsfaWsS1Filtre = 0; bWsCombat = 0; nWsBande = 0;
+}
+#endif
diff --git a/src/burn/drv/capcom/cps_scr.cpp b/src/burn/drv/capcom/cps_scr.cpp
index 2f96179..d4fb35f 100644
--- a/src/burn/drv/capcom/cps_scr.cpp
+++ b/src/burn/drv/capcom/cps_scr.cpp
@@ -74,6 +74,89 @@ INT32 Cps1Scr1Draw(UINT8 *Base,INT32 sx,INT32 sy)
   return 0;
 }
 
+#ifdef HSFA_WS
+// (HSFA, patch 0022) fond des bandes du 16:9 (passes 1 / 2 de HsfaWsPasse, largeur d'ecran = bande) : par rangee de
+// tuiles, depuis la tuile qui touche la fenetre 4:3 et vers l'exterieur, la 1re colonne vide (tuile transparente, ou
+// colonne perimee de l'anneau scroll1) est le bord du decor du plan ; au-dela, chaque colonne recoit la tuile en miroir
+// de l'autre cote du bord (retournee en X ; option repetition : la derniere tuile du decor, non retournee).
+// La fenetre 4:3 (hors de [0, largeur)) n'est jamais touchee.
+#define WS_MAXT 72
+static inline UINT32 WsScr3Tuile(INT32 t)
+{
+	if (HsfaMode) t &= 0x3fff;
+	if (Xmcota && t >= 0x5800) t -= 0x4000;
+	else if (Ssf2t && t < 0x5600) t += 0x4000;
+	t <<= 9;
+	if (Cps2Turbo) t &= ~nCpsGfxScroll[3];
+	return t + nCpsGfxScroll[3];
+}
+
+static INT32 WsScrFond(UINT8 *Base, INT32 sx, INT32 sy, INT32 nTaille)
+{
+	const INT32 nLog = (nTaille == 8) ? 3 : 5, m = nTaille - 1;
+	const INT32 nXTile = nCpsScreenWidth >> nLog;
+	if (nXTile + 1 > WS_MAXT) return 1;
+	const INT32 bS1 = (nTaille == 8) && bHsfaWsS1Filtre;
+	const INT32 nIxU = (HsfaWsDivB(nHsfaWsS1U + nHsfaWsX0, 8)) + 1;	// scroll1 : colonne de monde de la tuile x = 0
+	INT32 ix = (sx >> nLog) + 1, iy = (sy >> nLog) + 1;
+	sx &= m; sx = nTaille - sx;
+	sy &= m;
+	const INT32 nLastY = (nEndline + sy) >> nLog, nFirstY = (nStartline + sy) >> nLog;
+	sy = nTaille - sy;
+	const INT32 xs = (nHsfaWsPasse & 1) ? HsfaWsDivB(nCpsScreenWidth - sx, nTaille) : HsfaWsDivB(-1 - sx, nTaille);
+	UINT8 Vide[WS_MAXT];
+
+	for (INT32 y = nFirstY - 1; y < nLastY; y++) {
+		const INT32 fy = iy + y;
+		#define WS_ENTREE(fx) ((UINT16 *)(Base + ((nTaille == 8) \
+			? ((((fy) & 0x20) << 8) | (((fx) & 0x3F) << 7) | (((fy) & 0x1F) << 2)) \
+			: ((((fy) & 0x38) << 8) | (((fx) & 0x3F) << 5) | (((fy) & 0x07) << 2))) ))
+		#define WS_TUILE(pst) ((nTaille == 8) ? (((UINT32)BURN_ENDIAN_SWAP_INT16((pst)[0]) << 6) + nCpsGfxScroll[1]) \
+			: WsScr3Tuile(BURN_ENDIAN_SWAP_INT16((pst)[0])))
+		const INT32 y0 = sy + (y << nLog);
+		if (nHsfaWsPasse == 3 || nHsfaWsPasse == 4) {				// couverture : rangee entierement opaque ?
+			INT32 bOpaque = 1;
+			for (INT32 x = -1; x < nXTile && bOpaque; x++) {
+				bOpaque = !(bS1 && HsfaWsS1Perime(nIxU + x, sx + (x << 3) + nHsfaWsX0)) && HsfaWsEtat(WS_TUILE(WS_ENTREE(ix + x)), nTaille) == 2;
+			}
+			HsfaWsRangee(y0, nTaille, bOpaque);
+			continue;
+		}
+		if (HsfaWsRangee(y0, nTaille, 0)) continue;					// lignes deja couvertes : le fond n'y serait pas vu
+		for (INT32 x = -1; x < nXTile; x++) {
+			Vide[x + 1] = (bS1 && HsfaWsS1Perime(nIxU + x, sx + (x << 3) + nHsfaWsX0)) || HsfaWsVide(WS_TUILE(WS_ENTREE(ix + x)), nTaille);
+		}
+		const INT32 wb = HsfaWsBord(Vide, -1, nXTile - 1, xs);
+		if (wb == HSFA_WS_AUCUN) continue;
+		{	// derniere tuile du decor (cote fenetre) opaque : bord coupe des donnees du decor, prolonge en passe 1 / 2 ; en
+			// partie transparente : silhouette (statue, arbre, lanterne), prolongee seulement en passe de secours 5 / 6,
+			// dessinee avant : elle ne se voit que la ou aucun bord coupe ne donne de decor
+			const INT32 d = (nHsfaWsPasse & 1) ? wb + 1 : wb - 1;
+			const INT32 bCoupe = !(bS1 && HsfaWsS1Perime(nIxU + d, sx + (d << 3) + nHsfaWsX0)) && HsfaWsEtat(WS_TUILE(WS_ENTREE(ix + d)), nTaille) == 2;
+			if (bCoupe == (nHsfaWsPasse >= 5)) continue;
+		}
+		for (INT32 x = -1; x < nXTile; x++) {
+			const INT32 s = HsfaWsSource(x, wb);
+			if (s == HSFA_WS_AUCUN) continue;
+			if ((s >= -1 && s < nXTile) ? Vide[s + 1] : (bS1 && HsfaWsS1Perime(nIxU + s, sx + (s << 3) + nHsfaWsX0))) continue;
+			UINT16 *pst = WS_ENTREE(ix + s);
+			if (!(s >= -1 && s < nXTile) && HsfaWsVide(WS_TUILE(pst), nTaille)) continue;	// source vide : rien a poser
+			const INT32 a = BURN_ENDIAN_SWAP_INT16(pst[1]);
+			CpstSetPal(((nTaille == 8) ? 0x20 : 0x60) | (a & 0x1F));
+			nCpstX = sx + (x << nLog);
+			nCpstY = y0;
+			nCpstTile = WS_TUILE(pst);
+			nCpstFlip = ((a >> 5) & 3) ^ ((nHsfaWsBords == 1) ? 0 : 1);
+			nCpstType = ((nTaille == 8) ? CTT_8X8 : CTT_32X32) | CTT_CARE;
+			CpstOneDoX[2]();
+		}
+		#undef WS_ENTREE
+		#undef WS_TUILE
+	}
+	return 0;
+}
+#endif
