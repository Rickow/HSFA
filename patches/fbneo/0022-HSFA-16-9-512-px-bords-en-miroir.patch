 	CpsObjDrawInit();
 
 	INT32 nSlice = 0;
@@ -503,9 +506,33 @@ static void DoDraw(INT32 Recalc)
 	if (Recalc || bCpsUpdatePalEveryFrame) CpsPalUpdate(CpsSavePal);		// recalc whole palette if needed
 
 	CpsClearScreen();
