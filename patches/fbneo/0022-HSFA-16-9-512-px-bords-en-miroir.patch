+++ b/src/burn/drv/capcom/cps.h
@@ -565,6 +565,33 @@ static inline INT32 HsfaEstOmbre(UINT32 t)				// (patch 0011) code global d'une
 	return t == 0x0284A || (t >= 0x305DF && t <= 0x30613) || (t >= 0x50888 && t <= 0x5088A);
 }
 void HsfaPortWriteWordEnd();
+#ifdef HSFA_WS
+// (HSFA, patch 0022) bords du 16:9 (cps_hsfa.cpp) : fond des bandes hors de la fenetre 4:3 en combat
+extern INT32 nHsfaWsBords;								// option "Widescreen edges" : 0 miroir, 1 repetition, 2 noir, 3 brut
+extern INT32 nHsfaWsVisible;							// largeur montree (option "Screen format"), 0 = toute l'image
+extern INT32 nHsfaWsPasse;								// 0 = image ; 1 / 2 = fond de la bande gauche / droite ;
+														// 3 / 4 = lignes couvertes par un plan opaque, gauche / droite ;
+														// 5 / 6 = fond de secours (plans a bord en silhouette)
+extern INT32 bHsfaWsS1Filtre, nHsfaWsS1U, nHsfaWsX0;	// scroll1 : colonnes perimees de l'anneau retirees des bandes
+#define HSFA_WS_AUCUN	(-0x10000)
+void HsfaWsAvantDessin();
+void HsfaWsApresDessin();
+void HsfaWsSortie();
+void HsfaWsPasse(INT32 nPasse, INT32 x0, INT32 w);		// cps_draw.cpp
+INT32 HsfaWsS1Perime(INT32 fxU, INT32 px);
+INT32 HsfaWsEtat(UINT32 nTile, INT32 nSize);				// 1 = tuile transparente, 2 = opaque, 0 = autre
+static inline INT32 HsfaWsVide(UINT32 nTile, INT32 nSize) { return HsfaWsEtat(nTile, nSize) == 1; }
+INT32 HsfaWsBord(const UINT8 *pVide, INT32 xMin, INT32 xMax, INT32 xs);
+INT32 HsfaWsRangee(INT32 y0, INT32 n, INT32 bOpaque);
+static inline INT32 HsfaWsDivB(INT32 a, INT32 b) { return (a >= 0) ? a / b : -((-a + b - 1) / b); }
+// colonne source (indice de boucle) de la colonne x du fond, wb = 1re colonne vide depuis la fenetre 4:3
+static inline INT32 HsfaWsSource(INT32 x, INT32 wb)
+{
+	if (nHsfaWsPasse & 1) { if (x > wb) return HSFA_WS_AUCUN; return (nHsfaWsBords == 1) ? wb + 1 : 2 * wb + 1 - x; }
+	if (x < wb) return HSFA_WS_AUCUN;
+	return (nHsfaWsBords == 1) ? wb - 1 : 2 * wb - 1 - x;
+}
+#endif
 
 extern INT32 Cps2Volume;
 extern UINT16 Cps2VolumeStates[40];
diff --git a/src/burn/drv/capcom/cps_draw.cpp b/src/burn/drv/capcom/cps_draw.cpp
