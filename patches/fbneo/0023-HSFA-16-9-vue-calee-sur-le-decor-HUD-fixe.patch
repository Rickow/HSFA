@@ -395,6 +395,9 @@ static UINT16 HsfaEclater(UINT32 nPage, UINT32 nFin, UINT32 nCourante)
 						// (patch 0010) bit 12 = objet marque (melange), garde avec la priorite
 						Out[n * 4 + 0] = (UINT16)((((x & 0x3ff) + 16 * nxs) & 0x3ff) | (x & 0xf000) | (((g >> 18) & 3) << 10));
 						Out[n * 4 + 1] = (UINT16)((((y & 0x3ff) + 16 * nys) & 0x3ff) | (((g >> 16) & 3) << 13));
+#ifdef HSFA_WS
+						if (((y >> 13) & 7) == 1) Out[n * 4 + 1] |= 0x1000;	// (patch 0023) emplacement 1 (graphismes systeme : HUD)
+#endif
 						Out[n * 4 + 2] = (UINT16)(g & 0xffff);
 						Out[n * 4 + 3] = (UINT16)(at & 0x00ff);
 						n++;
@@ -1781,6 +1784,17 @@ INT32 nHsfaWsX0 = 0;								// pendant une passe de fond : 1re colonne de l'imag
 static UINT8 WsCouvert[2][256];						// lignes de chaque bande couvertes par un plan opaque (passes 3 / 4)
 static INT32 bWsCombat = 0, bWsS1Init = 0, nWsS1Prec = 0, nWsE1 = 0, nWsBande = 0;
 static UINT32 nWsS1Base = 0;
+static INT32 nWsS1Track = 0;							// (patch 0023) suivi de l'anneau, repere de la fenetre centree
+// (patch 0023) colonnes de scroll1 jamais recomposees par le jeu (plan lent fixe dans l'anneau) : l'anneau de 512 px
+// contient aussi des colonnes que la borne ne montre a aucune position de camera (ex. SFA3 $00 : ciel de 461 px, 51 px
+// d'autres tuiles). Une colonne n'est montree dans les bandes que si le jeu l'a recomposee, si elle a deja ete vue dans
+// la fenetre 4:3, ou si elle est dans l'etendue que la fenetre parcourt sur toute la course de la camera (scroll1 X =
+// a + k x camera, k mesure des que la camera a bouge de 48 px, garde pour le decor $FF8100 ; plan a defilement
+// automatique : pas de restriction).
+static UINT8 WsS1Ok[64];
+static INT32 nWsBase = 0;							// nCpsGlobalXOffset du pilote (fenetre centree), retabli apres le dessin
+static INT32 nWsKDecor = -1, nWsK = 0, bWsK = 0, bWsAuto = 0, nWsKCam0 = 0, nWsKU0 = 0, nWsKCamPrec = 0, nWsAutoN = 0;
+static INT32 nWsExtG = 0, nWsExtD = 0, bWsExt = 0, nWsS1D = 0;	// etendue parcourue (repere deroule du suivi) quand k est connu
 static INT32 WsS1Col[64];							// colonne de monde (deroulee) ecrite dans chaque colonne de l'anneau
 static UINT8 *WsS1Copie = NULL;						// copie de la tilemap scroll1 (detection des colonnes reecrites)
 
@@ -1804,34 +1818,86 @@ static void WsS1Suivi()
 	UINT32 nOff = ((UINT32)RdW(CpsSaveReg[0] + 0x02) << 8) & 0xffc000;
 	UINT8 *Base = CpsFindGfxRam(nOff, 0x4000);
 	if (Base == NULL) { bWsS1Init = 0; return; }
-	INT32 sx = (INT32)RdW(CpsSaveReg[0] + 0x0c) + 0x40 - nCpsGlobalXOffset + CpsLayer1XOffs;
+	INT32 sx = (INT32)RdW(CpsSaveReg[0] + 0x0c) + 0x40 - nCpsGlobalXOffset + CpsLayer1XOffs;	// fenetre centree
 	if (!bWsS1Init || nOff != nWsS1Base) {
-		nHsfaWsS1U = sx;
-		for (INT32 c = 0; c < 64; c++) WsS1Col[c] = WsS1Monde(c, nHsfaWsS1U, 0);
+		nWsS1Track = sx;
+		for (INT32 c = 0; c < 64; c++) WsS1Col[c] = WsS1Monde(c, nWsS1Track, 0);
+		memset(WsS1Ok, 0, sizeof(WsS1Ok)); nWsS1D = 0;
+		nWsKCam0 = nWsKCamPrec = (INT16)RdW(CpsSaveReg[0] + 0x10); nWsKU0 = sx; nWsAutoN = 0;
 		memcpy(WsS1Copie, Base, 0x4000);
 		nWsS1Base = nOff; bWsS1Init = 1;
 	} else {
 		INT32 d = (sx - nWsS1Prec) & 0x1ff;
 		if (d >= 0x100) d -= 0x200;
-		nHsfaWsS1U += d;
+		nWsS1Track += d; nWsS1D = d;
 		INT32 nBiais = (d > 0) ? 32 : (d < 0) ? -32 : 0;
 		for (INT32 c = 0; c < 64; c++) {
 			UINT8 *a = Base + (c << 7), *b = Base + 0x2000 + (c << 7);
 			if (memcmp(a, WsS1Copie + (c << 7), 128) || memcmp(b, WsS1Copie + 0x2000 + (c << 7), 128)) {
-				WsS1Col[c] = WsS1Monde(c, nHsfaWsS1U, nBiais);
+				WsS1Col[c] = WsS1Monde(c, nWsS1Track, nBiais); WsS1Ok[c] = 1;
 				memcpy(WsS1Copie + (c << 7), a, 128); memcpy(WsS1Copie + 0x2000 + (c << 7), b, 128);
 			}
 		}
 	}
 	nWsS1Prec = sx;
+	{	// (patch 0023) colonnes vues dans la fenetre 4:3 ; pente k de scroll1 par rapport a la camera ; etendue parcourue
+		const INT32 nCam = (INT16)RdW(CpsSaveReg[0] + 0x10), Pw = nWsS1Track + nWsBase;
+		for (INT32 w = HsfaWsDivB(Pw, 8); w <= HsfaWsDivB(Pw + 383, 8); w++) if (WsS1Col[w & 63] == w) WsS1Ok[w & 63] = 1;
+		const INT32 nDecor = RamW(0xFF8100) | (nOff & 0xffff0000);
+		if (nDecor != nWsKDecor) { nWsKDecor = nDecor; bWsK = 0; bWsAuto = 0; nWsKCam0 = nCam; nWsKU0 = nWsS1Track; nWsAutoN = 0; }
+		if (nCam == nWsKCamPrec && nWsS1D != 0 && ++nWsAutoN >= 8) bWsAuto = 1;		// scroll1 bouge seul : automatique
+		nWsKCamPrec = nCam;
+		if (!bWsAuto) {
+			if (nCam - nWsKCam0 >= 48 || nCam - nWsKCam0 <= -48) {
+				nWsK = (INT32)(((INT64)(nWsS1Track - nWsKU0) << 16) / (nCam - nWsKCam0)); bWsK = 1;
+			}
+		}
+		bWsExt = bWsK && !bWsAuto;
+		if (bWsExt) {
+			nWsExtG = Pw - (INT32)(((INT64)nWsK * nCam) >> 16);
+			nWsExtD = Pw + 384 + (INT32)(((INT64)nWsK * (0x180 - nCam)) >> 16);
+		}
+	}
+	nHsfaWsS1U = nWsS1Track;							// repere de dessin (fenetre centree)
 	bHsfaWsS1Filtre = 1;
 }
 
+// --------------------------------------------------------------------------------------------------------------
+// (HSFA, patch 0023) vue calee sur le decor (option "Widescreen edges" = "Stage-locked view", par defaut ; nHsfaWsCale).
+// Le jeu est inchange (logique, camera, memoire) ; en combat, la fenetre de jeu 4:3 n'est plus toujours au centre de
+// l'image : pres d'un bout de l'arene, elle glisse vers ce bout (jusqu'a toute la marge) et l'image reste sur le decor
+// peint. La camera (scroll2 X, butees 0 et $180 dans tous les decors des 5 jeux) donne sa position x = o + sv : marge
+// montree m de chaque cote, sv = m au milieu de la course, sv = camera pres de la butee gauche (camera < m),
+// sv = camera - $180 + 2m pres de la butee droite ; sv suit la camera, sans saut tant que la camera n'en fait pas.
+// Plans et objets de la scene (persos, ombres, effets, objets de decor) sont deplaces ensemble (nCpsGlobalXOffset =
+// position le temps du dessin, nHsfaWsObjDx pour les objets) ; le HUD (objets de graphismes systeme, HsfaWsHud : barres,
+// chrono, portraits, noms, jauges, textes) reste a sa place, fenetre 4:3 au centre. Sans le HUD, la fenetre 4:3 est
+// identique au pixel a celle du coeur 4:3, seule sa position change. Ce qui reste sans decor (plans lents plus etroits
+// que l'image, colonnes de scroll1 perimees ou jamais montrees, rangees plus courtes) : miroir du patch 0022 dans les
+// bandes, de largeur quelconque (HSFA_WS_REPLI=black : noir, pour les essais). Hors combat : comme avant (centre).
+INT32 nHsfaWsCale = 1;
+INT32 nHsfaWsObjDx = 0;
+static INT32 nWsRepli = -1;
+
+// position de la fenetre 4:3 (vue calee) ; appele en combat seulement
+static void WsCale()
+{
+	const INT32 m = nWsBande, o = nWsBase - nWsBande;					// marge montree ; 1re colonne montree
+	const INT32 nCam = (INT16)RdW(CpsSaveReg[0] + 0x10);				// scroll2 X : 0 a $180 (butees)
+	INT32 sv = m;
+	if (nCam < m) sv = (nCam > 0) ? nCam : 0;
+	else if (nCam > 0x180 - m) sv = (nCam - 0x180 + 2 * m < 2 * m) ? nCam - 0x180 + 2 * m : 2 * m;
+	nWsE1 = o + sv; nCpsGlobalXOffset = nWsE1; nHsfaWsObjDx = nWsE1 - nWsBase;
+}
+
 // appele apres l'effacement de l'image, avant les plans et les objets
 void HsfaWsAvantDessin()
 {
 	bHsfaWsS1Filtre = 0;
-	nWsE1 = nCpsGlobalXOffset; nWsBande = 0;
+	nWsBase = nCpsGlobalXOffset;
+	nWsE1 = nWsBase; nWsBande = 0;
+	nHsfaWsObjDx = 0;
+	if (nWsRepli < 0) { const char *e = getenv("HSFA_WS_REPLI"); nWsRepli = (e && strcmp(e, "black") == 0) ? 1 : 0; }
 	if (HsfaMode && nWsE1 > 0 && nHsfaWsBords != 3) {
 		INT32 v = (nHsfaWsVisible > 0 && nHsfaWsVisible < nCpsScreenWidth) ? nHsfaWsVisible : nCpsScreenWidth;
 		nWsBande = (v - 384) / 2;									// largeur montree de chaque bande
@@ -1840,6 +1906,20 @@ void HsfaWsAvantDessin()
 	bWsCombat = nWsBande > 0 && HsfaWsEnCombat();
 	if (!bWsCombat) { bWsS1Init = 0; return; }
 	WsS1Suivi();
+	if (nHsfaWsCale) {
+		WsCale();
+		nHsfaWsS1U += nWsBase - nWsE1;								// repere de dessin de scroll1 (fenetre deplacee)
+		if (nWsRepli) return;
+		const INT32 o = nWsBase - nWsBande, wg = nWsE1 - o, wd = o + 384 + 2 * nWsBande - (nWsE1 + 384);
+		memset(WsCouvert, 0, sizeof(WsCouvert));
+		if (wg > 0) HsfaWsPasse(3, o, wg);							// memes passes que le miroir, sur des bandes de
+		if (wd > 0) HsfaWsPasse(4, nWsE1 + 384, wd);				// largeur quelconque (0 a 2 x la marge)
+		if (wg > 0) HsfaWsPasse(5, o, wg);
+		if (wd > 0) HsfaWsPasse(6, nWsE1 + 384, wd);
+		if (wg > 0) HsfaWsPasse(1, o, wg);
+		if (wd > 0) HsfaWsPasse(2, nWsE1 + 384, wd);
+		return;
+	}
 	if (nHsfaWsBords <= 1) {										// miroir / repetition : fond des deux bandes
 		INT32 w = (nWsBande + 31) & ~31;
 		if (w > (nWsE1 & ~31)) w = nWsE1 & ~31;
@@ -1855,9 +1935,12 @@ void HsfaWsAvantDessin()
 	}
 }
 
-// appele apres les plans et les objets : hors combat, bandes noires (ecrans de 384 px)
+// appele apres les plans et les objets : hors combat, bandes noires (ecrans de 384 px) ; vue calee : fenetre remise au
+// centre pour la suite
 void HsfaWsApresDessin()
 {
+	if (nWsBande > 0) nCpsGlobalXOffset = nWsBase;				// (patch 0023) fenetre remise au centre
+	nHsfaWsObjDx = 0;
 	if (nWsBande <= 0 || bWsCombat || pBurnDraw == NULL) return;
 	const INT32 nE2 = nWsE1 + 384, nD = nCpsScreenWidth - nE2;
 	for (INT32 y = 0; y < nCpsScreenHeight; y++) {
@@ -1872,7 +1955,9 @@ void HsfaWsApresDessin()
 INT32 HsfaWsS1Perime(INT32 fxU, INT32 px)
 {
 	if (px + 8 > nWsE1 && px < nWsE1 + 384) return 0;
-	return WsS1Col[fxU & 63] != fxU;
+	if (WsS1Col[fxU & 63] != fxU) return 1;
+	if (WsS1Ok[fxU & 63] || bWsAuto) return 0;									// (patch 0023)
+	return !(bWsExt && 8 * fxU >= nWsExtG - 4 && 8 * fxU + 8 <= nWsExtD + 4);
 }
 
 // etat d'une tuile : 1 = entierement transparente (ou hors des graphismes charges), 2 = entierement opaque, 0 = autre ;
