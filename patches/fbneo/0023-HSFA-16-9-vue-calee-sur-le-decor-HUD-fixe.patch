diff --git a/src/burn/drv/capcom/cps.h b/src/burn/drv/capcom/cps.h
index d897a1e..cdc4d49 100644
--- a/src/burn/drv/capcom/cps.h
+++ b/src/burn/drv/capcom/cps.h
@@ -573,6 +573,20 @@ extern INT32 nHsfaWsPasse;								// 0 = image ; 1 / 2 = fond de la bande gauche
 														// 3 / 4 = lignes couvertes par un plan opaque, gauche / droite ;
 														// 5 / 6 = fond de secours (plans a bord en silhouette)
 extern INT32 bHsfaWsS1Filtre, nHsfaWsS1U, nHsfaWsX0;	// scroll1 : colonnes perimees de l'anneau retirees des bandes
+// (HSFA, patch 0023) vue calee sur le decor : en combat, la fenetre 4:3 est posee a x = nCpsGlobalXOffset (0 a 2 x la
+// marge) le temps du dessin ; les objets de la scene (decalage X pris a la lecture de la liste) recoivent l'ecart
+// nHsfaWsObjDx, pas ceux du HUD
+extern INT32 nHsfaWsCale, nHsfaWsObjDx;
+// objet du HUD (barres, chrono, jauges, portraits, noms, textes GO! / combos / SUPER / K.O. / PERFECT...), releve sur
+// les 5 jeux (fixe a l'ecran quand la camera bouge) : SFA3, graphismes systeme (codes $16000-$19FFF) ; Upper, Upper MAX,
+// Hyper, greffe : objet de l'emplacement 1 (table plan2 : graphismes systeme), marque par HsfaEclater (bit 12 du mot Y,
+// libre apres la conversion) ; dans les 5 jeux, palette $1D, et palette $1E avec un code $02xxx, $3Exxx ou $3Fxxx (textes et bandeaux
+// d'annonce : K.O., PERFECT, ROUND n...)
+static inline INT32 HsfaWsHud(UINT32 n, INT32 nPal, UINT32 nY)
+{
+	if ((HsfaMode == 1) ? (n - 0x16000 < 0x4000) : ((nY & 0x1000) != 0)) return 1;
+	return nPal == 0x1D || (nPal == 0x1E && ((n >> 12) == 0x02 || (n >> 13) == 0x1F));
+}
 #define HSFA_WS_AUCUN	(-0x10000)
 void HsfaWsAvantDessin();
 void HsfaWsApresDessin();
