index e063094..887427e 100644
--- a/src/burn/drv/capcom/cps_obj.cpp
+++ b/src/burn/drv/capcom/cps_obj.cpp
@@ -435,6 +435,16 @@ INT32 Cps2ObjDraw(INT32 nLevelFrom, INT32 nLevelTo)
 		if (HsfaMode == 2) {
 			n |= (BURN_ENDIAN_SWAP_INT16(ps[0]) & 0x0c00) << 8;	// HSFA : bits 18-19 du code = bits 10-11 de X
 		}
+#ifdef HSFA_WS
+		if (nHsfaWsObjDx && !HsfaWsHud(n, a & 0x1F, BURN_ENDIAN_SWAP_INT16(ps[1]))) {
+			// (HSFA, patch 0023) vue calee : la scene (persos, effets, objets de decor) suit la fenetre de jeu deplacee de
+			// nHsfaWsObjDx ; le HUD reste a sa place (fenetre 4:3 au centre). X sur 10 bits relu dans [-256, 768) de l'ecran
+			// (objets de 256 px au plus) au lieu de [-512, 512), sinon les objets de la bande droite au-dela de 512
+			// (fenetre a gauche) reviendraient a gauche, hors de l'ecran
+			x += nHsfaWsObjDx;
+			x = ((x + 256) & 0x3FF) - 256;
+		}
+#endif
 		
 		// Find the palette for the tiles on this sprite
 		CpstPal = CpsPal + ((a & 0x1F) << 4);
diff --git a/src/burn/drv/capcom/cps_scr.cpp b/src/burn/drv/capcom/cps_scr.cpp
index d4fb35f..b52b478 100644
--- a/src/burn/drv/capcom/cps_scr.cpp
+++ b/src/burn/drv/capcom/cps_scr.cpp
@@ -94,7 +94,7 @@ static inline UINT32 WsScr3Tuile(INT32 t)
