+// --------------------------------------------------------------------------------------------------------------
+// (patch 0029, agent etats_coeur) ETATS COMPLETS : ce que HsfaScan ne sauvait pas et dont depend la suite de la partie
+// (run-ahead, rembobinage, jeu en ligne, sauvegarde / chargement) :
+//  - QSound principal (qs_c.cpp, FBNeo d'origine) : position du reechantillonneur et interpolation -> instants des
+//    echantillons de la puce, donc ready_flag lu par le Z80 (pilote son decale apres un chargement, son different) ;
+//  - listes d'objets des images precedentes (cps_obj.cpp, FBNeo d'origine) : 1re image apres un chargement ;
+//  - palette convertie (cps_pal.cpp, FBNeo d'origine : relue dans la RAM au dessin suivant le chargement) et registres
+//    « F » verrouilles (CpsSaveFrg : decalage de l'image qui suit le chargement dans une nouvelle instance) ;
+//  - volume (Cps2Volume) : gains du QSound, sinon remis a jour toutes les 5 images seulement (nouvelle instance) ;
+//  - provocation sur Select (patch 0014) : Piece de l'image precedente (front), provocation en attente ;
+//  - options secretes deja ecrites (patch 0003) ;
+//  - 16:9 (patchs 0022 / 0023) : suivi de l'anneau scroll1 et pente k (colonnes montrees dans les bandes).
+// Zone placee APRES HsfaScanMelange, en fin d'etat libretro, lue seulement si l'etat charge la contient en entier
+// (nRestant) : les etats d'avant 0029 se chargent (rien de cette zone n'est lu ; le 16:9 reprend son suivi a zero),
+// et les etats 0029 se chargent dans un coeur plus ancien (octets en trop ignores). En-tete Â« HSF9 Â» + version.
+// HSFA_ETATS_FIN=0 (essais) : zone absente, etats identiques a l'octet a ceux du coeur 0027.
+void QscScanHsfa(INT32 nAction);
+void CpsObjScanHsfa(INT32 nAction);
+void CpsPalScanHsfa(INT32 nAction);
+
+static INT32 nHsfaEtatsFin = -1;
+static INT64 nFinTaille = 0;
+static INT32 __cdecl HsfaFinCompte(struct BurnArea *pba) { nFinTaille += pba->nLen; return 0; }
+
+// HSFA_ETATS_SANS=<masque> (essais) : au chargement, les parties choisies sont lues sans etre appliquees (la variable garde
+// sa valeur d'avant le chargement), pour mesurer l'effet de chacune : 1 QSound, 2 objets, 4 palette, 8 registres F,
+// 16 volume, 32 provocation, 64 options, 128 16:9.
+static INT32 nHsfaEtatsSans = -1, nFinPart = 0;
+static INT32 (__cdecl *pFinAcbVrai)(struct BurnArea *) = NULL;
+static INT32 __cdecl HsfaFinAcbFiltre(struct BurnArea *pba)
+{
+	if (!(nHsfaEtatsSans & nFinPart)) return pFinAcbVrai(pba);
+	static std::vector<UINT8> t;
+	t.resize(pba->nLen ? pba->nLen : 1);
+	struct BurnArea b = *pba; b.Data = &t[0];
+	return pFinAcbVrai(&b);
+}
+
+static void HsfaFinZones(INT32 nAction, UINT32 *pEntete)
+{
+	SCAN_VAR(*pEntete);
+	nFinPart = 1; QscScanHsfa(nAction);
+	nFinPart = 2; CpsObjScanHsfa(nAction);
+	nFinPart = 4; CpsPalScanHsfa(nAction);
+	nFinPart = 8;
+	{	// registres « F » verrouilles en fin d'image (decalage des plans et des objets de l'image suivante)
+		struct BurnArea ba;
+		memset(&ba, 0, sizeof(ba));
+		ba.Data = CpsSaveFrg[0]; ba.nLen = 0x10; ba.szName = "HsfaSaveFrg0"; BurnAcb(&ba);
+		ba.Data = CpsSaveFrg[1]; ba.nLen = 0x10; ba.szName = "HsfaSaveFrg1"; BurnAcb(&ba);
+	}
+	nFinPart = 16; SCAN_VAR(Cps2Volume);			// volume (touches de volume) : gains du QSound recalcules au chargement
+	nFinPart = 32; SCAN_VAR(nProvocPiece);
+	SCAN_VAR(nProvocAttente);
+	nFinPart = 64; SCAN_VAR(nOptExtra);
+	nFinPart = 128;
+#ifdef HSFA_WS
+	if (WsS1Copie == NULL) { WsS1Copie = (UINT8*)BurnMalloc(0x4000); if (WsS1Copie) memset(WsS1Copie, 0, 0x4000); }
+	struct BurnArea ba;
+	memset(&ba, 0, sizeof(ba));
+	ba.Data = WsS1Copie; ba.nLen = WsS1Copie ? 0x4000 : 0; ba.szName = "HsfaWsS1Copie"; if (ba.nLen) BurnAcb(&ba);
+	SCAN_VAR(WsS1Col); SCAN_VAR(WsS1Ok);
+	SCAN_VAR(bWsS1Init); SCAN_VAR(nWsS1Prec); SCAN_VAR(nWsS1Track); SCAN_VAR(nWsS1Base); SCAN_VAR(nWsS1D);
+	SCAN_VAR(nWsKDecor); SCAN_VAR(nWsK); SCAN_VAR(bWsK); SCAN_VAR(bWsAuto); SCAN_VAR(nWsKCam0); SCAN_VAR(nWsKU0);
+	SCAN_VAR(nWsKCamPrec); SCAN_VAR(nWsAutoN); SCAN_VAR(nWsExtG); SCAN_VAR(nWsExtD); SCAN_VAR(bWsExt);
+#endif
+}
+
+INT32 HsfaScanFin(INT32 nAction, INT64 nRestant)
+{
+	if (!HsfaMode || !(nAction & ACB_DRIVER_DATA)) return 0;
+	if (nHsfaEtatsFin < 0) nHsfaEtatsFin = (getenv("HSFA_ETATS_FIN") && atoi(getenv("HSFA_ETATS_FIN")) == 0) ? 0 : 1;
+	if (!nHsfaEtatsFin) return 0;
+	const UINT32 nAttendu = 0x48534639;				// Â« HSF9 Â», version 1 de la zone
+	UINT32 nEntete = nAttendu;
+	if ((nAction & ACB_WRITE) && nRestant >= 0) {
+		// chargement : la zone entiere est-elle dans l'etat ? (taille comptee sans rien lire)
+		INT32 (__cdecl *pSauve)(struct BurnArea *) = BurnAcb;
+		nFinTaille = 0; BurnAcb = HsfaFinCompte; HsfaFinZones(nAction & ~ACB_WRITE, &nEntete); BurnAcb = pSauve;
+		if (nRestant < nFinTaille) {				// etat d'avant 0029 : suivi du 16:9 repris a zero
+#ifdef HSFA_WS
+			bWsS1Init = 0; nWsKDecor = -1;
+#endif
+			return 0;
+		}
+	}
+	if (nHsfaEtatsSans < 0) nHsfaEtatsSans = getenv("HSFA_ETATS_SANS") ? atoi(getenv("HSFA_ETATS_SANS")) : 0;
+	if ((nAction & ACB_WRITE) && nHsfaEtatsSans) {
+		extern INT32 bCpsPalCharge;
+		const INT32 bPal = bCpsPalCharge;
+		pFinAcbVrai = BurnAcb; BurnAcb = HsfaFinAcbFiltre;
+		HsfaFinZones(nAction, &nEntete);
+		BurnAcb = pFinAcbVrai;
+		if (nHsfaEtatsSans & 4) bCpsPalCharge = bPal;
+	} else {
+		HsfaFinZones(nAction, &nEntete);
+	}
+	nFinPart = 0;
+	if ((nAction & ACB_WRITE) && Cps == 2) {			// gains du QSound (sinon recalcules toutes les 5 images)
+		QscSetRoute(BURN_SND_QSND_OUTPUT_1, Cps2Volume / 39.0, BURN_SND_ROUTE_LEFT);
+		QscSetRoute(BURN_SND_QSND_OUTPUT_2, Cps2Volume / 39.0, BURN_SND_ROUTE_RIGHT);
+	}
+	if ((nAction & ACB_WRITE) && nEntete != nAttendu) {
+		bprintf(PRINT_ERROR, _T("HSFA : zone de fin d'etat inconnue (%08X)\n"), nEntete);
+	}
+	return 0;
+}
