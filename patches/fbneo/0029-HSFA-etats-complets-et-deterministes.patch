+// (HSFA, patch 0029) etats complets : la palette convertie (CpsPal) est un etat de la machine (copiee par le jeu a
+// l'ecriture du registre $10B, pages actives seulement), absent des etats de FBNeo ; au chargement, FBNeo la relisait
+// dans la RAM au moment du dessin suivant (couleurs fausses une image, ou jusqu'a la copie suivante). CpsPalBrut garde
+// les mots de chaque page tels qu'ils ont ete convertis ; sauve par HsfaScanFin (pilotes HSFA), reconverti au dessin
+// qui suit le chargement (bCpsPalCharge).
+static UINT16 CpsPalBrut[0xc00];
+INT32 bCpsPalCharge = 0;
+
+void CpsPalScanHsfa(INT32 nAction)
+{
+	SCAN_VAR(CpsPalBrut);
+	if (nAction & ACB_WRITE) bCpsPalCharge = 1;
+}
+
+void CpsPalDepuisBrut()
+{
+	for (INT32 nPage = 0; nPage < 6; nPage++) {
+		for (INT32 Offset = 0; Offset < 0x200; ++Offset) {
+			INT32 Palette = BURN_ENDIAN_SWAP_INT16(CpsPalBrut[(0x200 * nPage) + Offset]);
+			INT32 Bright = 0x0f + ((Palette >> 12) << 1);
+			INT32 r = ((Palette >> 8) & 0x0f) * 0x11 * Bright / 0x2d;
+			INT32 g = ((Palette >> 4) & 0x0f) * 0x11 * Bright / 0x2d;
+			INT32 b = ((Palette >> 0) & 0x0f) * 0x11 * Bright / 0x2d;
+			CpsPal[(0x200 * nPage) + (Offset ^ 15)] = BurnHighCol(r, g, b, 0);
+		}
+	}
+}
+
