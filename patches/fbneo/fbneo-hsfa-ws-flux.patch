+// --------------------------------------------------------------------------------------------------------------
+// Lecteur de flux musique ADX (hsfa_flux.h, comme le fork MAME sfa3hx) : musiques que le Z80/QSound ne connait pas
+// (Upper : Guile, Fei-Long, Dee Jay, T.Hawk ; Hyper : ZERO, ZERO 2, ALPHA...), lues dans le Y_DATA.BIN de
+// l'utilisateur. Fichiers dans <systeme RetroArch>/fbneo/hsfa/ : Y_DATA.BIN (ou l'ISO de l'Anthology sous le nom
+// anthology.iso, ou un fichier ydata.txt contenant le chemin) et hsfa_flux_table.txt (gen_table_flux.py).
+// Variables d'environnement (PC) : HSFA_YDATA, HSFA_FLUX_TABLE, HSFA_FLUX_LOG, HSFA_FLUX_VOL (%), HSFA_FLUX (mode).
+// Mode : DIP « Musique PS2 » (0 inactif, 1 complement = codes sans QSound, 2 toutes les musiques sauf l'intro).
+
+static hsfa_flux::lecteur *HsfaFlux = NULL;
+UINT8 HsfaFluxDip = 1;
+static INT32 nHsfaFluxForce = -1;						// HSFA_FLUX (PC, essais) : mode impose, prioritaire sur le DIP
+
+static inline INT32 HsfaFluxMode() { return nHsfaFluxForce >= 0 ? nHsfaFluxForce : (HsfaFluxDip & 3); }
+
+static INT32 HsfaFichierExiste(const char *p)
+{
+	FILE *f = fopen(p, "rb");
+	if (f) fclose(f);
+	return f != NULL;
+}
+
+static void HsfaFluxInit()
+{
+	char dir[MAX_PATH], y[MAX_PATH + 64] = "", t[MAX_PATH + 64] = "";
+	snprintf(dir, sizeof(dir), "%.*shsfa/", MAX_PATH - 8, szAppHiscorePath);	// <systeme>/fbneo/hsfa/
+	nHsfaFluxForce = getenv("HSFA_FLUX") ? atoi(getenv("HSFA_FLUX")) : -1;
+	if (getenv("HSFA_YDATA")) snprintf(y, sizeof(y), "%s", getenv("HSFA_YDATA"));
+	else {
+		static const char *noms[] = { "Y_DATA.BIN", "y_data.bin", "anthology.iso" };
+		for (INT32 i = 0; i < 3 && !y[0]; i++) {
+			snprintf(t, sizeof(t), "%s%s", dir, noms[i]);
+			if (HsfaFichierExiste(t)) snprintf(y, sizeof(y), "%s", t);
+		}
+		snprintf(t, sizeof(t), "%sydata.txt", dir);
+		FILE *f = y[0] ? NULL : fopen(t, "r");
+		if (f) {
+			if (fgets(y, sizeof(y), f)) y[strcspn(y, "\r\n")] = 0;
+			fclose(f);
+		}
+	}
+	if (!y[0]) { bprintf(0, _T("HSFA flux : pas de Y_DATA.BIN dans %s (musiques PS2 inactives)\n"), dir); return; }
+	if (getenv("HSFA_FLUX_TABLE")) snprintf(t, sizeof(t), "%s", getenv("HSFA_FLUX_TABLE"));
+	else snprintf(t, sizeof(t), "%shsfa_flux_table.txt", dir);
+	HsfaFlux = new hsfa_flux::lecteur();
+	HsfaFlux->ouvre_journal(getenv("HSFA_FLUX_LOG"));
+	if (!HsfaFlux->ouvre(y, t)) {
+		bprintf(0, _T("HSFA flux : %s (musiques PS2 inactives)\n"), HsfaFlux->erreur.c_str());
+		delete HsfaFlux; HsfaFlux = NULL;
+		return;
+	}
+	HsfaFlux->taux = nBurnSoundRate > 0 ? nBurnSoundRate : 48000;
+	HsfaFlux->gain = 0.26f * (getenv("HSFA_FLUX_VOL") ? (float)atof(getenv("HSFA_FLUX_VOL")) : 100.f) / 100.f;
+	HsfaFlux->mode = HsfaFluxMode();
+	bprintf(0, _T("HSFA flux : %d flux ADX, %d codes (%s)\n"), (INT32)HsfaFlux->nb_flux(), (INT32)HsfaFlux->nb_codes(), t);
+}
+
+// commande posee par le 68K ($61801F = 0) : 1 = a remplacer par FF05 pour le Z80
+INT32 HsfaFluxCommande(UINT16 nCmd, UINT8 nV, UINT16 nP)
+{
+	if (!HsfaFlux) return 0;
+	HsfaFlux->mode = HsfaFluxMode();
+	return HsfaFlux->commande(nCmd, nV, nP) == hsfa_flux::REMPLACE_FF05;
+}
+
+// ajoute le flux a la sortie de la trame (stereo entrelacee, nBurnSoundRate)
+void HsfaFluxRendu(INT16 *pOut, INT32 nLen)
+{
+	if (!HsfaFlux || !pOut) return;
+	if (HsfaFlux->mode != HsfaFluxMode()) {
+		HsfaFlux->mode = HsfaFluxMode();
+		if (!HsfaFlux->mode) HsfaFlux->e.actif = 0;
+	}
+	if (HsfaFlux->taux != nBurnSoundRate && nBurnSoundRate > 0) HsfaFlux->taux = nBurnSoundRate;
+	if (HsfaFlux->mode) HsfaFlux->rend(pOut, nLen);
+}
+
 static INT32 HsfaScan(INT32 nAction, INT32 *)
 {
 	if (nAction & ACB_DRIVER_DATA) {
@@ -510,6 +587,10 @@ static INT32 HsfaScan(INT32 nAction, INT32 *)
 		SCAN_VAR(nPlanBase);
 		SCAN_VAR(nPlaneReg);
 		SCAN_VAR(nPlanesPending);
+		if (HsfaFlux) {
+			ba.Data = &HsfaFlux->e; ba.nLen = sizeof(HsfaFlux->e); ba.szName = "HsfaFlux"; BurnAcb(&ba);
+			if (nAction & ACB_WRITE) HsfaFlux->apres_chargement();
+		}
 
 		if (nAction & ACB_WRITE) {
 			if (HsfaMode == 2) HsfaUpdateScroll();
@@ -612,6 +693,8 @@ INT32 HsfaInit()
 	SekMapMemory(CpsRamFF, 0xFF0000, 0xFFFBFF, MAP_WRITE);
 	SekClose();
 
+	HsfaFluxInit();
+
 	CpsRunResetCallbackFunction = HsfaReset;
 	CpsMemScanCallbackFunction = HsfaScan;
 
@@ -621,6 +704,8 @@ INT32 HsfaInit()
 
 INT32 HsfaExit()
 {
+	delete HsfaFlux;
+	HsfaFlux = NULL;
 	BurnFree(HsfaExt);
 	BurnFree(HsfaTab);
 	BurnFree(HsfaEntries);
