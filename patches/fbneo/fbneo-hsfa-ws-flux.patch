+++ b/src/burn/drv/capcom/cps_mem.cpp
@@ -258,6 +258,14 @@ void __fastcall CPSQSoundC0WriteByte(UINT32 sekAddress, UINT8 byteValue)
 #endif
 
 	CpsZRamC0[sekAddress >> 1] = byteValue;
+
+	// HSFA : lecteur de flux musique ; une musique jouee en flux devient FF05 (arret de la musique QSound) pour le Z80
+	if (HsfaMode && sekAddress == 0x001F && byteValue == 0) {
+		if (HsfaFluxCommande((CpsZRamC0[0] << 8) | CpsZRamC0[1], CpsZRamC0[2], (CpsZRamC0[3] << 8) | CpsZRamC0[4])) {
+			CpsZRamC0[0] = 0xFF;
+			CpsZRamC0[1] = 0x05;
+		}
+	}
 }
 
 UINT8 __fastcall CPSQSoundF0ReadByte(UINT32 sekAddress)
