+++ b/src/burn/drv/capcom/cps_hsfa.cpp
@@ -0,0 +1,641 @@
+// HSFA : Street Fighter Alpha Anthology (PS2) retraduit en 68000 pour la CPS2.
+//
+// Reprend dans FBNeo ce que fait le banc MAME du projet (jeu sfa3ud + scripts Lua, et le fork MAME sfa3hx) :
+//  - banc_mem.lua     : blocs de donnees du portage a adresse fixe ($A00000-$EFFFFF), servis en lecture (ROM) ;
+//  - banc_plans.lua   : SFA3 = renumerotation des codes de tuiles des plans (tables plan1 / plan2 / f312) ;
+//                       Upper = bases des plans ecrites dans les registres $804200-$804205 (fork) ;
+//  - banc_sprites.lua : conversion de la liste d'objets du portage (codes LOCAUX par emplacement de banque,
+//                       bits 13-15 de Y) en tuiles 16x16 aux codes globaux, liste ecrite dans les deux banques ;
+//  - fork sfa3hx      : ROM graphique etendue ($2000000+), code d'objet sur 20 bits (bits 10-11 de X),
+//                       bases de plans, son hybride sur 16 Mo (charge par la liste de ROM du pilote).
+// Les tables et parametres viennent du fichier hsfa_tab.bin de l'archive (construit par paquet_fbneo.py).
+
+#include "cps.h"
+
+extern UINT8 *CpsRam660;
+
+INT32 HsfaMode = 0;									// 0 = inactif, 1 = SFA3 traduit, 2 = Upper (fork)
+UINT32 nCpsGfxLenMin = 0;							// taille minimale de la region graphique (Upper : 64 Mo)
+
+#define HSFA_EXT_BASE	0xA00000
+#define HSFA_EXT_LEN	0x500000					// $A00000-$EFFFFF
+#define HSFA_GFX_BASE	0x2000000					// ROM graphique etendue (code de tuile $40000)
+
+// --------------------------------------------------------------------------------------------------------------
+// Tables (hsfa_tab.bin) : "HSFATAB1", u32 nombre, u32 reserve, puis nombre x { char nom[24]; u32 decalage; u32 long }
+
+struct HsfaEntry { char szName[24]; const UINT8 *pData; UINT32 nLen; };
+
+static UINT8 *HsfaTab = NULL;
+static UINT8 *HsfaExt = NULL;
+static HsfaEntry *HsfaEntries = NULL;
+static INT32 nHsfaEntries = 0;
+
+static INT32 HsfaPerso[256];						// id du perso -> fichier de banque (-1 = aucun)
+struct HsfaAnim { UINT32 nPtr; INT32 nFile; };
+static HsfaAnim *HsfaAnims = NULL;
+static INT32 nHsfaAnims = 0;
+
+#define HSFA_MAXFILE 4096
+static INT16 HsfaFileIdx[HSFA_MAXFILE];				// fichier N -> entree "fN" (-1 = absente)
+static INT32 nIdxPlan1 = -1, nIdxPlan2 = -1, nIdxF312 = -1;
+
+// parametres (entree "config")
+static INT32 nCfgCommun = 254;						// banque commune (emplacement 0) : SFA3 e254, Upper e351
+static UINT32 nCfgPtrAnim = 0xFF3E48;				// pointeur d'animation de l'emplacement 4 (SFA3) / $FF40BC (Upper)
+static INT32 nCfgGfxIntro = 456;					// fichier de l'emplacement 4 tant que le pointeur est nul
+static INT32 bCfgPlans = 0;							// 1 = bases de plans du fork (Upper), 0 = renumerotation (SFA3)
+static UINT16 nCfgPlans[3] = { 0, 0, 0 };
+
+// --------------------------------------------------------------------------------------------------------------
+// Etat (sauvegarde dans les etats)
+
+static UINT16 *Ombre = NULL;						// $700000-$70FFFF : mots ecrits PAR LE JEU (liste brute)
+static INT32  *Age = NULL;							// image de la derniere ecriture de chaque mot
+static UINT16 *Conv = NULL;							// mots convertis deja en place
+static UINT8  *ConvOk = NULL;
+static UINT16 *Raw90 = NULL;						// $900000-$92FFFF : valeurs brutes du portage (SFA3)
+static UINT8  *Raw90Ok = NULL;
+
+static INT32 nImage = 0;							// compteur d'images (IMAGE du banc)
+static INT32 nFichier4 = -1;						// derniere animation connue (emplacement 4)
+static UINT32 nPlanBase[5];							// SFA3 : bases connues de scroll1/2/3 (indices 2..4)
+static UINT16 nPlaneReg[3];							// Upper : registres $804200-$804205
+static INT32 nPlanesPending = 0;					// Upper : bases a ecrire a la fin de la 1re image
+
+static INT32 bHsfaWordWrite = 0;					// ecriture de mot en cours (CpsWriteWord -> 2 octets)
+
+// statistiques (diagnostic, variable d'environnement HSFA_STATS)
+static UINT32 nStatListes = 0, nStatTuiles = 0, nStatRetires = 0, nStatTronques = 0;
+
+static inline UINT16 RdW(const UINT8 *p) { return BURN_ENDIAN_SWAP_INT16(*((const UINT16*)p)); }
+static inline void WrW(UINT8 *p, UINT16 d) { *((UINT16*)p) = BURN_ENDIAN_SWAP_INT16(d); }
+static inline UINT32 RdLE32(const UINT8 *p) { return p[0] | (p[1] << 8) | (p[2] << 16) | ((UINT32)p[3] << 24); }
+
+// RAM de travail du 68000 (lecture comme le bus 68K : gros-boutiste)
+static inline UINT8 RamB(UINT32 a) { return CpsRamFF[(a & 0xFFFF) ^ 1]; }
+static inline UINT16 RamW(UINT32 a) { return RdW(CpsRamFF + (a & 0xFFFE)); }
+static inline UINT32 RamL(UINT32 a) { return (RamW(a) << 16) | RamW(a + 2); }
+
+// --------------------------------------------------------------------------------------------------------------
+// Tables
+
+static INT32 HsfaFind(const char *szName)
+{
+	for (INT32 i = 0; i < nHsfaEntries; i++) {
+		if (strcmp(HsfaEntries[i].szName, szName) == 0) return i;
+	}
+	return -1;
+}
+
+static void HsfaParseConfig(const char *s, UINT32 n)
+{
+	char line[256];
+	UINT32 p = 0;
+	while (p < n) {
+		UINT32 q = 0;
+		while (p < n && s[p] != '\n' && q < sizeof(line) - 1) line[q++] = s[p++];
+		while (p < n && s[p] != '\n') p++;
+		p++;
+		line[q] = 0;
+		if (q && line[q - 1] == '\r') line[q - 1] = 0;
+		char *eq = strchr(line, '=');
+		if (eq == NULL) continue;
+		*eq = 0;
+		const char *k = line, *v = eq + 1;
+		if (strcmp(k, "commun") == 0) nCfgCommun = strtol(v, NULL, 10);
+		else if (strcmp(k, "ptr_anim") == 0) nCfgPtrAnim = strtoul(v, NULL, 16);
+		else if (strcmp(k, "gfx_intro") == 0) nCfgGfxIntro = strtol(v, NULL, 10);
+		else if (strcmp(k, "plans") == 0) {
+			char *e = (char*)v;
+			for (INT32 i = 0; i < 3; i++) {
+				nCfgPlans[i] = (UINT16)strtoul(e, &e, 16);
+				if (*e == ',') e++;
+			}
+			bCfgPlans = 1;
+		}
+	}
+}
+
+static void HsfaParseCarte(const char *s, UINT32 n)
+{
+	char line[256];
+	UINT32 p = 0;
+	INT32 nMax = 0;
+	for (UINT32 i = 0; i < n; i++) if (s[i] == '\n') nMax++;
+	HsfaAnims = (HsfaAnim*)BurnMalloc((nMax + 1) * sizeof(HsfaAnim));
+	nHsfaAnims = 0;
+	while (p < n) {
+		UINT32 q = 0;
+		while (p < n && s[p] != '\n' && q < sizeof(line) - 1) line[q++] = s[p++];
+		while (p < n && s[p] != '\n') p++;
+		p++;
+		line[q] = 0;
+		char k[16]; unsigned long long a = 0; long b = 0;
+		if (sscanf(line, "%15s %llu %ld", k, &a, &b) != 3) continue;
+		if (strcmp(k, "perso") == 0) {
+			if (a < 256) HsfaPerso[a] = (INT32)b;
+		} else if (strcmp(k, "anim") == 0 && nHsfaAnims <= nMax) {
+			HsfaAnims[nHsfaAnims].nPtr = (UINT32)a;
+			HsfaAnims[nHsfaAnims].nFile = (INT32)b;
+			nHsfaAnims++;
+		}
+	}
+}
+
+static INT32 HsfaParseTab(UINT32 nLen)
+{
+	if (nLen < 16 || memcmp(HsfaTab, "HSFATAB1", 8) != 0) {
+		bprintf(PRINT_ERROR, _T("HSFA : hsfa_tab.bin invalide\n"));
+		return 1;
+	}
+	nHsfaEntries = RdLE32(HsfaTab + 8);
+	if (nHsfaEntries <= 0 || 16 + (UINT32)nHsfaEntries * 32 > nLen) return 1;
+	HsfaEntries = (HsfaEntry*)BurnMalloc(nHsfaEntries * sizeof(HsfaEntry));
+	for (INT32 i = 0; i < nHsfaEntries; i++) {
+		const UINT8 *e = HsfaTab + 16 + i * 32;
+		memcpy(HsfaEntries[i].szName, e, 24);
+		HsfaEntries[i].szName[23] = 0;
+		UINT32 o = RdLE32(e + 24), l = RdLE32(e + 28);
+		if (o > nLen || l > nLen - o) return 1;
+		HsfaEntries[i].pData = HsfaTab + o;
+		HsfaEntries[i].nLen = l;
+	}
+
+	for (INT32 i = 0; i < 256; i++) HsfaPerso[i] = -1;
+	for (INT32 i = 0; i < HSFA_MAXFILE; i++) HsfaFileIdx[i] = -1;
+	for (INT32 i = 0; i < nHsfaEntries; i++) {
+		const char *n = HsfaEntries[i].szName;
+		if (n[0] == 'f' && n[1] >= '0' && n[1] <= '9') {
+			INT32 f = atoi(n + 1);
+			if (f >= 0 && f < HSFA_MAXFILE) HsfaFileIdx[f] = i;
+		}
+	}
+	nIdxPlan1 = HsfaFind("plan1");
+	nIdxPlan2 = HsfaFind("plan2");
+	nIdxF312 = HsfaFind("f312");
+
+	INT32 c = HsfaFind("config");
+	if (c >= 0) HsfaParseConfig((const char*)HsfaEntries[c].pData, HsfaEntries[c].nLen);
+	c = HsfaFind("carte");
+	if (c < 0) return 1;
+	HsfaParseCarte((const char*)HsfaEntries[c].pData, HsfaEntries[c].nLen);
+
+	bprintf(0, _T("HSFA : %d tables, commun %d, pointeur %06X, plans %s\n"), nHsfaEntries, nCfgCommun, nCfgPtrAnim, bCfgPlans ? _T("fork") : _T("renumerotes"));
+	return 0;
+}
+
+static const HsfaEntry *HsfaBanque(INT32 f)
+{
+	if (f < 0 || f >= HSFA_MAXFILE || HsfaFileIdx[f] < 0) return NULL;
+	return &HsfaEntries[HsfaFileIdx[f]];
+}
+
+// code global de la tuile locale l (u32 petit-boutiste, $FFFFFFFF = vide) ; -1 si absente
+static inline INT32 HsfaGlobal(const HsfaEntry *t, INT32 l)
+{
+	if (t == NULL || l < 0 || 4 * (UINT32)l + 4 > t->nLen) return -1;
+	UINT32 c = RdLE32(t->pData + 4 * l);
+	if (c == 0xFFFFFFFF) return -1;
+	return (INT32)c;
+}
+
+// --------------------------------------------------------------------------------------------------------------
+// banc_sprites.lua
+
+static void HsfaSuivre4()
+{
+	// (HANDOFF §108) pointeur d'animation : SFA3 $FF3E48, Upper $FF40BC ; nul = couple de l'intro
+	UINT32 p = RamL(nCfgPtrAnim);
+	INT32 f = -1;
+	for (INT32 i = 0; i < nHsfaAnims; i++) {
+		if (HsfaAnims[i].nPtr == p) { f = HsfaAnims[i].nFile; break; }
+	}
+	if (p == 0) f = nCfgGfxIntro;
+	if (f >= 0) nFichier4 = f;
+}
+
+static void HsfaEmplacements(const HsfaEntry **e)
+{
+	HsfaSuivre4();
+	for (INT32 i = 0; i < 8; i++) e[i] = NULL;
+	e[0] = HsfaBanque(nCfgCommun);
+	e[1] = (nIdxPlan2 >= 0) ? &HsfaEntries[nIdxPlan2] : NULL;
+	e[2] = HsfaBanque(HsfaPerso[RamB(0xFF8503)]);
+	e[3] = HsfaBanque(HsfaPerso[RamB(0xFF8903)]);
+	e[4] = HsfaBanque(nFichier4);
+	// (HANDOFF §102) joueurs 3 / 4 si leur structure est active
+	if (RamB(0xFF8C01) != 0) e[6] = HsfaBanque(HsfaPerso[RamB(0xFF8D03)]);
+	if (RamB(0xFF9001) != 0) e[7] = HsfaBanque(HsfaPerso[RamB(0xFF9103)]);
+}
+
+// eclate la liste brute [page, fin) en tuiles 16x16 converties, l'ecrit dans les deux banques ; rend le mot a
+// ecrire a l'adresse courante (le Y du marqueur de fin)
+static UINT16 HsfaEclater(UINT32 nPage, UINT32 nFin, UINT32 nCourante)
+{
+	static UINT16 Out[1024 * 4 + 4];
+	const HsfaEntry *e[8];
+	HsfaEmplacements(e);
+
+	INT32 n = 0, nTotal = 0;
+	for (UINT32 a = nPage; a + 8 <= nFin; a += 8) {
+		UINT32 i = (a - 0x700000) >> 1;
+		UINT16 x = Ombre[i], y = Ombre[i + 1], code = Ombre[i + 2], at = Ombre[i + 3];
+		if (Age[i] < nImage - 3) continue;				// entree ancienne (reste d'un ecran precedent)
+		const HsfaEntry *t = e[(y >> 13) & 7];
+		INT32 nx = ((at >> 8) & 15) + 1, ny = ((at >> 12) & 15) + 1;
+		INT32 fx = (at & 0x20) != 0, fy = (at & 0x40) != 0;
+		for (INT32 nys = 0; nys < ny; nys++) {
+			for (INT32 nxs = 0; nxs < nx; nxs++) {
+				INT32 cx = fx ? (nx - 1 - nxs) : nxs;
+				INT32 cy = fy ? (ny - 1 - nys) : nys;
+				INT32 g = HsfaGlobal(t, code + cx + 16 * cy);
+				if (g >= 0) {
+					if (n < 1023) {
+						// (HANDOFF §116) bits 16-17 -> Y 13-14 ; bits 18-19 -> X 10-11
+						Out[n * 4 + 0] = (UINT16)((((x & 0x3ff) + 16 * nxs) & 0x3ff) | (x & 0xe000) | (((g >> 18) & 3) << 10));
+						Out[n * 4 + 1] = (UINT16)((((y & 0x3ff) + 16 * nys) & 0x3ff) | (((g >> 16) & 3) << 13));
+						Out[n * 4 + 2] = (UINT16)(g & 0xffff);
+						Out[n * 4 + 3] = (UINT16)(at & 0x00ff);
+						n++;
+					}
+					nTotal++;
+				} else {
+					nStatRetires++;
+				}
+			}
+		}
+	}
+	if (nTotal > 1023) nStatTronques += nTotal - 1023;
+	Out[n * 4 + 0] = 0x8000; Out[n * 4 + 1] = 0x8000; Out[n * 4 + 2] = 0; Out[n * 4 + 3] = 0;
+	n++;
+	nStatListes++; nStatTuiles += n - 1;
+
+	// (HANDOFF §103) liste complete ecrite dans les DEUX banques physiques
+	UINT16 ret = 0x8000;
+	for (INT32 k = 0; k < n; k++) {
+		UINT32 a = nPage + 8 * k;
+		for (INT32 w = 0; w < 4; w++) {
+			UINT32 i = (a + 2 * w - 0x700000) >> 1;
+			UINT16 v = Out[k * 4 + w];
+			Conv[i] = v; ConvOk[i] = 1;
+			if (a + 2 * w == nCourante) ret = v;
+			UINT32 o = (a - nPage) + 2 * w;
+			WrW(CpsRam708 + 0x0000 + o, v);
+			WrW(CpsRam708 + 0x8000 + o, v);
+		}
+	}
+	return ret;
+}
+
+// ecriture du jeu dans $700000-$70FFFF (prise de banc_sprites.lua puis memoire d'objets de MAME)
+static void HsfaObjWrite(UINT32 a, UINT16 d, UINT16 nMask)
+{
+	a &= 0xFFFFFE;
+	UINT32 i = (a - 0x700000) >> 1;
+	Ombre[i] = d;
+	Age[i] = nImage;
+
+	UINT16 w = d;
+	if (d == 0x8000 && (a & 7) == 2 && Ombre[i - 1] == 0x8000) {
+		// marqueur de fin du portage (X = Y = $8000) : eclatement de la liste
+		UINT32 nPage = (a < 0x708000) ? 0x700000 : 0x708000;
+		w = HsfaEclater(nPage, a - 2, a);
+	} else if (ConvOk[i]) {
+		w = Conv[i];
+	}
+
+	// memoire d'objets de MAME : objram1 = banque FBNeo +$8000, objram2 = banque FBNeo +0
+	UINT8 *p = NULL;
+	if (a < 0x702000) {
+		p = CpsRam708 + (nCpsObjectBank ? 0x0000 : 0x8000) + (a & 0x1FFE);	// cps2_objram1_w
+	} else if (a >= 0x708000) {
+		p = CpsRam708 + (nCpsObjectBank ? 0x8000 : 0x0000) + (a & 0x1FFE);	// cps2_objram2_w (miroir $6000)
+	}
+	if (p) WrW(p, (RdW(p) & ~nMask) | (w & nMask));
+}
+
+static void __fastcall HsfaObjWriteWord(UINT32 a, UINT16 d) { HsfaObjWrite(a, d, 0xFFFF); }
+static void __fastcall HsfaObjWriteByte(UINT32 a, UINT8 d)
+{
+	if (a & 1) HsfaObjWrite(a, d, 0x00FF);
+	else HsfaObjWrite(a, d << 8, 0xFF00);
+}
+
+// --------------------------------------------------------------------------------------------------------------
+// banc_plans.lua, SFA3 : renumerotation des tuiles de plan (HANDOFF §65, §83, §103)
+
+static UINT16 HsfaConvertit(INT32 k, UINT16 c)
+{
+	static const UINT32 nSub[5] = { 0, 0, 0x20000, 0x10000, 0x4000 };
+	static const UINT32 nOff[5] = { 0, 0, 0, 0x5600, 0x0b00 };
+	INT32 idx = (k == 2) ? nIdxPlan1 : (k == 3) ? nIdxPlan2 : nIdxF312;
+	if (idx >= 0) {
+		const HsfaEntry *t = &HsfaEntries[idx];
+		if (4 * (UINT32)c + 4 <= t->nLen) {
+			UINT32 g = RdLE32(t->pData + 4 * c);
+			if (g != 0xFFFFFFFF && g >= nSub[k] && g - nSub[k] <= 0xffff) return (UINT16)(g - nSub[k]);
+		}
+	}
+	return (UINT16)((c + nOff[k]) & 0xffff);
+}
+
+// lecture / ecriture d'un mot comme le ferait space:read_u16 / write_u16 (memoire vive seulement)
+static UINT8 *HsfaRamPtr(UINT32 a)
+{
+	a &= 0xFFFFFE;
+	if (a >= 0x900000 && a < 0x930000) return CpsRam90 + (a - 0x900000);
+	if (a >= 0xFF0000) return CpsRamFF + (a - 0xFF0000);
+	if (a >= 0x660000 && a < 0x664000) return CpsRam660 + (a - 0x660000);
+	return NULL;
+}
+
+static void HsfaReconvertit(INT32 k)
+{
+	UINT32 b = nPlanBase[k];
+	for (UINT32 o = b; o <= b + 0x3ffc; o += 4) {
+		UINT16 v;
+		if (o >= 0x900000 && o < 0x930000 && Raw90Ok[(o - 0x900000) >> 1]) {
+			v = Raw90[(o - 0x900000) >> 1];
+		} else {
+			UINT8 *p = HsfaRamPtr(o);
+			if (p) v = RdW(p);
+			else if (o < nCpsRomLen) v = RdW(CpsRom + o);
+			else if (o >= HSFA_EXT_BASE && o < HSFA_EXT_BASE + HSFA_EXT_LEN) v = RdW(HsfaExt + (o - HSFA_EXT_BASE));
+			else v = 0;
+		}
+		UINT8 *p = HsfaRamPtr(o);
+		if (p) WrW(p, HsfaConvertit(k, v));
+	}
+}
+
+static void __fastcall HsfaVramWrite(UINT32 a, UINT16 d, UINT16 nMask)
+{
+	a &= 0xFFFFFE;
+	UINT32 i = (a - 0x900000) >> 1;
+	UINT8 *p = CpsRam90 + (a - 0x900000);
+	if (nMask != 0xFFFF) d = (((Raw90Ok[i] ? Raw90[i] : RdW(p)) & ~nMask) | (d & nMask)) & 0xFFFF;
+	Raw90[i] = d; Raw90Ok[i] = 1;
+	UINT16 w = d;
+	for (INT32 k = 2; k <= 4; k++) {
+		UINT32 b = nPlanBase[k];
+		if (a >= b && a < b + 0x4000 && ((a - b) & 2) == 0) {
+			w = HsfaConvertit(k, d);
+			break;
+		}
+	}
+	WrW(p, (RdW(p) & ~nMask) | (w & nMask));
+}
+
+static void __fastcall HsfaVramWriteWord(UINT32 a, UINT16 d) { HsfaVramWrite(a, d, 0xFFFF); }
+static void __fastcall HsfaVramWriteByte(UINT32 a, UINT8 d)
+{
+	if (a & 1) HsfaVramWrite(a, d, 0x00FF);
+	else HsfaVramWrite(a, d << 8, 0xFF00);
+}
+
+// registres de base des plans $804102-$804107 (prise de banc_plans.lua, avant l'ecriture du registre)
+static void HsfaBaseWrite(UINT32 a, UINT16 d)
+{
+	INT32 k = ((a & 0xFFFFFE) - 0x804100) / 2 + 1;
+	UINT32 nb = (UINT32)(d & 0xffc0) << 8;
+	if (nb != nPlanBase[k]) {
+		nPlanBase[k] = nb;
+		HsfaReconvertit(k);
+	}
+}
+
+// --------------------------------------------------------------------------------------------------------------
+// Upper : registres de base des plans du fork ($804200-$804205, unites de 64 Ko de la region graphique)
+
+static void HsfaUpdateScroll()
+{
+	for (INT32 k = 0; k < 3; k++) {
+		nCpsGfxScroll[k + 1] = nPlaneReg[k] ? ((UINT32)nPlaneReg[k] << 16) : 0x800000;
+	}
+}
+
+// appele par CpsReadByte / CpsWriteByte / CpsWriteWord (cps_rw.cpp) ; rend 1 si l'acces est traite
+INT32 HsfaPortReadByte(UINT32 a, UINT8 *d)
+{
+	if (HsfaMode == 2 && a >= 0x804200 && a <= 0x804205) {
+		UINT16 v = nPlaneReg[(a - 0x804200) >> 1];
+		*d = (a & 1) ? (v & 0xff) : (v >> 8);
+		return 1;
+	}
+	return 0;
+}
+
+INT32 HsfaPortWriteByte(UINT32 a, UINT8 d)
+{
+	if (HsfaMode == 2 && a >= 0x804200 && a <= 0x804205) {
+		UINT16 *r = &nPlaneReg[(a - 0x804200) >> 1];
+		if (a & 1) *r = (*r & 0xff00) | d;
+		else *r = (*r & 0x00ff) | (d << 8);
+		HsfaUpdateScroll();
+		return 1;
+	}
+	if (HsfaMode == 1 && !bHsfaWordWrite && a >= 0x804102 && a <= 0x804107) {
+		HsfaBaseWrite(a, (a & 1) ? d : (d << 8));
+	}
+	return 0;
+}
+
+void HsfaPortWriteWordStart(UINT32 a, UINT16 d)
+{
+	if (HsfaMode == 1 && a >= 0x804102 && a <= 0x804107) HsfaBaseWrite(a, d);
+	bHsfaWordWrite = 1;
+}
+
+void HsfaPortWriteWordEnd()
+{
+	bHsfaWordWrite = 0;
+}
+
+// --------------------------------------------------------------------------------------------------------------
+// Image, remise a zero, etats
+
+void HsfaFrameDone()
+{
+	if (!HsfaMode) return;
+	if (nPlanesPending) {								// banc_plans.lua (HSFA_PLANS) : bases ecrites a la 1re image
+		for (INT32 k = 0; k < 3; k++) nPlaneReg[k] = nCfgPlans[k];
+		HsfaUpdateScroll();
+		nPlanesPending = 0;
+	}
+	HsfaSuivre4();
+	nImage++;
+
+	static INT32 bStats = -1;
+	if (bStats < 0) bStats = getenv("HSFA_STATS") ? 1 : 0;
+	if (bStats && (nImage % 600) == 0) {
+		bprintf(0, _T("HSFA image %d : listes %u, tuiles %u, retirees %u, tronquees %u, fichier4 %d\n"), nImage, nStatListes, nStatTuiles, nStatRetires, nStatTronques, nFichier4);
+	}
+}
+
+static INT32 HsfaReset()
+{
+	memset(Ombre, 0, 0x8000 * sizeof(UINT16));
+	for (INT32 i = 0; i < 0x8000; i++) Age[i] = -99;
+	memset(Conv, 0, 0x8000 * sizeof(UINT16));
+	memset(ConvOk, 0, 0x8000);
+	memset(Raw90, 0, 0x18000 * sizeof(UINT16));
+	memset(Raw90Ok, 0, 0x18000);
+	nImage = 0;
+	nFichier4 = -1;
+	nPlanBase[0] = nPlanBase[1] = 0;
+	nPlanBase[2] = 0x900000; nPlanBase[3] = 0x904000; nPlanBase[4] = 0x908000;
+	nPlaneReg[0] = nPlaneReg[1] = nPlaneReg[2] = 0;
+	nPlanesPending = (HsfaMode == 2 && bCfgPlans) ? 1 : 0;
+	nStatListes = nStatTuiles = nStatRetires = nStatTronques = 0;
+	if (HsfaMode == 2) HsfaUpdateScroll();
+	return 0;
+}
+
+static INT32 HsfaScan(INT32 nAction, INT32 *)
+{
+	if (nAction & ACB_DRIVER_DATA) {
+		struct BurnArea ba;
+		memset(&ba, 0, sizeof(ba));
+		ba.Data = Ombre;   ba.nLen = 0x8000 * sizeof(UINT16);  ba.szName = "HsfaOmbre";   BurnAcb(&ba);
+		ba.Data = Age;     ba.nLen = 0x8000 * sizeof(INT32);   ba.szName = "HsfaAge";     BurnAcb(&ba);
+		ba.Data = Conv;    ba.nLen = 0x8000 * sizeof(UINT16);  ba.szName = "HsfaConv";    BurnAcb(&ba);
+		ba.Data = ConvOk;  ba.nLen = 0x8000;                   ba.szName = "HsfaConvOk";  BurnAcb(&ba);
+		if (HsfaMode == 1) {
+			ba.Data = Raw90;   ba.nLen = 0x18000 * sizeof(UINT16); ba.szName = "HsfaRaw90";   BurnAcb(&ba);
+			ba.Data = Raw90Ok; ba.nLen = 0x18000;                  ba.szName = "HsfaRaw90Ok"; BurnAcb(&ba);
+		}
+		SCAN_VAR(nImage);
+		SCAN_VAR(nFichier4);
+		SCAN_VAR(nPlanBase);
+		SCAN_VAR(nPlaneReg);
+		SCAN_VAR(nPlanesPending);
+
+		if (nAction & ACB_WRITE) {
+			if (HsfaMode == 2) HsfaUpdateScroll();
+		}
+	}
+	return 0;
+}
+
+// --------------------------------------------------------------------------------------------------------------
+// Chargement
+
+// tuiles au format interne de MAME (4 octets = plans 0..3 de 8 pixels, pixel x au bit 7-x, valeur brute) ->
+// format de FBNeo (8 pixels par mot de 32 bits, pixel x dans le quartet 7-x, valeur inversee 15 - brute)
+static inline UINT32 HsfaSeparate(UINT32 b)
+{
+	UINT32 a = b;
+	a = ((a & 0x000000F0) << 12) | (a & 0x0000000F);
+	a = ((a & 0x000C000C) <<  6) | (a & 0x00030003);
+	a = ((a & 0x02020202) <<  3) | (a & 0x01010101);
+	return a;
+}
+
+static void HsfaConvertGfx(const UINT8 *pSrc, UINT32 nLen, UINT8 *pDst)
+{
+	UINT32 Sep[256];
+	for (INT32 i = 0; i < 256; i++) Sep[i] = HsfaSeparate(255 - i);
+	for (UINT32 o = 0; o + 4 <= nLen; o += 4) {
+		UINT32 v = Sep[pSrc[o + 0]] | (Sep[pSrc[o + 1]] << 1) | (Sep[pSrc[o + 2]] << 2) | (Sep[pSrc[o + 3]] << 3);
+		*((UINT32*)(pDst + o)) = v;
+	}
+}
+
+static INT32 HsfaLoadData()
+{
+	struct BurnRomInfo ri;
+	for (INT32 i = 0; ; i++) {
+		memset(&ri, 0, sizeof(ri));
+		if (BurnDrvGetRomInfo(&ri, i)) break;
+		if (ri.nLen == 0) break;
+		if ((ri.nType & 0x0f) != CPS2_HSFA_DATA) continue;
+		char *pszName = NULL;
+		BurnDrvGetRomName(&pszName, i, 0);
+		if (pszName == NULL) continue;
+
+		if (strcmp(pszName, "hsfa_ext.bin") == 0) {
+			if (ri.nLen != HSFA_EXT_LEN) return 1;
+			if (BurnLoadRom(HsfaExt, i, 1)) return 1;			// mots deja echanges (format ROM_LOAD16_WORD_SWAP)
+		}
+		else if (strcmp(pszName, "hsfa_tab.bin") == 0) {
+			HsfaTab = (UINT8*)BurnMalloc(ri.nLen);
+			if (BurnLoadRom(HsfaTab, i, 1)) return 1;
+			if (HsfaParseTab(ri.nLen)) return 1;
+		}
+		else if (strcmp(pszName, "hsfa_gfx.bin") == 0) {
+			if (HSFA_GFX_BASE + ri.nLen > nCpsGfxLen) return 1;
+			UINT8 *tmp = (UINT8*)BurnMalloc(ri.nLen);
+			if (tmp == NULL) return 1;
+			if (BurnLoadRom(tmp, i, 1)) { BurnFree(tmp); return 1; }
+			HsfaConvertGfx(tmp, ri.nLen, CpsGfx + HSFA_GFX_BASE);
+			BurnFree(tmp);
+		}
+	}
+	return (HsfaTab == NULL) ? 1 : 0;
+}
+
+INT32 HsfaInit()
+{
+	HsfaExt = (UINT8*)BurnMalloc(HSFA_EXT_LEN);
+	Ombre   = (UINT16*)BurnMalloc(0x8000 * sizeof(UINT16));
+	Age     = (INT32*)BurnMalloc(0x8000 * sizeof(INT32));
+	Conv    = (UINT16*)BurnMalloc(0x8000 * sizeof(UINT16));
+	ConvOk  = (UINT8*)BurnMalloc(0x8000);
+	Raw90   = (UINT16*)BurnMalloc(0x18000 * sizeof(UINT16));
+	Raw90Ok = (UINT8*)BurnMalloc(0x18000);
+	if (!HsfaExt || !Ombre || !Age || !Conv || !ConvOk || !Raw90 || !Raw90Ok) return 1;
+	memset(HsfaExt, 0, HSFA_EXT_LEN);
+
+	if (HsfaLoadData()) {
+		bprintf(PRINT_ERROR, _T("HSFA : donnees du portage absentes ou invalides\n"));
+		return 1;
+	}
+	if (HsfaMode == 2 && !bCfgPlans) {
+		bprintf(PRINT_ERROR, _T("HSFA : Upper sans bases de plans (config)\n"));
+	}
+
+	SekOpen(0);
+	// banc_mem.lua / HSFA_EXT : blocs de donnees du portage a adresse fixe
+	SekMapMemory(HsfaExt, HSFA_EXT_BASE, HSFA_EXT_BASE + HSFA_EXT_LEN - 1, MAP_READ | MAP_FETCH);
+	// banc_sprites.lua : toutes les ecritures dans $700000-$70FFFF passent par la conversion
+	SekMapHandler(5, 0x700000, 0x70FFFF, MAP_WRITE);
+	SekSetWriteByteHandler(5, HsfaObjWriteByte);
+	SekSetWriteWordHandler(5, HsfaObjWriteWord);
+	if (HsfaMode == 1) {
+		// banc_plans.lua : prise sur la memoire video
+		SekMapHandler(6, 0x900000, 0x92FFFF, MAP_WRITE);
+		SekSetWriteByteHandler(6, HsfaVramWriteByte);
+		SekSetWriteWordHandler(6, HsfaVramWriteWord);
+	}
+	// sorties Phoenix ($FFFFF0) : seule la derniere page de RAM passe par le gestionnaire (vitesse)
+	SekMapMemory(CpsRamFF, 0xFF0000, 0xFFFBFF, MAP_WRITE);
+	SekClose();
+
+	CpsRunResetCallbackFunction = HsfaReset;
+	CpsMemScanCallbackFunction = HsfaScan;
+
+	HsfaReset();
+	return 0;
+}
+
+INT32 HsfaExit()
+{
+	BurnFree(HsfaExt);
+	BurnFree(HsfaTab);
+	BurnFree(HsfaEntries);
+	BurnFree(HsfaAnims);
+	BurnFree(Ombre);
+	BurnFree(Age);
+	BurnFree(Conv);
+	BurnFree(ConvOk);
+	BurnFree(Raw90);
+	BurnFree(Raw90Ok);
+	nHsfaEntries = nHsfaAnims = 0;
+	nIdxPlan1 = nIdxPlan2 = nIdxF312 = -1;
+	nCfgCommun = 254; nCfgPtrAnim = 0xFF3E48; nCfgGfxIntro = 456; bCfgPlans = 0;
+	nCfgPlans[0] = nCfgPlans[1] = nCfgPlans[2] = 0;
+	HsfaMode = 0;
+	nCpsGfxLenMin = 0;
+	return 0;
+}
