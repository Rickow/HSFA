+
+/* --- PILOTE=hyper : portage de tournee_hyper.lua ------------------------------------------------------------ */
+static uint8_t *ram = NULL;			/* $FF0000-$FFFFFF, mots 16 bits dans l'ordre de l'hote (octet 68K a = ram[a ^ 1]) */
+static FILE *jrn = NULL;
+static void snap(int n);
+
+static int u8(uint32_t a) { return ram[(a & 0xffff) ^ 1]; }
+static int u16(uint32_t a) { a &= 0xfffe; return ram[a] | (ram[a + 1] << 8); }
+/* STATETEST avec le pilote : entrees et ecritures de la 1re passe enregistrees, puis rejouees telles quelles (le pilote
+   a un etat propre qui ne fait pas partie de l'etat sauvegarde du coeur) */
+static uint16_t *recpad = NULL;		/* masques des 2 manettes, par image */
+struct ecr { int k; uint32_t a; int v, large; };
+static struct ecr *ecrs = NULL; static int necr = 0, capecr = 0, enreg = 0;
+static void note(uint32_t a, int v, int large)
+{
+	if (!enreg) return;
+	if (necr == capecr) { capecr = capecr ? 2 * capecr : 4096; ecrs = realloc(ecrs, capecr * sizeof(*ecrs)); }
+	ecrs[necr].k = frame; ecrs[necr].a = a; ecrs[necr].v = v; ecrs[necr].large = large; necr++;
+}
+static void w8(uint32_t a, int v) { note(a, v, 0); ram[(a & 0xffff) ^ 1] = v; }
+static void w16(uint32_t a, int v) { note(a, v, 1); a &= 0xfffe; ram[a] = v & 0xff; ram[a + 1] = (v >> 8) & 0xff; }
+static void rejoue_entrees(int k)
+{
+	for (int p = 0; p < 2; p++) for (int i = 0; i < 16; i++) pad[p][i] = (recpad[2 * k + p] >> i) & 1;
+}
+static void rejoue_ecritures(int k)
+{
+	int sv = enreg; enreg = 0;
+	for (int i = 0; i < necr; i++) if (ecrs[i].k == k) { if (ecrs[i].large) w16(ecrs[i].a, ecrs[i].v); else w8(ecrs[i].a, ecrs[i].v); }
+	enreg = sv;
+}
+static void on(const char *f) { int port, id; if (champ(f, &port, &id)) vpad[port][id] = 1; }
+
+static const uint8_t GRILLE[64] = {0xff,0xff,0xa6,0x0a,0x67,0xff,0xff,0xff,0xff,0x20,0x03,0x04,0x0b,0x21,0xff,0xff,0x22,0x0c,0x07,0x1a,0x08,0x02,0x17,0x3f,0x00,0x18,0x1b,0x1d,0x1c,0x19,0x01,0x3f,0x1e,0x0f,0x06,0x16,0x05,0x10,0x1f,0x3f,0xff,0x23,0x0e,0x0d,0x11,0x15,0xff,0xff,0xff,0xff,0x69,0x09,0xa8,0xff,0xff,0xff,0xff,0xff,0x3f,0x3f,0x3f,0xff,0xff,0xff};
+static const uint8_t VERS[] = {0x30,0x40,0x60,0x00,0x31,0x41,0x61,0x01,0x32,0x42,0x62,0x02,0x33,0x43,0x63,0x03,0x34,0x44,0x64,0x04,0x35,0x45,0x65,0x05,0x36,0x46,0x66,0x06,0x37,0x47,0x67,0x07,0x38,0x48,0x68,0x08,0x39,0x49,0x69,0x09,0x3a,0x4a,0x6a,0x0a,0x3b,0x4b,0x6b,0x0b,0x3c,0x4c,0x6c,0x0c,0x4d,0x6d,0x0d,0xff,0x4e,0x6e,0x0e,0xff,0x4f,0x6f,0x0f,0xff,0x50,0x70,0x10,0xff,0x51,0x71,0x11,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0x15,0xff,0xff,0xff,0x7e,0x16,0xff,0xff,0x57,0x77,0x17,0xff,0x18,0xff,0xff,0xff,0x19,0xff,0xff,0xff,0x1a,0xff,0xff,0xff,0x1b,0xff,0xff,0xff,0x1c,0xff,0xff,0xff,0x1d,0xff,0xff,0xff,0x1e,0xff,0xff,0xff,0x1f,0xff,0xff,0xff,0x20,0xff,0xff,0xff,0x21,0xff,0xff,0xff,0x22,0xff,0xff,0xff,0x23,0xff,0xff,0xff,0x32,0x42,0x62,0x02,0x15,0xff,0xff,0xff};
+enum { FAM_Z3, FAM_Z, FAM_Z2, FAM_A };
+struct spec { int base, fam, ex, mode, ism; char txt[32]; };
+static struct spec liste[64][2];
+static int nliste = 0, nparts[64];
+static int nocombat = 0, modejeu = 1, modeforce = -1, contourne_e = 0, snapm = 0;
+static const uint32_t JJ[2] = { 0xFF8400, 0xFF8800 };
+
+static void lit_liste(const char *s)
+{
+	char *c = strdup(s), *sv = NULL;
+	for (char *paire = strtok_r(c, ",", &sv); paire && nliste < 64; paire = strtok_r(NULL, ",", &sv)) {
+		char *sv2 = NULL; int n = 0;
+		for (char *sp = strtok_r(paire, "/", &sv2); sp && n < 2; sp = strtok_r(NULL, "/", &sv2)) {
+			struct spec *q = &liste[nliste][n++];
+			memset(q, 0, sizeof(*q)); q->fam = FAM_Z3;
+			snprintf(q->txt, sizeof(q->txt), "%s", sp);
+			char *sv3 = NULL; int i = 0;
+			for (char *f = strtok_r(sp, ".", &sv3); f; f = strtok_r(NULL, ".", &sv3), i++) {
+				if (i == 0) q->base = (int)strtol(f, NULL, 16);
+				else if (i == 1) q->fam = !strcmp(f, "Z") ? FAM_Z : !strcmp(f, "Z2") ? FAM_Z2 : !strcmp(f, "A") ? FAM_A : FAM_Z3;
+				else if (!strcmp(f, "S")) q->ex = 1;
+				else if (f[0] == 'm' && f[1] >= '0' && f[1] <= '7') q->mode = f[1] - '0';
+				else if (!strcmp(f, "iX")) q->ism = -1; else if (!strcmp(f, "iA")) q->ism = 0; else if (!strcmp(f, "iV")) q->ism = 1;
+			}
+		}
+		nparts[nliste++] = n;
+	}
+	free(c);
+}
+static int famille(int id) { return id < 0x30 ? FAM_Z3 : id < 0x40 ? FAM_Z : id < 0x60 ? FAM_Z2 : FAM_A; }
+static int colonne(const struct spec *s)
+{
+	for (int c = 0; c < 4; c++) { int id = VERS[s->base * 4 + c]; if (id != 0xff && famille(id) == s->fam) return c; }
+	return -1;
+}
+static const char *DNOM[4] = { "Right", "Left", "Down", "Up" };
+static const int DX[4] = { 1, -1, 0, 0 }, DY[4] = { 0, 0, 1, -1 };
+static int pas(int *x, int *y, int dx, int dy, int j)
+{
+	int xx = *x, yy = *y;
+	for (int i = 0; i < 8; i++) {
+		xx = (xx + dx) & 7; yy = (yy + dy) & 7;
+		int c = GRILLE[yy * 8 + xx];
+		if (c != 0x3f) { if ((c >> (6 + j)) & 1) return 0; *x = xx; *y = yy; return 1; }
+	}
+	return 0;
+}
+static int chemin(int x0, int y0, int base, int j)	/* premiere direction d'un plus court chemin (BFS), -1 = ici / aucun */
+{
+	int vu[64], par[64], dir[64], file[64], nf = 0, i = 0;
+	for (int k = 0; k < 64; k++) vu[k] = 0;
+	vu[y0 * 8 + x0] = 2; file[nf++] = y0 * 8 + x0;
+	while (i < nf) {
+		int n = file[i++], x = n & 7, y = n >> 3;
+		if ((GRILLE[n] & 0x3f) == base) {
+			int k = n;
+			while (vu[k] != 2 && par[k] != y0 * 8 + x0) k = par[k];
+			return vu[k] == 2 ? -1 : dir[k];
+		}
+		for (int d = 0; d < 4; d++) {
+			int nx = x, ny = y;
+			if (pas(&nx, &ny, DX[d], DY[d], j) && !vu[ny * 8 + nx]) { vu[ny * 8 + nx] = 1; par[ny * 8 + nx] = n; dir[ny * 8 + nx] = d; file[nf++] = ny * 8 + nx; }
+		}
+	}
+	return -1;
+}
+static int K;
+static const char *manette(int j) { return (modejeu == 4 || j == 1) ? "P1" : "P2"; }
+static void appui(int j, const char *quoi) { char b[48]; if (K % 8 < 3) { snprintf(b, sizeof(b), "%s %s", manette(j), quoi); on(b); } }
+static void startj(int j) { on((modejeu == 4 || j == 1) ? "1 Player Start" : "2 Players Start"); }
+static void btn1_16(int j) { char b[48]; if (K % 16 >= 8 && K % 16 < 11) { snprintf(b, sizeof(b), "%s Button 1", manette(j)); on(b); } }
+static void selectionne(int j, const struct spec *s)
+{
+	uint32_t P = JJ[j - 1]; int et = u8(P + 5);
+	if (et == 0) {
+		int d = chemin(u16(P + 0x12) & 7, u16(P + 0x16) & 7, s->base, j - 1);
+		if (d >= 0) appui(j, DNOM[d]); else { if (s->ex) startj(j); btn1_16(j); }
+	} else if (et == 2) {
+		int c = colonne(s); if (c < 0) c = 0;
+		if (u8(P + 0x5C) != c) appui(j, "Down"); else { if (s->ex) startj(j); btn1_16(j); }
+	} else if (et == 6) {
+		static const int BASE[8] = { 0, 1, 2, 3, 3, 1, 0, 2 };
+		int m = u8(P + 0x5C);
+		if (m == s->mode) appui(j, "Button 1");
+		else if (m <= 3 && m != BASE[s->mode]) appui(j, "Down");
+		else { char b[48]; startj(j); if (K % 16 >= 8 && K % 16 < 11) { snprintf(b, sizeof(b), "%s Right", manette(j)); on(b); } }
+	} else if (et == 8) {
+		int i = u8(P + 0x133); if (i >= 0x80) i -= 0x100;
+		if (i != s->ism) appui(j, "Down"); else appui(j, "Button 1");
+	} else if (et == 4 || et == 0xA) appui(j, "Button 1");
+}
+static int nsel = 0, combats = 0, stable = 0, debut_vs = -1, vs_vu = 0, scene_e = 0, en_sel[3], bloque[3];
+static char jlast[400] = "";
+static uint32_t watchw[16]; static int nwatchw = 0;
+static void pilote_image(int k)		/* frame_done de l'image k : entrees de l'image k + 1 et ecritures */
+{
+	K = k;
+	memset(vpad, 0, sizeof(vpad));
+	int p0 = u16(0xFF8000), p4 = u16(0xFF8004), p8 = u16(0xFF8008), pc_ = u16(0xFF800C), p10 = u16(0xFF8010);
+	if (p0 == 6 || p0 == 4 || (p0 == 2 && p4 == 0)) {
+		if (k > 200 && k % 60 < 6 && k < 900) { on("Coin 1"); if (modejeu == 1) on("Coin 2"); }
+		if (p0 == 6 && k > 300 && k % 40 < 6) on("1 Player Start");
+		if (p0 == 4) {
+			if (modeforce >= 0) w8(0xFF4201, modeforce);
+			int cur = u8(0xFF4201);
+			if (modeforce < 0 && cur != modejeu) { if (k % 20 < 4) on("P1 Down"); }
+			else if (k % 20 >= 10 && k % 20 < 14) on("P1 Button 1");
+		}
+	}
+	if (p0 == 2 && p4 == 2 && p8 == 4) {
+		if (modejeu == 1 && (u8(0xFF80A9) & 2) == 0 && k % 30 < 4) on("2 Players Start");
+		for (int j = 1; j <= 2; j++) {
+			uint32_t P = JJ[j - 1]; int et = u8(P + 5);
+			int actif = (modejeu == 1) || j == 1 || u8(JJ[0] + 5) == 0xC;
+			if (u8(P + 1) != 0 && et < 0xC && actif) {
+				if (!en_sel[j]) {
+					en_sel[j] = 1; bloque[j] = 0;
+					if (j == 1) { nsel++; vs_vu = 0; debut_vs = -1; if (jrn) fprintf(jrn, "SELECTION %d image %d\n", nsel, k); }
+				}
+				int ip = (nsel - 1) % nliste;
+				selectionne(j, &liste[ip][(j - 1) < nparts[ip] ? j - 1 : 0]);
+				if (++bloque[j] == 3000 && jrn) fprintf(jrn, "BLOQUE J%d image %d etat %02x/%02x\n", j, k, et, u8(P + 4));
+			}
+		}
+	}
+	for (int j = 1; j <= 2; j++) {
+		uint32_t P = JJ[j - 1];
+		if (en_sel[j] && u8(P + 5) == 0xC) {
+			en_sel[j] = 0;
+			int ip = (nsel - 1) % nliste;
+			if (jrn) fprintf(jrn, "CHOIX J%d image %d : $102=%02x base=%02x drapeaux=%02x mode=%02x $123=%02x $15F=%02x ism=%02x (%s)\n",
+				j, k, u8(P + 0x103), u8(P + 0x117), u8(P + 0x116), u8(P + 0x5C), u8(P + 0x123), u8(P + 0x15F), u8(P + 0x133),
+				(j - 1) < nparts[ip] ? liste[ip][j - 1].txt : "?");
+		}
+	}
+	if (p0 == 2 && p4 == 2 && p8 != 4 && k % 24 >= 12 && k % 24 < 15) { on("P1 Button 1"); if (modejeu == 1) on("P2 Button 1"); }
+	if (p0 == 2 && p4 == 0xE) {
+		scene_e++;
+		if (scene_e == 1 && jrn) fprintf(jrn, "SCENE_E image %d (fin de match VERSUS)\n", k);
+		if (scene_e == 120 && contourne_e) {
+			static const int O[] = { 0x3D, 0x118, 0x120, 0x123, 0x129, 0x130, 0x131, 0x133, 0x148, 0x14A, 0x15A, 0x15B, 0x15C, 0x15D, 0x15E, 0x15F, 0x162, 0x163 };
+			if (jrn) fprintf(jrn, "CONTOURNEMENT scene E image %d : A5+4 <- 2, A5+8/C/10 <- 0\n", k);
+			w16(0xFF8004, 2); w16(0xFF8008, 0); w16(0xFF800C, 0); w16(0xFF8010, 0);
+			for (int j = 0; j < 2; j++) for (unsigned i = 0; i < sizeof(O) / sizeof(O[0]); i++) w8(JJ[j] + O[i], 0);
+		}
+	} else scene_e = 0;
+	if (p4 == 4 && p8 == 4 && !vs_vu) { vs_vu = 1; debut_vs = k; }
+	if (snapm && debut_vs >= 0 && k == debut_vs + 60) snap(k);
+	uint32_t adv[3]; int nadv = 0;
+	const uint32_t AO[3] = { 0xFF8800, 0xFF8C00, 0xFF9000 };
+	for (int i = 0; i < 3; i++) if (u8(AO[i] + 5) == 2) adv[nadv++] = AO[i];
+	int combat = p0 == 2 && p4 == 4 && p8 == 6 && u8(JJ[0] + 5) == 2 && nadv > 0;
+	if (combat) {
+		stable++;
+		if (stable == 1) { combats++; if (jrn) fprintf(jrn, "MANCHE %d image %d J1 %02x/%02x J2 %02x/%02x\n", combats, k, u8(JJ[0] + 0x103), u8(JJ[0] + 0xD2), u8(JJ[1] + 0x103), u8(JJ[1] + 0xD2)); }
+		if (snapm && stable == 150) snap(k);
+		w16(JJ[0] + 0x50, 0x90); w16(JJ[0] + 0x52, 0x90);
+		if (stable > 60 && !nocombat) {
+			for (int i = 0; i < nadv; i++) { int vie = u16(adv[i] + 0x50); if (vie > 1 && vie < 0x100) { w16(adv[i] + 0x50, 1); w16(adv[i] + 0x52, 1); } }
+			const char *av = (u16(JJ[0] + 0x12) < u16(adv[0] + 0x12)) ? "P1 Right" : "P1 Left";
+			int t = stable % 40;
+			if (t < 3) on("P1 Down");
+			else if (t < 6) { on("P1 Down"); on(av); }
+			else if (t < 10) { on(av); if (t >= 7) on("P1 Button 1"); }
+			else if (t < 30) on(av);	/* le script pose aussi "P1 Button 4" sur :IN0, mais ce bouton est sur :IN1 dans
+			                         	   MAME : il n'est jamais appuye au banc, donc pas ici non plus */
+		}
+	} else stable = 0;
+	if (jrn) {
+		char st[400];
+		snprintf(st, sizeof(st), "%04x %04x %04x %04x %04x | J1 %02x %02x %02x %02x | J2 %02x %02x %02x %02x",
+			p0, p4, p8, pc_, p10, u8(JJ[0] + 1), u8(JJ[0] + 5), u8(JJ[0] + 0x103), u8(JJ[0] + 0xD2),
+			u8(JJ[1] + 1), u8(JJ[1] + 5), u8(JJ[1] + 0x103), u8(JJ[1] + 0xD2));
+		if (nwatchw) {		/* WATCHW="FF8412,..." : mots ajoutes a la ligne du journal (comme hyper.lua) */
+			size_t l = strlen(st);
+			for (int i = 0; i < nwatchw && l + 16 < sizeof(st); i++) l += snprintf(st + l, sizeof(st) - l, " %06x=%04x", watchw[i], u16(watchw[i]));
