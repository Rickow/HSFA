+		if (const char *t = getenv("HSFA_FLUX_TABLE")) table = t;
+		else
+		{
+			std::string d(y);
+			size_t at = d.rfind('@'); if (at != std::string::npos && d.find('/', at) == std::string::npos) d.resize(at);
+			size_t sl = d.find_last_of('/');
+			table = (sl == std::string::npos ? std::string() : d.substr(0, sl + 1)) + "hsfa_flux_table.txt";
+		}
+		m_lecteur.ouvre_journal(getenv("HSFA_FLUX_LOG"));
+		if (!m_lecteur.ouvre(y, table.c_str()))
+		{
+			osd_printf_warning("HSFA flux : %s (lecteur inactif)\n", m_lecteur.erreur);
+			return;
+		}
+		m_lecteur.mode = getenv("HSFA_FLUX") ? atoi(getenv("HSFA_FLUX")) : 1;
+		m_lecteur.gain = 0.26f * float(getenv("HSFA_FLUX_VOL") ? atof(getenv("HSFA_FLUX_VOL")) : 100.0) / 100.f;
+		osd_printf_info("HSFA flux : %u flux ADX, %u codes (%s), mode %d\n", unsigned(m_lecteur.nb_flux()),
