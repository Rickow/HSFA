+		m_stream = stream_alloc(0, 2, 48000);
+		hsfa_flux::etat_t &e = m_lecteur.e;
+		save_item(NAME(e.actif)); save_item(NAME(e.fid)); save_item(NAME(e.pause)); save_item(NAME(e.vol));
+		save_item(NAME(e.niveau)); save_item(NAME(e.f_debut)); save_item(NAME(e.f_cible)); save_item(NAME(e.f_duree));
+		save_item(NAME(e.f_reste)); save_item(NAME(e.trame)); save_pointer(&e.hist[0][0], "e.hist", 4);
+		save_item(NAME(e.boucle_ok)); save_pointer(&e.hist_boucle[0][0], "e.hist_boucle", 4);
+		save_pointer(&e.hist_debut[0][0], "e.hist_debut", 4); save_item(NAME(e.ech));
+		save_item(NAME(e.n_ech)); save_item(NAME(e.pos_abs)); save_item(NAME(e.cpt_tick)); save_item(NAME(e.frac));
+		save_item(NAME(e.prec)); save_item(NAME(e.cour)); save_item(NAME(e.g_prec));
+		const char *y = getenv("HSFA_YDATA");
+		if (!y || !*y) return;
