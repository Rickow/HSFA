+//   HSFA_FLUX_TABLE=<table> (defaut : hsfa_flux_table.txt a cote de HSFA_YDATA)
+//   HSFA_FLUX=1 (defaut, codes sans equivalent QSound) | 2 (toutes les musiques en flux, sauf l'intro) | 0 (inactif)
+//   HSFA_FLUX_VOL=<%> (defaut 100 = niveau de la musique QSound), HSFA_FLUX_LOG=<journal des commandes>
+class hsfa_flux_device : public device_t, public device_sound_interface
