+			stream.put(0, i, sound_stream::sample_t(m_tmp[2 * i]) * (1.0 / 32768.0));
+			stream.put(1, i, sound_stream::sample_t(m_tmp[2 * i + 1]) * (1.0 / 32768.0));
+		}
+	}
+
+private:
+	hsfa_flux::lecteur m_lecteur;
+	sound_stream *m_stream = nullptr;
+	std::vector<int16_t> m_tmp;
+};
+
