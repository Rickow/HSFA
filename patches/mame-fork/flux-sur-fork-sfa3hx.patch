+		, device_sound_interface(mconfig, *this)
+	{ }
+
+	// commande posee par le 68K dans la boite aux lettres ; true = la remplacer par FF05 pour le Z80
+	bool commande(uint16_t cmd, uint8_t v, uint16_t p)
+	{
+		if (!m_lecteur.mode) return false;
+		m_stream->update();
+		return m_lecteur.commande(cmd, v, p) == hsfa_flux::REMPLACE_FF05;
+	}
+
+protected:
+	virtual void device_start() override ATTR_COLD
