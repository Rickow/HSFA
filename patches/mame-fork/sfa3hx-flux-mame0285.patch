+
+/*************************************
+ *
+ *  HSFA : lecteur de flux musique ADX
+ *
+ *************************************/
+
+// Joue les musiques que le Z80/QSound ne connait pas (Upper : Guile, Fei-Long, Dee Jay, T.Hawk ; Hyper : ZERO, ZERO 2,
+// ALPHA, variantes), ou toutes les musiques en mode « musique PS2 », a partir du Y_DATA.BIN de l'utilisateur (flux ADX,
+// AFS) et d'une table code -> flux separee (gen_table_flux.py). Variables :
+//   HSFA_YDATA=<Y_DATA.BIN | ISO de l'Anthology | fichier@decalage hexa>  (sans elle, le lecteur est inactif)
+//   HSFA_FLUX_TABLE=<table> (defaut : hsfa_flux_table.txt a cote de HSFA_YDATA)
+//   HSFA_FLUX=1 (defaut, codes sans equivalent QSound) | 2 (toutes les musiques en flux, sauf l'intro) | 0 (inactif)
+//   HSFA_FLUX_VOL=<%> (defaut 100 = niveau de la musique QSound), HSFA_FLUX_LOG=<journal des commandes>
+class hsfa_flux_device : public device_t, public device_sound_interface
+{
+public:
+	hsfa_flux_device(const machine_config &mconfig, const char *tag, device_t *owner, uint32_t clock = 0)
+		: device_t(mconfig, HSFA_FLUX, tag, owner, clock)
+		, device_sound_interface(mconfig, *this)
+	{ }
+
+	// commande posee par le 68K dans la boite aux lettres ; true = la remplacer par FF05 pour le Z80
+	bool commande(uint16_t cmd, uint8_t v, uint16_t p)
+	{
+		if (!m_lecteur.mode) return false;
+		m_stream->update();
+		return m_lecteur.commande(cmd, v, p) == hsfa_flux::REMPLACE_FF05;
+	}
+
+protected:
+	virtual void device_start() override ATTR_COLD
+	{
+		m_stream = stream_alloc(0, 2, 48000);
+		hsfa_flux::etat_t &e = m_lecteur.e;
+		save_item(NAME(e.actif)); save_item(NAME(e.fid)); save_item(NAME(e.pause)); save_item(NAME(e.vol));
+		save_item(NAME(e.niveau)); save_item(NAME(e.f_debut)); save_item(NAME(e.f_cible)); save_item(NAME(e.f_duree));
+		save_item(NAME(e.f_reste)); save_item(NAME(e.trame)); save_pointer(&e.hist[0][0], "e.hist", 4);
+		save_item(NAME(e.boucle_ok)); save_pointer(&e.hist_boucle[0][0], "e.hist_boucle", 4);
+		save_pointer(&e.hist_debut[0][0], "e.hist_debut", 4); save_item(NAME(e.ech));
+		save_item(NAME(e.n_ech)); save_item(NAME(e.pos_abs)); save_item(NAME(e.cpt_tick)); save_item(NAME(e.frac));
+		save_item(NAME(e.prec)); save_item(NAME(e.cour)); save_item(NAME(e.g_prec));
+		const char *y = getenv("HSFA_YDATA");
+		if (!y || !*y) return;
+		std::string table;
+		if (const char *t = getenv("HSFA_FLUX_TABLE")) table = t;
+		else
+		{
+			std::string d(y);
+			size_t at = d.rfind('@'); if (at != std::string::npos && d.find('/', at) == std::string::npos) d.resize(at);
+			size_t sl = d.find_last_of('/');
+			table = (sl == std::string::npos ? std::string() : d.substr(0, sl + 1)) + "hsfa_flux_table.txt";
+		}
+		m_lecteur.ouvre_journal(getenv("HSFA_FLUX_LOG"));
+		if (!m_lecteur.ouvre(y, table.c_str()))
+		{
+			osd_printf_warning("HSFA flux : %s (lecteur inactif)\n", m_lecteur.erreur);
+			return;
+		}
+		m_lecteur.mode = getenv("HSFA_FLUX") ? atoi(getenv("HSFA_FLUX")) : 1;
+		m_lecteur.gain = 0.26f * float(getenv("HSFA_FLUX_VOL") ? atof(getenv("HSFA_FLUX_VOL")) : 100.0) / 100.f;
+		osd_printf_info("HSFA flux : %u flux ADX, %u codes (%s), mode %d\n", unsigned(m_lecteur.nb_flux()),
+				unsigned(m_lecteur.nb_codes()), table, m_lecteur.mode);
+	}
+	virtual void device_reset() override ATTR_COLD { m_lecteur.e.actif = 0; }
+	virtual void device_post_load() override ATTR_COLD { m_lecteur.apres_chargement(); }
+
+	virtual void sound_stream_update(sound_stream &stream) override
+	{
+		int const n = stream.samples();
+		m_tmp.assign(2 * size_t(n), 0);
+		if (m_lecteur.mode) m_lecteur.rend(m_tmp.data(), n);
+		for (int i = 0; i < n; i++)
+		{
+			stream.put(0, i, sound_stream::sample_t(m_tmp[2 * i]) * (1.0 / 32768.0));
+			stream.put(1, i, sound_stream::sample_t(m_tmp[2 * i + 1]) * (1.0 / 32768.0));
+		}
+	}
+
+private:
+	hsfa_flux::lecteur m_lecteur;
+	sound_stream *m_stream = nullptr;
+	std::vector<int16_t> m_tmp;
+};
+
