+// HSFA : apres le decodage normal, ROM graphique etendue (HSFA_GFX : tuiles 16x16 au format interne de MAME,
+// 128 octets, chargees a partir de $2000000 = code $40000) et blocs de donnees (HSFA_EXT/ext_<adresse>.bin, mots
+// gros-boutistes). Horloge : HSFA_CLOCK (defaut 0.7375 comme MAME ; > 1 = surcadencage).
+void cps2_state::init_hsfa()
+{
+	init_cps2();
+	m_hsfa = true;
+	save_item(NAME(m_hsfa_plane_base));
+	if (const char *g = getenv("HSFA_GFX"))   // 'fichier[@decalage hexa],...' (defaut $2000000)
+	{
+		std::string all(g);
+		size_t p0 = 0;
+		while (p0 <= all.size())
+		{
+			size_t p1 = all.find(',', p0);
+			std::string item = all.substr(p0, p1 == std::string::npos ? std::string::npos : p1 - p0);
+			p0 = (p1 == std::string::npos) ? all.size() + 1 : p1 + 1;
+			if (item.empty()) continue;
+			uint32_t off = 0x2000000;
+			size_t at = item.rfind('@');
+			if (at != std::string::npos) { off = strtoul(item.c_str() + at + 1, nullptr, 16); item.resize(at); }
+			FILE *f = fopen(item.c_str(), "rb");
+			if (!f || off >= memregion("gfx")->bytes()) { if (f) fclose(f); continue; }
+			size_t n = fread(memregion("gfx")->base() + off, 1, memregion("gfx")->bytes() - off, f);
+			fclose(f);
+			osd_printf_info("HSFA : %u octets de tuiles en $%x (%s)\n", unsigned(n), off, item);
+		}
+	}
+	if (const char *d = getenv("HSFA_EXT"))
+	{
+		uint16_t *ext = (uint16_t *)memregion("hsfaext")->base();
+		static const uint32_t bases[] = { 0xa04000, 0xb00000, 0xb04000, 0xb40000, 0xb80000, 0xbc0000, 0xc80000 };
+		for (uint32_t b : bases)
+		{
+			std::string p = util::string_format("%s/ext_%06x.bin", d, b);
+			FILE *f = fopen(p.c_str(), "rb");
+			if (!f) continue;
+			uint8_t w[2]; uint32_t a = b - 0xa00000;
+			while (a < 0x300000 && fread(w, 1, 2, f) == 2) { ext[a / 2] = (w[0] << 8) | w[1]; a += 2; }
+			fclose(f);
+			osd_printf_info("HSFA : %s\n", p);
+		}
+	}
+	if (const char *c = getenv("HSFA_CLOCK"))
+		m_maincpu->set_clock_scale(atof(c));
+	// Son : region qsound de 16 Mo. Sans HSFA_SON, les 8 Mo hauts recopient les 8 Mo bas (= miroir de la region de
+	// 8 Mo d'origine : comportement inchange). HSFA_SON=<dossier> : ROM son hybride d'Upper (gen_hybride.py, option C) :
+	// hx3.01 (0x20000 : 0x0000-0x7FFF + 0x10000-0x27FFF) et hx3.02 (0x28000 : 0x28000-0x4FFFF, banque 15 comprise)
+	// -> audiocpu ; hx3.11m..hx3.14m (4 Mo chacun, mots echanges comme ROM_LOAD16_WORD_SWAP) -> qsound 0-16 Mo.
+	uint8_t *qs = memregion("qsound")->base();
+	if (const char *d = getenv("HSFA_SON"))
+	{
+		uint8_t *z = memregion("audiocpu")->base();
+		auto lit = [d](const char *nom, uint8_t *dst, size_t n, bool swap)
+		{
+			std::string p = util::string_format("%s/%s", d, nom);
+			FILE *f = fopen(p.c_str(), "rb");
+			if (!f) throw emu_fatalerror("HSFA_SON : %s introuvable\n", p);
+			std::vector<uint8_t> b(n + 1);
+			size_t r = fread(b.data(), 1, n + 1, f);
+			fclose(f);
+			if (r != n) throw emu_fatalerror("HSFA_SON : %s : %u octets au lieu de %u\n", p, unsigned(r), unsigned(n));
+			for (size_t k = 0; k < n; k++) dst[k] = b[swap ? (k ^ 1) : k];
+		};
+		std::vector<uint8_t> z1(0x20000);
+		lit("hx3.01", z1.data(), 0x20000, false);
+		memcpy(z, z1.data(), 0x8000);
+		memcpy(z + 0x10000, z1.data() + 0x8000, 0x18000);
+		lit("hx3.02", z + 0x28000, 0x28000, false);
+		static const char *const q[] = { "hx3.11m", "hx3.12m", "hx3.13m", "hx3.14m" };
+		for (int k = 0; k < 4; k++)
+			lit(q[k], qs + k * 0x400000, 0x400000, true);
+		osd_printf_info("HSFA : son hybride (%s)\n", d);
+	}
+	else
+		memcpy(qs + 0x800000, qs, 0x800000);
+}
