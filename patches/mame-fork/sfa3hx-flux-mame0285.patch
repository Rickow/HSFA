+// HSFA : carte de dead_cps2 + donnees externes du portage ($A00000-$CFFFFF : fichiers a adresse fixe, bloc de fin
+// des donnees d'Upper en $C80000), en ROM, remplies au demarrage depuis HSFA_EXT (dossier des ext_<adresse>.bin)
+void cps2_state::hsfa_map(address_map &map)
+{
+	dead_cps2_map(map);
+	map(0x618000, 0x619fff).rw(FUNC(cps2_state::qsound_sharedram1_r), FUNC(cps2_state::hsfa_qsound_w));   // + flux
+	map(0xa00000, 0xcfffff).rom().region("hsfaext", 0);
+	// bases des plans scroll1/2/3 (unites de 64 Ko de la ROM graphique ; 0 = mappage d'origine)
+	map(0x804200, 0x804205).lrw16(
+			NAME([this](offs_t offset) { return m_hsfa_plane_base[offset]; }),
+			NAME([this](offs_t offset, uint16_t data, uint16_t mem_mask) {
+				uint16_t old = m_hsfa_plane_base[offset];
+				COMBINE_DATA(&m_hsfa_plane_base[offset]);
+				if (old != m_hsfa_plane_base[offset]) m_bg_tilemap[offset]->mark_all_dirty();
+			}));
+}
