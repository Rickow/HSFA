+void cps2_state::hsfa(machine_config &config)
+{
+	dead_cps2(config);
+	m_maincpu->set_addrmap(AS_PROGRAM, &cps2_state::hsfa_map);
+	HSFA_FLUX(config, m_flux);
+	m_flux->add_route(0, "speaker", 1.0, 0);
+	m_flux->add_route(1, "speaker", 1.0, 1);
+}
+
+// HSFA : boite aux lettres QSound ; a la pose d'une commande ($61801F = 0), le lecteur de flux decide (comme le
+// pilote PS2 natif) : musique jouee en flux -> la commande transmise au Z80 devient FF05 (arret de la musique QSound)
+void cps2_state::hsfa_qsound_w(offs_t offset, uint16_t data, uint16_t mem_mask)
+{
+	qsound_sharedram1_w(offset, data, mem_mask);
+	if (offset == 0x0f && ACCESSING_BITS_0_7 && !(data & 0xff) && m_flux.found())
+	{
+		uint8_t *r = m_qsound_sharedram1.target();
+		if (m_flux->commande((r[0] << 8) | r[1], r[2], (r[3] << 8) | r[4]))
+		{
+			r[0] = 0xff;
+			r[1] = 0x05;
+		}
+	}
+}
