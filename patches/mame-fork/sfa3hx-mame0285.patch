+// HSFA : code brut de la tilemap = indice LOCAL dans la memoire de decor rangee telle quelle a partir de la base du
+// plan (plus de renumerotation). Taille d'un element : 64 o (8x8, deux moities), 128 o (16x16), 512 o (32x32).
+int cps_state::hsfa_plane_code(int plane, int code)
+{
+	static const int elem[3] = { 64, 128, 512 };
+	return int((uint32_t(m_hsfa_plane_base[plane]) << 16) / elem[plane]) + code;
+}
