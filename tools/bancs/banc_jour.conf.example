# banc_jour.conf — versions FIGÉES passées au banc de jour (banc_jour.sh). Mettre à jour à chaque version figée / lot validé.
VERSION=v159_banc                 # SFA3 / Upper / Hyper : work/references/<VERSION>/{ro3,ro5,ro9}
GREFFE=auto                  # (étape greffe_fins, remplacée par banc_ref_greffe) auto = greffe_arcade/constructions/ro9a<N>_fige le plus récent (avec MD5SUMS) ; sinon ro9a21…
GREFFE_TABLE=<workspace>/work/greffe_arcade/e41/tab_f61.txt   # durées du banc 61 (ro9a31, v159, sans touche pendant la carte)
MAX_VALIDE=max54             # dernier lot Upper MAX VALIDÉ (copie figée work/banc_coups/<nom>) : 2b27 = max45
PLACES_BANC=5                # parties en parallèle au plus (en plus, lance_emu limite toute la machine)
BUDGET_H=8                   # aucune partie ne démarre si elle finirait après ce délai
# greffe_fins et max_* (banc_jour.py) sont remplacées par le BANC UNIQUE (banc_ref.sh) : copie figée témoin rejouée contre
# son cache (même harnais, contexte md5) ; une référence dont le contexte a changé est rejouée et signalée.
ETAPES="sfa3_cmd sfa3_fins upper_fins hyper_vs banc_ref_greffe banc_ref_max"
REF_GREFFE=ro9a45_fige         # copie figée témoin de la greffe (greffe_arcade/constructions/<nom>)
REF_GREFFE_JUMELLE=            # jumelle TIRAGE_CPU=0 de REF_GREFFE (partie decors ; vide = décors refusés)
BANC_REF_PARTIES_GREFFE=versus,training,arcade,continue,gameover,j2,fins,decors
REF_MAX=max59                  # copie figée témoin d'Upper MAX (banc_coups/<nom>)
BANC_REF_PARTIES_MAX=arcade,croises,fins
