+// --------------------------------------------------------------------------------------------------------------
+// (agent_options, OPTIONS.md) Reglages de l'ecran OPTION de l'Anthology, par des DIP (« Options du coeur » de
+// RetroArch). L'ecran d'options du portage est du C natif PS2, sans traduction ; a sa sortie, il recopiait ses
+// reglages dans la RAM du jeu, a la place des octets de configuration de l'EEPROM arcade (memes champs : $A0-$A5,
+// $DE-$DF de A5 = $FF8000, octets a l'adresse XOR 1 dans la traduction). Ici, les octets choisis sont ecrits a chaque
+// fin d'image passee au menu des modes ($FF8000 = 4) : au demarrage et a chaque retour au menu, avant toute partie,
+// comme le faisait le portage au debut de chaque mode. Valeur « Defaut du jeu » (0) = rien n'est ecrit pour ce
+// reglage : avec tous les DIP par defaut, le jeu est inchange. HSFA_OPTIONS=0 (variable d'environnement) : aucune
+// ecriture, quels que soient les DIP (ancien comportement).
+UINT8 HsfaOptDip[7] = { 0, 0, 0, 0, 0, 0, 0 };		// DIP B..H (d_cps2.cpp)
+static INT32 nHsfaOptOff = -1;
+static UINT8 nOptExtra = 0;							// pages d'options secretes ecrites non nulles (a remettre a 0)
+
+static inline void RamWB(UINT32 a, UINT8 v) { CpsRamFF[(a & 0xFFFF) ^ 1] = v; }
+
+static void HsfaOptions()
+{
+	if (nHsfaOptOff < 0) nHsfaOptOff = (getenv("HSFA_OPTIONS") && atoi(getenv("HSFA_OPTIONS")) == 0) ? 1 : 0;
+	// seulement au menu des modes : l'initialisation d'un mode (apres le menu) garde ses regles propres (TRAINING force
+	// le chrono infini, SURVIVAL coupe le JOIN IN, Hyper recopie MAX ROUND (1P) dans le champ VS) ; ecrire aussi a la
+	// selection des persos les ecraserait (essai : chrono du TRAINING d'Hyper repasse a 2 etoiles).
+	if (nHsfaOptOff || RamW(0xFF8000) != 4) return;
+	const UINT8 *d = HsfaOptDip;
+	UINT8 v;
+	if ((v = d[0] & 0x0F)) RamWB(0xFF80A1, v - 1);		// DIFFICULTY 0-7 (arcade $A0)
+	if ((v = (d[0] >> 4) & 7)) RamWB(0xFF80A0, v - 1);	// DAMAGE LEVEL 0-3 (arcade $A1)
+	if ((v = d[1] & 7)) RamWB(0xFF80A3, v - 1);			// TIMER SPEED 0-3, 4 = INFINITY (arcade $A2)
+	if ((v = (d[1] >> 3) & 7)) RamWB(0xFF80A2, v - 1);	// SPEED SELECT 0-4 (arcade $A3)
+	if ((v = d[2] & 3)) RamWB(0xFF80DF, v - 1);			// MAX ROUND (1P) 0-2 = 1/3/5 (arcade $DE)
+	if ((v = (d[2] >> 2) & 3)) RamWB(0xFF80DE, v - 1);	// MAX ROUND (VS) (arcade $DF ; Hyper : recopie de $DF)
+	const UINT32 vs = (HsfaMode == 1) ? 0xFF4110 : 0xFF4310;	// VS MODE : 1P en +1, 2P en +0 (0 HUMAN, 1 COM)
+	if ((v = (d[2] >> 4) & 3)) RamWB(vs + 1, v - 1);
+	if ((v = (d[2] >> 6) & 3)) RamWB(vs, v - 1);
+	if ((v = d[3] & 3)) RamWB(0xFF80A5, v - 1);			// JOIN IN (SFA3, Upper ; arcade $A4)
+	// options secretes (EXTRA OPTION 1-3) : un octet de drapeaux par page, bit = 2e valeur de l'ecran PS2
+	static const UINT32 X[3][3] = { { 0xFF41A4, 0xFF41A7, 0xFF41A6 },		// SFA3
+	                                { 0xFF43A6, 0xFF43A9, 0xFF43A8 },		// Upper
+	                                { 0xFF43BB, 0xFF43BA, 0xFF43BD } };		// Hyper
+	const UINT32 *x = X[(HsfaMode == 1) ? 0 : HsfaHyper ? 2 : 1];
+	for (INT32 p = 0; p < 3; p++) {
+		if (d[4 + p] == 0 && !(nOptExtra & (1 << p))) continue;
+		RamWB(x[p], d[4 + p]);
+		if (d[4 + p]) nOptExtra |= 1 << p; else nOptExtra &= ~(1 << p);
+	}
+}
+
