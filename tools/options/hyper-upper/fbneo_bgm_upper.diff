 static inline void RamWB(UINT32 a, UINT8 v) { CpsRamFF[(a & 0xFFFF) ^ 1] = v; }
 
+// (agent_options_hyper, OPTIONS-HYPER-UPPER.md) Upper : reglage BGM de l'ecran RANDOM PLAYER d'Hyper, transpose
+// (Dip E bits 2-3). La greffe BGM_UPPER du traducteur range dans la ROM d'Upper un talon et son descripteur
+// ('HSFABGM1' + adresse du site, en $3FEEF0) ; le site (CMPI.B #7,$C201(A5) du choix de la musique du combat) reste
+// intact. Reglage choisi : JMP talon.L pose sur le site (en VERSUS, TRAINING et VERSUS cache seulement) et $FF43B5 =
+// 1 hasard J1/J2, 2 J1, 3 J2 (theme du perso au lieu de la musique du decor). Â« Game default Â» : CMPI d'origine remis, rien d'ecrit
+// ($FF43B5 n'est lu que par le talon) -> jeu inchange, au cycle pres. A chaque image (pas seulement au menu des modes) :
+// un etat recharge en cours de VERSUS retrouve le meme code. ROM sans descripteur (SFA3, Hyper, ancienne ROM) : rien.
+static void HsfaOptBgm()
+{
+	if (HsfaMode != 2 || HsfaHyper || nCpsRomLen < 0x400000) return;
+	const UINT32 D = 0x3FEEF0, TB = 0x3FEF00;
+	static const UINT16 MAGIC[4] = { 0x4853, 0x4641, 0x4247, 0x4D31 };		// 'HSFABGM1'
+	for (INT32 i = 0; i < 4; i++) if (RdW(CpsRom + D + 2 * i) != MAGIC[i]) return;
+	const UINT32 s = (RdW(CpsRom + D + 8) << 16) | RdW(CpsRom + D + 10);
+	if (s < 0x400 || s > 0x3FFFF0 || (s & 1)) return;
+	static const UINT16 CMPI[3] = { 0x0C2D, 0x0007, 0xC201 };				// CMPI.B #7,$C201(A5)
+	const UINT16 JMP[3] = { 0x4EF9, (UINT16)(TB >> 16), (UINT16)(TB & 0xFFFF) };	// JMP talon.L
+	const UINT8 v = (HsfaOptDip[3] >> 2) & 3;
+	// JMP pose seulement dans les modes ou Upper joue la musique du decor (curseur des modes $FF4201 : 1 VERSUS,
+	// 4 TRAINING, 7 VERSUS cache) : ARCADE, SURVIVAL et DRAMATIC restent inchanges au cycle pres, reglage choisi ou non
+	const UINT8 m = CpsRamFF[0x4201 ^ 1];
+	const bool pose = v && (m == 1 || m == 4 || m == 7);
+	const UINT16 *de = pose ? CMPI : JMP, *vers = pose ? JMP : CMPI;
+	bool a_poser = true;
+	for (INT32 i = 0; i < 3; i++) if (RdW(CpsRom + s + 2 * i) != de[i]) a_poser = false;
+	if (a_poser) {
+		for (INT32 i = 0; i < 3; i++) {
+			WrW(CpsRom + s + 2 * i, vers[i]);
+			if (CpsCode && s + 2 * i + 1 < nCpsCodeLen) WrW(CpsCode + s + 2 * i, vers[i]);
+		}
+	}
+	if (pose) RamWB(0xFF43B5, v);
+}
