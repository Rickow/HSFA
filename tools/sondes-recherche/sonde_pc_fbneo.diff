-void __fastcall M68KWriteLong(UINT32 a, UINT32 d) { WriteLong(a, d); }
+void __fastcall M68KWriteByte(UINT32 a, UINT32 d) { sonde('W', 1, a, d); WriteByte(a, d); }
+void __fastcall M68KWriteWord(UINT32 a, UINT32 d) { sonde('W', 2, a, d); WriteWord(a, d); }
+void __fastcall M68KWriteLong(UINT32 a, UINT32 d) { sonde('W', 4, a, d); WriteLong(a, d); }
